#!/usr/bin/env python3
"""Codex App native fleet: task cards, isolated worktrees, receipts and handoffs.
The host owns thread creation, supervision and messaging. No background scheduler.
"""
import argparse
import contextlib
import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile
import time
import uuid

ROOT = Path(__file__).resolve().parent
ACCEPT_ROLES = ('verify', 'integ', 'regression')
MAX_REPLIES = int(os.environ.get('CC_FLEET_MAX_REPLIES', '3'))
NATIVE_SETTINGS_ACTION = ('Resolve model and thinking from the current parent session, preserving the full '
    'provider-qualified model ID. Apply explicit conversation overrides field by field. '
    'Pass both as native tool arguments; nativeSettings={} is unresolved, not App defaults. ')


def run(argv, cwd=None, check=True):
    p = subprocess.run([str(x) for x in argv], cwd=cwd, text=True, capture_output=True, timeout=45)
    if check and p.returncode:
        raise ValueError(f'{Path(str(argv[0])).name} {argv[1] if len(argv)>1 else ""} failed (exit {p.returncode})')
    return p


def git(cwd, *args):
    return run(['git', '-C', cwd, *args]).stdout.strip()


def emit(obj):
    print(json.dumps(obj, ensure_ascii=False, indent=2), flush=True)


def atomic_text(path, text):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def atomic(path, obj):
    atomic_text(path, json.dumps(obj, ensure_ascii=False, indent=2) + '\n')


def name(value):
    if not isinstance(value, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,95}', value):
        raise ValueError('RQ/module must use letters, digits, dot, underscore or hyphen (max 96)')
    return value


def meta(c):
    return json.loads((c/'fleet.json').read_text())


def coord(value):
    c = Path(value).expanduser().resolve()
    f = meta(c)
    if f.get('version') != 2:
        raise ValueError('not a v2 coordination directory')
    if f.get('owner', {}).get('host') != 'codex-app':
        raise ValueError('this skill supports Codex App native sessions only')
    return c


def record(c, m):
    return c/'v2'/f'{name(m)}.json'


def load(c, m):
    d = json.loads(record(c, m).read_text())
    if d.get('backend') != 'codex' or d.get('transport') not in ('native', 'self'):
        raise ValueError('legacy backend/transport removed; use the pre-update backup for old RQs')
    return d


@contextlib.contextmanager
def lock(c, m):
    p = c/'v2'
    p.mkdir(exist_ok=True)
    with (p/f'.{name(m)}.lock').open('a') as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def native_settings():
    if json.loads((ROOT.parent/'native-codex.json').read_text()) != {'inherit': 'parent'}:
        raise ValueError('native-codex.json requires inherit=parent')
    return {}


def clean_subdir(value):
    value = (value or '').strip()
    if value in ('', '.'):
        return ''
    if Path(value).is_absolute() or '..' in Path(value).parts:
        raise ValueError('subdir must be relative inside the repository')
    return Path(value).as_posix().rstrip('/')


def toplevel(p):
    return Path(git(Path(p).resolve(), 'rev-parse', '--show-toplevel')).resolve()


def inbox(c, d):
    root = Path(meta(c).get('inboxRoot', str(Path(tempfile.gettempdir())/'fleet-v2-inbox'/meta(c)['rq'])))
    return root/f"{d['module']}-{d['attempt']}.receipt.json"


def handoff_path(c, d, fallback=False):
    parent = inbox(c, d).parent if fallback else c
    return parent/f"{d['module']}-{d['attempt']}.handoff.md"


def archive_dir(c, d):
    return c/'history'/d['module']/d['attempt']


def init(a):
    repo = toplevel(a.cwd)
    common = Path(git(repo, 'rev-parse', '--path-format=absolute', '--git-common-dir')).resolve()
    base = a.base or git(repo, 'symbolic-ref', '--short', 'HEAD')
    sha = git(repo, 'rev-parse', '--verify', base+'^{commit}')
    subdir = clean_subdir(Path(a.cwd).resolve().relative_to(repo).as_posix())
    rq = name(a.rq or 'RQ-'+datetime.datetime.now().strftime('%Y%m%d-%H%M%S')+'-'+uuid.uuid4().hex[:8])
    c = common/'fleet'/rq
    c.mkdir(parents=True, exist_ok=False)
    try:
        git(repo, 'branch', 'fleet/'+rq, sha)
    except Exception:
        c.rmdir()
        raise
    owner = a.owner_id or os.environ.get('CODEX_THREAD_ID')
    d = dict(version=2, rq=rq, repo=str(repo), commonDir=str(common), subdir=subdir,
        base=base, baseCommit=sha, integrationBranch='fleet/'+rq, codexTransport='native-only',
        inboxRoot=str((Path(tempfile.gettempdir())/'fleet-v2-inbox'/rq).resolve()),
        owner=dict(host='codex-app', id=owner or 'controller-'+uuid.uuid4().hex,
                   identitySource='session' if owner else 'generated-controller'), createdAt=time.time())
    atomic(c/'fleet.json', d)
    atomic_text(c/'base.ref', base+'\n')
    emit(dict(d, coord=str(c), uncommittedChangesExcluded=bool(git(repo, 'status', '--porcelain'))))


def preamble(c, d):
    f = meta(c)
    fleet_bin = shlex.quote(str(ROOT/'cc-fleet'))
    cq, mq = shlex.quote(str(c)), shlex.quote(d['module'])
    bound = ('复用已绑定隔离工作树 '+d['worktree']+'；保留已有提交和未提交资产，不在其它工作树重做。'
             if d.get('worktree') else
             f"写入前用 App 原生 list_artifacts 核对隔离工作树；需要时 create_worktree(ref={f['integrationBranch']}, "
             f"sourceRoot={f['repo']}, allowAsync=true)，有 operationId 就等待创建完成。不得在主 checkout 开发。")
    return f'''⟦FLEET-WORKER⟧ rq={f['rq']} module={d['module']} role={d['role']} backend=codex
你是独立 worker，不再编排子 session。只做本任务卡授权范围。
先读稳定协议 {ROOT.parent/'reference'/'worker.md'}；开工/压缩恢复按协议重读原始需求、用例、契约和适用项目规则。
协调目录：{c}；attempt：{d['attempt']}；集成分支：{f['integrationBranch']}；阶段：{d.get('phase') or 'implement'}。
{bound}
工作子目录：{d.get('subdir') or '.'}；显式读取工作树根到该目录适用的 AGENTS.md 及其指向的规则。
在实际 worktree 运行：{fleet_bin} bind --coord {cq} --module {mq} --attempt {d['attempt']} --worktree "$PWD"
协调目录不可写时，回执写真实 worktree，使用下列临时路径；不要为写回执扩大权限。
先覆写交接文件 {handoff_path(c,d)}；不可写则用 {handoff_path(c,d,True)}。
原子写回执 {c/(d['module']+'.receipt.json')}；不可写则用 {inbox(c,d)}。
用 {fleet_bin} validate-receipt --coord {cq} --module {mq} --receipt-file '<实际回执路径>' 一次检查全部问题，修正后再报告。
最后只回复同一 JSON；回执模板：
{{"version":2,"rq":"{f['rq']}","module":"{d['module']}","attempt":"{d['attempt']}","worktree":"隔离工作树绝对路径","result":"done|failed|blocked","summary":"本轮实际结果","commit":"完整提交或验收SHA","tests":[{{"command":"实际检查","result":"passed|failed|blocked|not-run","evidence":"证据路径或简短输出"}}],"risks":[],"needsInput":[]}}

任务卡：
'''


def prepare(a):
    c = coord(a.coord)
    f, m = meta(c), name(a.module)
    native_settings()  # validate before mutating the roster
    if a.after:
        raise ValueError('native dependencies belong in CURRENT; the host advances them after verified receipts')
    if a.phase and a.role not in ('verify', 'integ'):
        raise ValueError('--phase only applies to verify/integ')
    if a.self_dev and a.role != 'developer':
        raise ValueError('--self requires developer role')
    subdir = clean_subdir(f.get('subdir', '') if a.subdir is None else a.subdir)
    if subdir and run(['git', '-C', f['repo'], 'cat-file', '-e', f"{f['integrationBranch']}:{subdir}"], check=False).returncode:
        raise ValueError('subdir not found on integration branch')
    task = Path(a.task).resolve().read_text() if a.task else ''
    if not task.strip():
        raise ValueError('empty task card')
    with lock(c, m):
        if record(c, m).exists():
            raise ValueError('module already registered; use reply')
        d = dict(version=2, module=m, backend='codex', transport='self' if a.self_dev else 'native',
            role=a.role, permissions='inherit', attempt=uuid.uuid4().hex,
            state='self' if a.self_dev else 'prepared', name=f"↳{m}@{f['rq']}", createdAt=time.time(),
            phase=a.phase, replies=0, sessionId=None, shortId=None, hostId=None, worktree=None,
            branch=None, subdir=subdir, cwd=None, baselineCommit=git(f['repo'], 'rev-parse', f['integrationBranch']))
        atomic(record(c, m), d)
        atomic_text(c/f'{m}.task.md', task)
        atomic_text(c/f'{m}.prompt.md', preamble(c, d)+task)
    emit(dict(d, coord=str(c), integrationBranch=f['integrationBranch'], promptFile=str(c/f'{m}.prompt.md'),
        nativeSettings=native_settings(), nativeSettingsPolicy='inherit-parent',
        nextAction=NATIVE_SETTINGS_ACTION+('Use an App native isolated worktree, bind it, then develop here.' if a.self_dev else
            'Call create_thread with the complete promptFile; immediately move each real thread to the resolved 子 session section, verify, then register.')))


def check_attempt(a, d):
    if getattr(a, 'attempt', None) and a.attempt != d['attempt']:
        raise ValueError('stale attempt')
    if d.get('previousSessions') and not getattr(a, 'attempt', None):
        raise ValueError('--attempt required after fresh session handoff')


def verify_worktree(c, d, value):
    f, wt = meta(c), toplevel(value)
    if wt == Path(f['repo']).resolve():
        raise ValueError('worker must not use primary checkout')
    if Path(git(wt, 'rev-parse', '--path-format=absolute', '--git-common-dir')).resolve() != Path(f['commonDir']).resolve():
        raise ValueError('wrong repository')
    if d.get('worktree') and Path(d['worktree']).resolve() != wt:
        raise ValueError('worktree already bound elsewhere')
    if run(['git', '-C', wt, 'merge-base', '--is-ancestor', d['baselineCommit'], 'HEAD'], check=False).returncode:
        raise ValueError('worktree lacks prepared integration baseline')
    return wt


def bind(a):
    c = coord(a.coord)
    def bound_record():
        d = load(c, a.module)
        check_attempt(a, d)
        wt = verify_worktree(c, d, a.worktree)
        d.update(worktree=str(wt), branch=git(wt, 'rev-parse', '--abbrev-ref', 'HEAD'),
                 cwd=str(wt/d['subdir']) if d.get('subdir') else str(wt))
        return d
    try:
        with lock(c, a.module):
            d = bound_record()
            atomic(record(c, a.module), d)
    except PermissionError:
        # A read-only coordination mount must not block isolated development.
        # Still validate repository, worktree and attempt; defer only persistence.
        d = bound_record()
        path = inbox(c, d).with_suffix('.binding.json')
        atomic(path, dict(rq=meta(c)['rq'], module=d['module'], attempt=d['attempt'],
                          worktree=d['worktree'], branch=d['branch'], baselineCommit=d['baselineCommit']))
        d.update(bindingPending=True, bindingFile=str(path),
                 nextAction='Continue only in this verified worktree; put its real path in the receipt so collect can bind it durably')
    emit(d)


def register(a):
    c = coord(a.coord)
    with lock(c, a.module):
        d = load(c, a.module)
        check_attempt(a, d)
        if d['transport'] != 'native':
            raise ValueError('register requires a native worker')
        if a.client_thread_id:
            if d.get('sessionId') or a.sidebar_section_id:
                raise ValueError('pending clientThreadId cannot replace real identity or prove sidebar placement')
            if d.get('clientThreadId') and d['clientThreadId'] != a.client_thread_id:
                raise ValueError('a different setup is already pending; reconcile instead of creating again')
            d.update(clientThreadId=a.client_thread_id, state='setting-up')
            if a.host_id:
                d['hostId'] = a.host_id
        else:
            if d.get('sessionId') and d['sessionId'] != a.session_id:
                raise ValueError('task already has a different threadId')
            host = a.host_id or d.get('hostId') or 'local'
            if d.get('hostId') and d['hostId'] != host:
                raise ValueError('task already belongs to a different host')
            if any(x.get('sessionId') == a.session_id and x.get('hostId', 'local') == host for x in d.get('previousSessions', [])):
                raise ValueError('cannot register the retired thread as the fresh session')
            d.update(sessionId=a.session_id, hostId=host, clientThreadId=None, state='running')
            if a.sidebar_section_id:
                d['sidebar'] = dict(state='placed', sectionId=a.sidebar_section_id, source='codex-app-native')
            else:
                d['sidebar'] = d.get('sidebar') or dict(state='pending', source='codex-app-native')
        atomic(record(c, a.module), d)
    emit(d)


def receipt_errors(c, d, r):
    """Collect all independently detectable schema/evidence errors; never launch anything."""
    if not isinstance(r, dict):
        return ['receipt must be a JSON object']
    errors = []
    for k, v in dict(version=2, rq=meta(c)['rq'], module=d['module'], attempt=d['attempt']).items():
        if r.get(k) != v:
            errors.append(f'{k}: stale or mismatched value')
    if r.get('result') not in ('done', 'failed', 'blocked'):
        errors.append('result: use done/failed/blocked')
    if not isinstance(r.get('summary'), str) or not r['summary'].strip():
        errors.append('summary: required nonempty string')
    for k in ('risks', 'needsInput'):
        if not isinstance(r.get(k, []), list):
            errors.append(f'{k}: must be a list')
    tests = r.get('tests')
    if not isinstance(tests, list) or (r.get('result') == 'done' and not tests):
        errors.append('tests: verification evidence list required')
        tests = []
    for i, t in enumerate(tests):
        if not isinstance(t, dict):
            errors.append(f'tests[{i}]: must be an object')
            continue
        if not isinstance(t.get('command'), str) or not t['command'].strip():
            errors.append(f'tests[{i}].command: required')
        if t.get('result') not in ('passed', 'failed', 'blocked', 'not-run'):
            errors.append(f'tests[{i}].result: invalid')
        if not t.get('evidence'):
            errors.append(f'tests[{i}].evidence: required')
    if r.get('result') != 'done':
        return errors
    if any(not isinstance(t, dict) or t.get('result') not in ('passed', 'not-run') for t in tests):
        errors.append('done contains failed/blocked/invalid current checks')
    accept = d['role'] in ACCEPT_ROLES and d.get('phase') != 'author'
    if accept and any(not isinstance(t, dict) or t.get('result') != 'passed' for t in tests):
        errors.append('acceptance has unexecuted verification')
    if d['role'] == 'developer' and not any(isinstance(t, dict) and t.get('result') == 'passed' for t in tests):
        errors.append('developer has no passing verification')
    wt = None
    try:
        if not r.get('worktree') and not d.get('worktree'):
            raise ValueError('missing independent worktree')
        wt = verify_worktree(c, d, r.get('worktree') or d['worktree'])
    except (ValueError, OSError, subprocess.TimeoutExpired) as e:
        errors.append(str(e))
    sha = r.get('commit', '')
    if accept or d['role'] == 'developer' or d.get('phase') == 'author':
        if not isinstance(sha, str) or not re.fullmatch(r'[a-f0-9]{40,64}', sha):
            errors.append('missing full commit SHA')
        else:
            f = meta(c)
            if d['role'] == 'developer':
                if run(['git', '-C', f['repo'], 'merge-base', '--is-ancestor', sha, f['integrationBranch']], check=False).returncode:
                    errors.append('commit not landed on integration branch')
                if wt and run(['git', '-C', wt, 'merge-base', '--is-ancestor', sha, 'HEAD'], check=False).returncode:
                    errors.append('commit not present in worker worktree')
                if wt and run(['git', '-C', f['repo'], 'merge-base', '--is-ancestor', git(wt, 'rev-parse', 'HEAD'), f['integrationBranch']], check=False).returncode:
                    errors.append('worktree HEAD not landed on integration branch')
            if accept and (not wt or sha != git(wt, 'rev-parse', 'HEAD') or sha != git(f['repo'], 'rev-parse', f['integrationBranch'])):
                errors.append('acceptance baseline changed; reverify current integration')
            if d.get('phase') == 'author' and wt and sha != git(wt, 'rev-parse', 'HEAD'):
                errors.append('author commit does not match worktree HEAD')
    if wt and git(wt, 'status', '--porcelain'):
        errors.append('done worktree has uncommitted changes; evidence must match committed version')
    return errors


def read_receipt(c, d, explicit=None):
    paths = [Path(explicit)] if explicit else [c/(d['module']+'.receipt.json'), inbox(c, d)]
    invalid = None
    for p in paths:
        if not p.is_file():
            continue
        try:
            r = json.loads(p.read_text())
            errors = receipt_errors(c, d, r)
        except (ValueError, OSError, subprocess.TimeoutExpired) as e:
            r, errors = {}, [str(e)]
        if not errors:
            return r, p, []
        # A stale persistent file must not hide the current attempt's valid inbox receipt.
        if invalid is None or (isinstance(r, dict) and r.get('attempt') == d['attempt']):
            invalid = (r, p, errors)
    return invalid or (None, None, [])


def validate_receipt(a):
    c = coord(a.coord)
    d = load(c, a.module)
    r, path, errors = read_receipt(c, d, a.receipt_file)
    if r is None:
        errors = ['no receipt found']
    emit(dict(valid=not errors, module=d['module'], attempt=d['attempt'], receiptFile=str(path) if path else None, errors=errors))
    if errors:
        raise SystemExit(1)


def compact(c, d, r=None, path=None, errors=()):
    state = ('needs-review' if errors else r['result']) if r is not None else (
        d['state'] if d['state'] in ('prepared', 'setting-up', 'self', 'replying') else 'unknown')
    out = dict(module=d['module'], role=d['role'], attempt=d['attempt'], state=state,
               sessionId=d.get('sessionId'), hostId=d.get('hostId'), worktree=d.get('worktree'))
    if r is not None and isinstance(r, dict):
        out.update(summary=str(r.get('summary', ''))[:600], commit=r.get('commit'),
            tests={k:sum(isinstance(t, dict) and t.get('result') == k for t in (r.get('tests') if isinstance(r.get('tests'), list) else []))
                   for k in ('passed', 'failed', 'blocked', 'not-run')},
            risks=r.get('risks', []), needsInput=r.get('needsInput', []), receiptFile=str(path) if path else None)
    if errors:
        out['validationErrors'] = list(errors)
    if state == 'unknown':
        out['nextAction'] = 'Use wait_threads for runtime state; no verified receipt yet'
    return out


def status(a):
    c = coord(a.coord)
    jobs = []
    for p in sorted((c/'v2').glob('*.json')):
        if p.name.startswith('.'):
            continue
        d = load(c, p.stem)
        r, path, errors = read_receipt(c, d)
        out = compact(c, d, r, path, errors)
        if a.details:
            out.update(record=d, receipt=r)
        jobs.append(out)
    emit(dict(jobs=jobs))


def read(a):
    c = coord(a.coord)
    d = load(c, a.module)
    r, path, errors = read_receipt(c, d)
    if r is not None:
        emit(dict(receipt=r, validationErrors=errors) if errors else r)
    else:
        emit(dict(sessionId=d.get('sessionId'), hostId=d.get('hostId'), nextAction='Use read_thread only to investigate missing receipt, failure, input or unknown state'))


def find_handoff(c, d):
    # New writers use attempt-specific paths. Legacy writers are accepted only with
    # a timestamp from the active attempt, then stamped into a durable archive.
    for p in (handoff_path(c, d), handoff_path(c, d, True)):
        if p.is_file() and p.read_text().strip():
            return p
    since = max(d.get('repliedAt', 0), d.get('createdAt', 0))
    for p in (c/(d['module']+'.handoff.md'), inbox(c, d).parent/(d['module']+'.handoff.md')):
        if p.is_file() and p.stat().st_mtime >= since and p.read_text().strip():
            return p
    return None


def persist(c, d, r):
    dest = archive_dir(c, d)
    atomic(dest/'receipt.json', r)
    hp = find_handoff(c, d)
    if hp:
        content = hp.read_text()
        atomic_text(dest/'handoff.md', content)
        atomic_text(handoff_path(c, d), content)
        atomic_text(c/(d['module']+'.handoff.md'), content)  # compatibility alias
        atomic(dest/'handoff-source.json', dict(rq=meta(c)['rq'], module=d['module'], attempt=d['attempt'],
            source=str(hp), sha256=hashlib.sha256(content.encode()).hexdigest()))
    return dest, hp


def collect(a):
    c = coord(a.coord)
    with lock(c, a.module):
        d = load(c, a.module)
        r, path, errors = read_receipt(c, d)
        if r is None or errors:
            raise ValueError('no verified receipt to collect: '+ '; '.join(errors))
        dest, hp = persist(c, d, r)
        if r.get('worktree') and not d.get('worktree') and r['result'] == 'done':
            wt = verify_worktree(c, d, r['worktree'])
            d.update(worktree=str(wt), cwd=str(wt/d['subdir']) if d.get('subdir') else str(wt), branch=git(wt, 'rev-parse', '--abbrev-ref', 'HEAD'))
            atomic(record(c, a.module), d)
        atomic(c/(d['module']+'.receipt.json'), r)
    out = compact(c, d, r, c/(d['module']+'.receipt.json'))
    out.update(result=r['result'], archive=str(dest), handoffFile=str(dest/'handoff.md') if hp else None)
    if not hp:
        out['handoffWarning'] = 'No current-attempt handoff found; legacy receipt collected, fresh session requires a handoff'
    if a.details:
        out['receipt'] = r
    emit(out)


def reply(a):
    c = coord(a.coord)
    text = Path(a.text_file).read_text()
    if not text.strip():
        raise ValueError('empty reply')
    native_settings()
    with lock(c, a.module):
        d = load(c, a.module)
        if d['transport'] != 'native' or not d.get('sessionId'):
            raise ValueError('reply requires an existing real native thread')
        if d['state'] == 'replying':
            raise ValueError('previous send outcome unresolved; use existing next-prompt and reconcile with native tools')
        if d.get('replies', 0) >= MAX_REPLIES and not a.force:
            raise ValueError('rework cap reached; re-check requirements/contract/environment before --force')
        if a.phase and d['role'] not in ('verify', 'integ'):
            raise ValueError('--phase execute only applies to verify/integ')
        fresh = a.session == 'fresh'
        # The CLI cannot infer liveness from a receipt. Require an explicit host
        # observation of this exact thread; --force cannot bypass this safeguard.
        if fresh and (a.observed_state not in ('completed', 'failed', 'interrupted', 'stopped') or a.observed_session_id != d['sessionId']):
            raise ValueError('fresh requires host-confirmed old turn end: --observed-session-id and --observed-state; running/unknown/input waits are unsafe')
        r, path, errors = read_receipt(c, d)
        hp = find_handoff(c, d)
        if fresh and not hp:
            raise ValueError('fresh requires current-attempt handoff; write and collect it first')
        old = dict(d)
        if r is not None:
            persist(c, d, r)  # archive invalid evidence too; do not reinterpret failure as success
        if hp:
            atomic_text(archive_dir(c, d)/'handoff.md', hp.read_text())
        old_receipt = c/(d['module']+'.receipt.json')
        if old_receipt.exists():
            atomic_text(archive_dir(c, d)/'raw.receipt.json', old_receipt.read_text())
            old_receipt.unlink()
        old_prompt = c/(d['module']+'.prompt.md')
        if old_prompt.exists():
            atomic_text(archive_dir(c, d)/'prompt.md', old_prompt.read_text())
        d.update(attempt=uuid.uuid4().hex, state='prepared' if fresh else 'replying',
                 replies=d.get('replies', 0)+1, repliedAt=time.time())
        if a.phase:
            d['phase'] = a.phase
        if fresh:
            d['previousSessions'] = list(d.get('previousSessions', []))+[dict(
                sessionId=old['sessionId'], hostId=old.get('hostId', 'local'), attempt=old['attempt'],
                observedState=a.observed_state, observedAt=time.time(), handoffFile=str(archive_dir(c, old)/'handoff.md'))]
            d.update(sessionId=None, hostId=None, clientThreadId=None, sidebar=None)
        # Preserve the old baseline until the worker merges integration. Execute
        # receipts must match the current integration HEAD regardless of this field.
        head = f"本轮 attempt={d['attempt']}；回执和交接路径使用本轮身份。\n"
        if a.phase == 'execute':
            head += f"执行阶段：保留验收脚本，将最新 {meta(c)['integrationBranch']} 合入本工作树；脚本需要交付时先提交并 land，再记录实际验收 SHA。\n"
        head += text+'\n继续前重读本卡、最新原始需求/用例/契约；复测失败项、受影响分支与完整主流程。\n'
        task_path = c/(d['module']+'.task.md')
        if task_path.exists():
            task = task_path.read_text()
        else:
            # Existing native RQs predate .task.md: extract their business card
            # once, rather than copying old attempts/protocol into future cards.
            previous_prompt = old_prompt.read_text()
            marker = '\n任务卡：\n'
            task = previous_prompt.split(marker, 1)[-1] if marker in previous_prompt else previous_prompt
            atomic_text(task_path, task)
        handoff_ref = f"\n交接文件：{archive_dir(c,old)/'handoff.md'}\n" if hp else ''
        current_prompt = preamble(c, d)+task+handoff_ref+'\n本轮变更：\n'+head
        atomic_text(old_prompt, current_prompt)
        if fresh:
            prompt = current_prompt
        else:
            prompt = head+f"稳定 worker 协议：{ROOT.parent/'reference'/'worker.md'}\n当前完整任务卡：{old_prompt}\n"+(
                f"交接写 {handoff_path(c,d)}，回执写 {c/(d['module']+'.receipt.json')}；不可写则分别写 {handoff_path(c,d,True)} 和 {inbox(c,d)}。\n"
                f"完成前运行 {shlex.quote(str(ROOT/'cc-fleet'))} validate-receipt --coord {shlex.quote(str(c))} --module {d['module']}。\n")
        atomic_text(c/(d['module']+'.next-prompt.md'), prompt)
        atomic(record(c, a.module), d)
    emit(dict(d, sessionPolicy='fresh' if fresh else 'reuse', nativeSettings=native_settings(), nativeSettingsPolicy='inherit-parent',
        prompt=prompt, promptFile=str(c/(d['module']+'.next-prompt.md')),
        nextAction=NATIVE_SETTINGS_ACTION+('Call create_thread; move and register the new real identity with --attempt. Reuse the existing worktree; do not archive/stop the old thread automatically.' if fresh else
            'Call send_message_to_thread for the existing identity; after acceptance register the same identity. If outcome is uncertain, inspect before retrying.')))


def snapshot(a):
    c = coord(a.coord)
    text = Path(a.file).read_text().strip()
    if not text:
        raise ValueError('empty current snapshot')
    with lock(c, 'CURRENT'):
        p = c/'CURRENT.md'
        if p.exists():
            old = p.read_text()
            if old.strip() == text:
                emit(dict(currentFile=str(p), changed=False))
                return
            path = c/'history'/'current'/(datetime.datetime.now().strftime('%Y%m%d-%H%M%S-')+uuid.uuid4().hex[:8]+'.md')
            atomic_text(path, old)
        atomic_text(p, text+'\n')
    emit(dict(currentFile=str(p), changed=True))


def dispatch(a):
    c = coord(a.coord)
    d = load(c, a.module)
    if d['state'] not in ('prepared', 'setting-up'):
        raise ValueError('already attempted; inspect registered native identity before retrying')
    emit(dict(d, promptFile=str(c/(d['module']+'.prompt.md')), nativeSettings=native_settings(), nativeSettingsPolicy='inherit-parent',
        nextAction=NATIVE_SETTINGS_ACTION+'Use native create_thread only if not already pending; move, verify and register.'))


def retired_hook(a):
    # External settings still invoke these old hooks. A silent no-op removes the
    # legacy machinery without editing unrelated global configuration.
    return


def parser():
    p = argparse.ArgumentParser(description=__doc__)
    subs = p.add_subparsers(dest='cmd', required=True)
    q = subs.add_parser('init')
    q.add_argument('--cwd', required=True)
    q.add_argument('--host', choices=('codex-app',), default='codex-app')
    for arg in ('owner-id', 'base', 'rq'):
        q.add_argument('--'+arg)
    q.set_defaults(fn=init)
    for cmd, fn in [('prepare', prepare), ('bind', bind), ('register', register), ('dispatch', dispatch),
                    ('status', status), ('read', read), ('collect', collect), ('validate-receipt', validate_receipt),
                    ('reply', reply), ('snapshot', snapshot)]:
        q = subs.add_parser(cmd)
        q.add_argument('--coord', required=True)
        q.set_defaults(fn=fn)
        if cmd not in ('status', 'snapshot'):
            q.add_argument('--module', required=True, type=name)
        if cmd in ('bind', 'register'):
            q.add_argument('--attempt')
        if cmd == 'prepare':
            q.add_argument('--task', required=True)
            q.add_argument('--role', default='developer', choices=('developer', 'scout', *ACCEPT_ROLES))
            q.add_argument('--phase', choices=('author',))
            q.add_argument('--self', dest='self_dev', action='store_true')
            q.add_argument('--subdir')
            q.add_argument('--backend', choices=('codex',), default='codex')
            q.add_argument('--transport', choices=('auto', 'native'), default='native')
            q.add_argument('--permissions', choices=('inherit',), default='inherit')
            q.add_argument('--after', help=argparse.SUPPRESS)  # explicit diagnostic for existing prompts
        if cmd == 'bind':
            q.add_argument('--worktree', required=True)
        if cmd == 'register':
            g = q.add_mutually_exclusive_group(required=True)
            g.add_argument('--session-id')
            g.add_argument('--client-thread-id')
            q.add_argument('--host-id')
            q.add_argument('--sidebar-section-id')
        if cmd in ('status', 'collect'):
            q.add_argument('--details', action='store_true')
        if cmd == 'validate-receipt':
            q.add_argument('--receipt-file')
        if cmd == 'reply':
            q.add_argument('--text-file', required=True)
            q.add_argument('--phase', choices=('execute',))
            q.add_argument('--force', action='store_true')
            q.add_argument('--session', choices=('auto', 'reuse', 'fresh'), default='auto')
            q.add_argument('--observed-session-id')
            q.add_argument('--observed-state', choices=('completed', 'failed', 'interrupted', 'stopped', 'running', 'unknown', 'waiting'))
        if cmd == 'snapshot':
            q.add_argument('--file', required=True)
    for cmd in ('stop-guard', 'rescue-owners'):
        subs.add_parser(cmd, help=argparse.SUPPRESS).set_defaults(fn=retired_hook)
    return p


if __name__ == '__main__':
    try:
        args = parser().parse_args()
        args.fn(args)
    except (ValueError, OSError, KeyError, TypeError, subprocess.TimeoutExpired) as e:
        print(json.dumps(dict(error=str(e)), ensure_ascii=False), file=sys.stderr)
        sys.exit(2)
