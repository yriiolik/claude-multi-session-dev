#!/usr/bin/env node
// cc-fleet-panel-register — 把一个协调目录登记进 Codex 面板的全局注册表。
//
// 面板要跨 session、跨仓库看到所有 codex worker，但满盘扫 `.git/fleet` 又慢又不可靠
// （worker 的仓库路径和编排者的 cwd 常常不是一个）。所以由 `cc-fleet init` 与派发脚本主动登记一行。
// 注册表里目录已消失的条目由面板侧自动剔除，这里只负责写入。

"use strict";

const path = require("path");
const jobsLib = require("./lib/codex-app-jobs.js");

const argv = process.argv.slice(2).filter((a) => a !== "--");
const flags = new Set(argv.filter((a) => a.startsWith("-")));
const pos = argv.filter((a) => !a.startsWith("-"));
if (flags.has("-h") || flags.has("--help") || (!pos.length && !flags.has("--list"))) {
  console.error(`cc-fleet-panel-register <coord-dir> [rq] [--no-owner]

  coord-dir   协调目录，通常是 <git-common-dir>/fleet/<RQ>
  rq          RQ id；省略时取 coord-dir 的目录名
  --no-owner  不记录主 session 归属（不在主 session 进程树里手工补登记时用）

  --list      打印当前注册表（已剔除失效目录）`);
  process.exit(flags.has("-h") || flags.has("--help") ? 0 : 5);
}

if (flags.has("--list")) {
  console.log(JSON.stringify(jobsLib.listCoords(), null, 2));
  process.exit(0);
}

const coord = path.resolve(pos[0]);
const rq = pos[1] || path.basename(coord);
jobsLib.registerCoord(coord, rq);

// 顺带记下"这批 worker 是谁派的"。本进程跑在主 session 的进程树里，此刻才拿得到它的身份；
// 事后再想补就只能靠 cwd 猜了。面板用它做任务组的标题。
let ownerNote = "";
if (!flags.has("--no-owner")) {
  try {
    const owner = jobsLib.detectOwner();
    owner.cwd = process.env.PWD || process.cwd();
    jobsLib.writeOwnerMeta(coord, owner);
    ownerNote = owner.name ? ` owner=${owner.name}` : " owner=(未识别主 session)";
  } catch (e) {
    ownerNote = ` owner=记录失败(${String(e.message || e).slice(0, 60)})`;
  }
}

console.log(`✅ 已登记到 Codex 面板注册表: ${coord} (rq=${rq})${ownerNote}`);
