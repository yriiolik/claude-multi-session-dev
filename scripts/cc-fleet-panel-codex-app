#!/usr/bin/env node
// cc-fleet-panel-codex-app — Codex App worker 的终端面板（对标 `claude agents` 的 FleetView）。
//
// 为什么要有它：Codex worker 是 app-server 里的 thread，没有进程、没有 PTY，也不在
// `~/.claude/sessions/<pid>.json` 里自注册，所以**永远不可能**出现在 `claude agents` 的列表里
// （实测伪造 jobs/state.json 与 sessions/<pid>.json 均不被列出）。这个面板就是 codex 侧的等价物。
//
// 三条硬约束：
//   1. **只读**。面板每几秒刷一次，任何 unarchive/resume/unpin/写回元数据的副作用都会被放大成
//      刷屏级写入，还会和编排者的 status 调用互相打架。状态判定复用 lib/codex-app-jobs.js 的纯函数。
//   2. **全局视角**。worker 是跨 session、跨仓库派发的，面板读全局注册表而不是某个 cwd 的 .git/fleet。
//   3. **"空闲 ≠ 完成"**。Codex 的 turn 跑完就 idle，只有 summary 首行是 `result:` 才算真交付。
//      idle-without-receipt 记作「需核验」，归在**未完成**里，也不触发自动关闭。
//
// 组织方式：按**任务组（RQ）**分组，组标题是发起这批 worker 的主 session 名字；组内只分
// 未完成 / 已完成两栏，各 worker 的具体状态由行首标记表达（执行中的标记是动画）。
//
// 交互：↑↓/jk 选择 · →/l/Enter 进详情 · ←/h/Esc 返回 · r 刷新 · q 退出。

"use strict";

const fs = require("fs");
const path = require("path");
const { spawnSync } = require("child_process");
const jobsLib = require("./lib/codex-app-jobs.js");
const rollout = require("./lib/codex-rollout.js");

// ---------------------------------------------------------------- 参数

const opt = {
  coords: [],
  rq: "",
  interval: 3000,
  detailInterval: 2000,
  autoClose: process.env.CC_FLEET_PANEL_AUTOCLOSE !== "0",
  closeGrace: 20,
  idleTimeout: 300,
  closeOnAttention: false,
  maxAgeHours: 24,
  once: false,
  plain: !process.stdout.isTTY,
  json: false,
  keys: [],
  codexBin: "",
  startAppServer: true,
  spin: true,
  targetRatio: Number(process.env.CC_FLEET_PANEL_RATIO) || 0,
};

function usage() {
  console.error(`cc-fleet-panel-codex-app — Codex App worker 面板（只读）

用法:
  cc-fleet-panel-codex-app                  # 全局：读注册表里所有协调目录
  cc-fleet-panel-codex-app --rq RQ-2026-...  # 只看一个任务组
  cc-fleet-panel-codex-app --coord DIR       # 额外纳入一个协调目录（可重复）

选项:
  --interval MS          列表刷新间隔（默认 3000）
  --detail-interval MS   详情刷新间隔（默认 2000）
  --max-age-hours N      只展示 N 小时内派发/收尾的 worker（默认 24）
  --auto-close           全部 worker 收工后自动退出（默认开；分屏随之关闭）
  --no-auto-close        常驻，不自动退出
  --close-grace SEC      收工后等待多久再退出（默认 20）
  --close-on-attention   有「需核验/异常」也照样自动退出（默认不退，留着让你看）
  --idle-timeout SEC     一直没见到活跃 worker 就退出（默认 300，0=不退）
  --no-spin              执行中的标记不做动画
  --target-ratio R       启动后把分屏收窄到源面板的 R 倍宽（0.2~0.6；Ghostty 只会对半切）
  --once                 渲染一帧到 stdout 后退出（不进 raw 模式）
  --plain                关闭 ANSI 颜色
  --json                 输出状态模型 JSON 后退出
  --keys a,b,c           先按一串键再渲染（配合 --once，测试用）
  --codex-bin PATH       指定 Codex CLI
  --no-start-app-server  只连已有 app-server`);
}

for (let i = 2; i < process.argv.length; i++) {
  const a = process.argv[i];
  if (a === "--coord") opt.coords.push(process.argv[++i] || "");
  else if (a === "--rq") opt.rq = process.argv[++i] || "";
  else if (a === "--interval") opt.interval = Number(process.argv[++i]) || 3000;
  else if (a === "--detail-interval") opt.detailInterval = Number(process.argv[++i]) || 2000;
  else if (a === "--max-age-hours") opt.maxAgeHours = Number(process.argv[++i]) || 0;
  else if (a === "--auto-close") opt.autoClose = true;
  else if (a === "--no-auto-close") opt.autoClose = false;
  else if (a === "--close-grace") opt.closeGrace = Number(process.argv[++i]) || 0;
  else if (a === "--close-on-attention") opt.closeOnAttention = true;
  else if (a === "--idle-timeout") opt.idleTimeout = Number(process.argv[++i]) || 0;
  else if (a === "--no-spin") opt.spin = false;
  else if (a === "--target-ratio") opt.targetRatio = Number(process.argv[++i]) || 0;
  else if (a === "--once") opt.once = true;
  else if (a === "--plain") opt.plain = true;
  else if (a === "--json") opt.json = true;
  else if (a === "--keys") opt.keys = String(process.argv[++i] || "").split(",").map((s) => s.trim()).filter(Boolean);
  else if (a === "--codex-bin") opt.codexBin = process.argv[++i] || "";
  else if (a === "--start-app-server") opt.startAppServer = true;
  else if (a === "--no-start-app-server") opt.startAppServer = false;
  else if (a === "-h" || a === "--help") { usage(); process.exit(0); }
  else { console.error(`unknown flag: ${a}`); usage(); process.exit(5); }
}

// ---------------------------------------------------------------- 显示宽度

// 终端按列排版，CJK 与多数 emoji 占 2 列。宽度算错只会让右边界毛糙，不影响正确性，
// 所以这里用一份够用的区间表，不引外部依赖。
function charWidth(cp) {
  if (cp === 0) return 0;
  if (cp < 32 || (cp >= 0x7f && cp < 0xa0)) return 0;
  if (cp >= 0x0300 && cp <= 0x036f) return 0;
  if (cp >= 0xfe00 && cp <= 0xfe0f) return 0; // variation selectors
  if (
    (cp >= 0x1100 && cp <= 0x115f) ||
    (cp >= 0x231a && cp <= 0x231b) ||
    (cp >= 0x23e9 && cp <= 0x23fa) ||
    (cp >= 0x2600 && cp <= 0x26ff) ||
    (cp >= 0x2b1b && cp <= 0x2b1c) ||
    (cp >= 0x2e80 && cp <= 0xa4cf) ||
    (cp >= 0xac00 && cp <= 0xd7a3) ||
    (cp >= 0xf900 && cp <= 0xfaff) ||
    (cp >= 0xfe30 && cp <= 0xfe6f) ||
    (cp >= 0xff00 && cp <= 0xff60) ||
    (cp >= 0xffe0 && cp <= 0xffe6) ||
    (cp >= 0x1f300 && cp <= 0x1f9ff) ||
    (cp >= 0x20000 && cp <= 0x3fffd)
  ) return 2;
  return 1;
}

function dispWidth(str) {
  let w = 0;
  for (const ch of String(str)) w += charWidth(ch.codePointAt(0));
  return w;
}

function truncate(str, max) {
  if (max <= 0) return "";
  const s = String(str).replace(/[\r\n\t]+/g, " ");
  if (dispWidth(s) <= max) return s;
  let out = "";
  let w = 0;
  for (const ch of s) {
    const cw = charWidth(ch.codePointAt(0));
    if (w + cw > max - 1) break;
    out += ch;
    w += cw;
  }
  return `${out}…`;
}

function padTo(str, width) {
  const gap = width - dispWidth(str);
  return gap > 0 ? str + " ".repeat(gap) : str;
}

// 详情页按列宽折行再交给渲染，终端自己回绕会把缩进吃掉，读起来是散的。
function wrap(text, width, indent = "") {
  const out = [];
  const limit = Math.max(8, width - dispWidth(indent));
  for (const raw of String(text).replace(/\t/g, "  ").split(/\r?\n/)) {
    if (!raw) { out.push(indent); continue; }
    let line = "";
    let w = 0;
    for (const ch of raw) {
      const cw = charWidth(ch.codePointAt(0));
      if (w + cw > limit) { out.push(indent + line); line = ""; w = 0; }
      line += ch;
      w += cw;
    }
    out.push(indent + line);
  }
  return out;
}

// ---------------------------------------------------------------- 配色

const C = opt.plain
  ? new Proxy({}, { get: () => (s) => String(s) })
  : {
      dim: (s) => `\x1b[2m${s}\x1b[22m`,
      bold: (s) => `\x1b[1m${s}\x1b[22m`,
      cyan: (s) => `\x1b[36m${s}\x1b[39m`,
      green: (s) => `\x1b[32m${s}\x1b[39m`,
      yellow: (s) => `\x1b[33m${s}\x1b[39m`,
      red: (s) => `\x1b[31m${s}\x1b[39m`,
      magenta: (s) => `\x1b[35m${s}\x1b[39m`,
      blue: (s) => `\x1b[34m${s}\x1b[39m`,
      sel: (s) => `\x1b[7m${s}\x1b[27m`,
    };

// ---------------------------------------------------------------- 状态语义

// 组内只分未完成 / 已完成两栏（bucket），具体状态差异靠行首标记 + 文案表达。
// 唯一不能含糊的是 needs-check：thread 空闲但没落 `result:` 回执——它算**未完成**。
const SPINNER = ["·", "✢", "✳", "∗", "✻", "✽"];

function classify(job) {
  switch (job.state) {
    case "running":
      return { bucket: "pending", tone: "cyan", mark: null, label: "执行中" };
    case "blocked":
      return { bucket: "pending", tone: "yellow", mark: "⏳", label: "待输入" };
    case "done":
      return job.receipt
        ? { bucket: "done", tone: "green", mark: "✓", label: "已回执" }
        : { bucket: "pending", tone: "yellow", mark: "!", label: "需核验" };
    case "failed":
      return { bucket: "pending", tone: "red", mark: "✗", label: "失败" };
    case "stopped":
      return { bucket: "pending", tone: "red", mark: "⊘", label: "已停止" };
    case "lost":
      return { bucket: "pending", tone: "red", mark: "?", label: "元数据缺失" };
    default:
      return { bucket: "pending", tone: "yellow", mark: "?", label: "状态未知" };
  }
}

const STATE_ORDER = ["running", "blocked", "unknown", "done", "failed", "stopped", "lost"];

function fmtAge(sec) {
  if (!Number.isFinite(sec) || sec < 0) return "-";
  if (sec < 60) return `${Math.floor(sec)}s`;
  if (sec < 3600) return `${Math.floor(sec / 60)}m`;
  if (sec < 86400) return `${Math.floor(sec / 3600)}h`;
  return `${Math.floor(sec / 86400)}d`;
}

function mtimeOf(file) {
  try {
    return Math.floor(fs.statSync(file).mtimeMs / 1000);
  } catch {
    return 0;
  }
}

function fmtClock(sec) {
  const d = new Date(sec * 1000);
  const p = (n) => String(n).padStart(2, "0");
  return `${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
}

function jobMtime(job) {
  let t = Number(job.started_at) || 0;
  for (const f of [job.summary_file, job.meta]) t = Math.max(t, mtimeOf(f));
  return t;
}

// 时间列回答的是「这个 worker 干了多久」，不是「派发到现在过了多久」。后者对已收工的 worker
// 会一直往上涨——昨天派的会写成 20h，看不出它其实只跑了 12 分钟。
//
// 麻烦在于 Codex 元数据里只有 started_at：worker 是 app-server 里的 thread，收工时没有任何人
// 往磁盘写一笔"结束了"。所以拿**最后一次真实活动**当结束时间，按可信度排序：
//   ① 回执文件 mtime —— 落回执就是交付时刻，最准；
//   ② rollout 日志 mtime —— 还没落回执的终态 worker（需核验/失败/被停），它记录 worker 最后
//      一次说话或跑命令的时间；
//   ③ meta mtime —— 兜底。
// 特意不把 meta mtime 排在前面：status 脚本会往 meta 追加 detail，那是**编排者**写的，
// 不代表 worker 还在干活，用它算耗时会把等待验收的时间也算进去。
function jobEndedAt(job) {
  if (jobsLib.ACTIVE_STATES.has(job.state)) return 0; // 还在跑，没有结束时间
  const started = Number(job.started_at) || 0;
  const rf = rolloutFor(job);
  const candidates = [job.receipt ? mtimeOf(job.summary_file) : 0, rf ? mtimeOf(rf) : 0, mtimeOf(job.meta)];
  // 早于开始时间的一律不认（文件没被更新过时 mtime 可能就是创建时刻，甚至更早）
  return candidates.find((t) => t && t >= started) || 0;
}

// 已收工 → 实际耗时；还在跑 → 到现在为止已经跑了多久。拿不到开始时间返回 -1，fmtAge 显示 "-"。
// 结束时间在 collect() 里算好挂到 job 上：渲染要跟着标记动画每 130ms 重跑一遍，不能每帧去 stat 文件。
function jobElapsed(job, now) {
  const started = Number(job.started_at) || 0;
  if (!started) return -1;
  const ended = job.endedAt === undefined ? jobEndedAt(job) : job.endedAt;
  return Math.max(0, (ended || now) - started);
}

// ---------------------------------------------------------------- 采集

function activeCoords() {
  const seen = new Set();
  const out = [];
  const add = (coord, rq) => {
    if (!coord) return;
    const abs = path.resolve(coord);
    if (seen.has(abs)) return;
    try {
      if (!fs.statSync(abs).isDirectory()) return;
    } catch { return; }
    seen.add(abs);
    out.push({ coord: abs, rq: rq || path.basename(abs) });
  };
  for (const c of opt.coords) add(c, opt.rq);
  for (const c of jobsLib.listCoords()) add(c.coord, c.rq);
  return opt.rq ? out.filter((c) => c.rq === opt.rq) : out;
}

// 组标题用主 session 的**实时**名字（派发时落的 owner.meta 只存 pid/id，名字会被取名 hook 改写）。
// owner.meta 之前派发的历史 RQ 没有归属记录，退而按 task.meta 的 cwd 推断，最后才退到仓库名。
function groupTitle(coord) {
  const owner = jobsLib.readOwnerMeta(coord);
  const live = jobsLib.resolveOwnerName(owner);
  if (live) return { title: live, owner, ownerSource: "meta" };
  const guess = jobsLib.inferOwnerByCwd(coord);
  if (guess && guess.name) return { title: guess.name, owner: guess, ownerSource: "inferred" };
  const repo = repoOf(coord);
  return { title: repo ? `（${repo} 的任务）` : "（未记录主 session）", owner, ownerSource: "none" };
}

// 列表的 detail 列要回答"此刻在干什么"。原始 detail 是 `Codex App thread active turn=<uuid>`
// 和回执文件路径——两条都没有信息量。所以：跑着的看 rollout 最近一条事件，落了回执的看回执首行。
function liveDetail(job) {
  if (job.receipt) {
    try {
      const first = fs.readFileSync(job.summary_file, "utf8").split(/\r?\n/).find((l) => l.trim());
      if (first) return `🧾 ${first.replace(/^result:\s*/i, "")}`;
    } catch {}
    return job.detail;
  }
  if (job.state !== "running" && job.state !== "blocked") return job.detail;
  const file = rolloutFor(job);
  if (!file) return job.detail;
  const act = rollout.lastActivity(file);
  if (!act) return job.detail;
  if (act.kind === "shell") return `$ ${act.text}`;
  if (act.kind === "patch") return `✎ ${act.text}`;
  if (act.kind === "message") return `💬 ${act.text}`;
  return `🧠 ${act.text}`;
}

// coord 形如 <repo>/.git/fleet/<RQ>，回退两层就是仓库根。
function repoOf(coord) {
  const m = String(coord).match(/^(.*)\/\.git\/fleet\/[^/]+$/);
  return m ? path.basename(m[1]) : "";
}

function collect() {
  const now = Math.floor(Date.now() / 1000);
  const cutoff = opt.maxAgeHours > 0 ? now - opt.maxAgeHours * 3600 : 0;
  const groups = [];
  const jobs = [];
  let appUnavailable = false;

  for (const c of activeCoords()) {
    const snap = jobsLib.readOnlySnapshot(c.coord, {
      codexBin: opt.codexBin,
      startAppServer: opt.startAppServer,
      // 老 RQ 的已收工 worker 会永远留在注册表里。时间窗必须在 thread/read 之前就把它们挡掉，
      // 否则面板每一次刷新都会为历史记录 spawn 一堆 app 调用。
      //
      // 但只剔除「光看磁盘就能确定终态」的（有回执 / 被主控 kill 过）。状态未知的一律放行去问
      // app-server —— 一个连跑两天的 worker 磁盘文件根本不动，按 mtime 一刀切会让它从面板上消失。
      filter: (job) => {
        if (!cutoff) return true;
        job.ts = jobMtime(job);
        if (!job.ts || job.ts >= cutoff) return true;
        const settled = jobsLib.receiptDone(job.summary_file) || job.terminated === "1";
        return !settled;
      },
    });
    if (snap.appUnavailable) appUnavailable = true;
    if (!snap.jobs.length) continue;

    const { title, owner, ownerSource } = groupTitle(c.coord);
    const group = {
      key: c.coord,
      rq: c.rq,
      title,
      owner,
      ownerSource,
      repo: repoOf(c.coord),
      jobs: [],
      pending: 0,
      done: 0,
      ts: 0,
    };
    for (const job of snap.jobs) {
      job.rq = job.rq || c.rq;
      job.ts = job.ts || jobMtime(job);
      job.group = group;
      job.cls = classify(job);
      job.endedAt = jobEndedAt(job);
      job.detail = liveDetail(job) || job.detail;
      // 组标题已经写了 RQ，行内只留模块名，把宽度让给 detail
      job.displayName = `↳${job.module}`;
      group.jobs.push(job);
      group[job.cls.bucket] += 1;
      group.ts = Math.max(group.ts, job.ts || 0);
    }
    group.jobs.sort((a, b) => {
      if (a.cls.bucket !== b.cls.bucket) return a.cls.bucket === "pending" ? -1 : 1;
      const sa = STATE_ORDER.indexOf(a.state);
      const sb = STATE_ORDER.indexOf(b.state);
      if (sa !== sb) return sa - sb;
      return (b.ts || 0) - (a.ts || 0);
    });
    groups.push(group);
  }

  // 有未完成的任务组排前面，其余按最近活动倒序
  groups.sort((a, b) => {
    if (!!a.pending !== !!b.pending) return a.pending ? -1 : 1;
    return (b.ts || 0) - (a.ts || 0);
  });
  for (const g of groups) jobs.push(...g.jobs);

  return {
    now,
    groups,
    jobs,
    pending: jobs.filter((j) => j.cls.bucket === "pending").length,
    done: jobs.filter((j) => j.cls.bucket === "done").length,
    appUnavailable,
  };
}

// ---------------------------------------------------------------- 详情

// rollout 文件路径按 thread id 扫目录树得到，结果缓存：面板每 2 秒刷一次，不能每次都遍历。
const rolloutCache = new Map();

function rolloutFor(job) {
  const tid = job.thread_id || job.id;
  if (!tid) return "";
  if (rolloutCache.has(tid)) {
    const cached = rolloutCache.get(tid);
    if (cached && fs.existsSync(cached)) return cached;
  }
  const found = rollout.findRollout(tid);
  rolloutCache.set(tid, found);
  return found;
}

function readThreadFallback(job) {
  const threadId = job.thread_id || job.id;
  if (!threadId) return { error: "缺少 thread_id" };
  try {
    const callApp = jobsLib.makeAppCaller({
      coord: job.coord,
      codexBin: opt.codexBin,
      startAppServer: opt.startAppServer,
    });
    return callApp("thread/read", { threadId, includeTurns: true });
  } catch (e) {
    return { error: String(e.message || e) };
  }
}

function timelineLines(items, width, truncated) {
  const out = [];
  const rule = C.dim("─".repeat(Math.max(10, Math.min(width, 160))));
  if (truncated) out.push(C.dim("（rollout 过长，只解析了末尾部分）"));
  for (const it of items) {
    if (it.type === "turn") {
      out.push("");
      out.push(`${C.blue("▶ turn")} ${C.dim(it.text.replace(/^turn /, ""))}`);
      continue;
    }
    if (it.type === "task") {
      // 任务卡有几百行，全摊开会把真正的执行过程挤没。默认只给前几行。
      const lines = String(it.text).split(/\r?\n/);
      out.push(C.magenta("📋 任务卡"));
      for (const l of lines.slice(0, 8)) out.push(...wrap(l, width, "   "));
      if (lines.length > 8) out.push(C.dim(`   …（任务卡共 ${lines.length} 行，此处折叠）`));
      out.push(rule);
      continue;
    }
    if (it.type === "thinking") {
      out.push(C.dim("🧠 思考"));
      for (const l of wrap(it.text, width, "   ")) out.push(C.dim(l));
      continue;
    }
    if (it.type === "message") {
      out.push(C.green("💬 回复"));
      out.push(...wrap(it.text, width, "   "));
      continue;
    }
    if (it.type === "call") {
      if (it.kind === "patch") {
        out.push(`${C.magenta("✎ 改文件")} ${truncate(it.text, width - 12)}`);
      } else {
        const bad = it.exitCode !== null && it.exitCode !== undefined && it.exitCode !== 0;
        const head = bad ? C.red("✗ $") : C.cyan("$");
        const tag = it.exitCode === null || it.exitCode === undefined
          ? C.dim(" …运行中")
          : C.dim(` exit=${it.exitCode}`);
        out.push(`${head} ${truncate(it.text, width - 14)}${tag}`);
      }
      const body = String(it.output || "").split(/\r?\n/).filter((l) => l.trim() !== "");
      const tail = body.slice(-8);
      for (const l of tail) out.push(C.dim(truncate(`   ${l}`, width)));
      if (body.length > tail.length) out.push(C.dim(`   …（输出共 ${body.length} 行）`));
      continue;
    }
  }
  return out;
}

function detailLines(job, width) {
  const lines = [];
  const rule = C.dim("─".repeat(Math.max(10, Math.min(width, 160))));
  const file = rolloutFor(job);
  let meta = {};
  let body = [];

  if (file) {
    const tl = rollout.readTimeline(file);
    meta = tl.meta || {};
    body = timelineLines(tl.items, width, tl.truncated);
    if (!tl.items.length) body = [C.dim("（rollout 里还没有可读事件）")];
  } else {
    // rollout 找不到（thread 刚建 / CODEX_HOME 不同）时退回 app-server。它只给消息级 item，
    // 看不到命令与思考，所以明确告诉用户这是降级视图，别以为 worker 什么都没干。
    const res = readThreadFallback(job);
    body.push(C.yellow("⚠ 找不到 rollout 日志，降级为 app-server 消息视图（看不到命令与思考）"));
    if (res.error) body.push(C.red(`❌ ${res.error}`));
    for (const turn of res.thread?.turns || []) {
      body.push(C.blue(`▶ turn ${turn.status || ""}`));
      for (const it of turn.items || []) {
        if (it.type === "agentMessage" && it.text) {
          body.push(C.green("💬 回复"));
          body.push(...wrap(it.text, width, "   "));
        } else if (it.type === "commandExecution") {
          body.push(`${C.cyan("$")} ${truncate(it.command || "", width - 10)}`);
        }
      }
    }
  }

  lines.push(C.dim(`thread ${job.thread_id || job.id || "-"}`));
  // 列表里只有一个耗时数字，容易分不清"跑了多久"和"什么时候跑的"，详情页把两头都摊开。
  const startedAt = Number(job.started_at) || 0;
  if (startedAt) {
    const ended = job.endedAt === undefined ? jobEndedAt(job) : job.endedAt;
    const span = `${fmtClock(startedAt)} → ${ended ? fmtClock(ended) : "进行中"}`;
    lines.push(C.dim(`耗时   ${fmtAge(jobElapsed(job, Math.floor(Date.now() / 1000)))}（${span}）`));
  }
  lines.push(C.dim(`模型   ${meta.provider || job.model_provider || "?"}/${meta.model || job.model || "?"}${(meta.effort || job.reasoning_effort) ? ` · effort=${meta.effort || job.reasoning_effort}` : ""}`));
  if (job.branch) lines.push(C.dim(`分支   ${job.branch}`));
  const wd = meta.workdir || job.worktree_cwd;
  if (wd) lines.push(...wrap(`工作树 ${wd}`, width, "").map(C.dim));
  if (meta.tokens) lines.push(C.dim(`token  ${meta.tokens.toLocaleString("en-US")}`));
  lines.push(C.dim(`回执   ${job.receipt ? `🧾 在案 ${job.summary_file}` : "未落回执"}`));
  lines.push(C.dim(`日志   ${file || "(未找到 rollout)"}`));
  lines.push(rule);

  // 有回执时先把回执正文摆出来——这是验收时唯一有契约保证的内容。
  if (job.receipt) {
    lines.push(C.green("🧾 回执"));
    try {
      for (const l of fs.readFileSync(job.summary_file, "utf8").split(/\r?\n/)) {
        lines.push(...wrap(l, width, "   "));
      }
    } catch (e) {
      lines.push(C.red(`   读取回执失败: ${String(e.message || e)}`));
    }
    lines.push(rule);
  }

  return lines.concat(body);
}

// ---------------------------------------------------------------- 渲染

// 无色的标记字符。选中行整行反色，必须拿这个来排版——把带 ANSI 的版本塞进 padTo 会把列宽算多。
function markChar(job, frame) {
  if (job.cls.mark) return job.cls.mark;
  return opt.spin ? SPINNER[frame % SPINNER.length] : "✳";
}

function rowMark(job, frame) {
  return C[job.cls.tone](markChar(job, frame));
}

function renderList(model, ui) {
  const width = ui.width;
  const lines = [];
  const scope = opt.rq ? `RQ ${opt.rq}` : "全局";
  lines.push(`${C.bold("Codex Fleet")} ${C.dim(`· ${scope} · ${model.groups.length} 任务组 · ${model.jobs.length} worker`)}`);
  const parts = [];
  if (model.pending) parts.push(C.cyan(`${model.pending} 未完成`));
  if (model.done) parts.push(C.green(`${model.done} 已完成`));
  lines.push(parts.length ? parts.join(C.dim(" · ")) : C.dim("暂无 worker"));
  if (model.appUnavailable) lines.push(C.red("⚠ app-server 不可达；未落回执的线程状态读不到"));

  if (!model.groups.length) {
    lines.push("");
    lines.push(C.dim("（还没有 Codex worker；派发后会自动出现在这里）"));
    lines.push("");
    lines.push(C.dim("↑↓ 选择 · → 进详情 · ← 返回 · r 刷新 · q 退出"));
    return lines;
  }

  const nameW = Math.min(
    Math.max(14, ...model.jobs.map((j) => dispWidth(j.displayName))),
    Math.floor(width * 0.3)
  );
  const stateW = 6;
  const ageW = 5;
  const detailW = Math.max(10, width - 5 - nameW - stateW - ageW - 4);

  for (const g of model.groups) {
    lines.push("");
    // 组标题：主 session 名字（谁派的） + RQ + 仓库 + 完成度
    const right = `${g.rq}${g.repo ? ` · ${g.repo}` : ""}  ${g.done}/${g.jobs.length} 完成`;
    const left = truncate(g.title, Math.max(10, width - dispWidth(right) - 4));
    lines.push(`${C.bold(left)}${C.dim(" ".repeat(Math.max(1, width - dispWidth(left) - dispWidth(right))) + right)}`);

    let lastBucket = "";
    for (const job of g.jobs) {
      if (job.cls.bucket !== lastBucket) {
        lastBucket = job.cls.bucket;
        lines.push(C.dim(`  ${lastBucket === "pending" ? "未完成" : "已完成"}`));
      }
      const selected = model.jobs[ui.cursor] === job;
      const name = padTo(truncate(job.displayName, nameW), nameW);
      const label = padTo(job.cls.label, stateW);
      const detail = padTo(truncate(job.detail || "", detailW), detailW);
      const age = padTo(fmtAge(jobElapsed(job, model.now)), ageW);
      if (selected) {
        // 选中行整行反色，配色必须按无色文本排版，ANSI 转义混进 padTo 会算多
        lines.push(C.sel(padTo(`   ${markChar(job, ui.frame)} ${name} ${label} ${detail} ${age}`, width)));
      } else {
        lines.push(`   ${rowMark(job, ui.frame)} ${name} ${C[job.cls.tone](label)} ${C.dim(detail)} ${C.dim(age)}`);
      }
    }
  }

  lines.push("");
  lines.push(C.dim("↑↓ 选择 · → 进详情 · ← 返回 · r 刷新 · q 退出"));
  return lines;
}

function renderDetail(model, ui) {
  const job = model.jobs[ui.cursor];
  if (!job) return [C.dim("（没有选中的 worker）")];
  const g = job.group;
  const head = [
    `${C.bold(job.displayName)} ${C.dim(`· ${g.title} · ${g.rq}`)}`,
    `${C[job.cls.tone](job.cls.label)} ${C.dim(fmtAge(jobElapsed(job, model.now)))} ${C.dim(truncate(job.detail || "", ui.width - 20))}`,
    "",
  ];
  const body = ui.detailLines || [C.dim("加载中…")];
  const foot = C.dim("← 返回 · ↑↓ 滚动 · PgUp/PgDn 翻页 · End 跟随最新 · r 刷新 · q 退出");
  const avail = Math.max(3, ui.height - head.length - 2);
  const maxOff = Math.max(0, body.length - avail);
  if (ui.follow) ui.detailOffset = maxOff;
  ui.detailOffset = Math.max(0, Math.min(ui.detailOffset, maxOff));
  const view = body.slice(ui.detailOffset, ui.detailOffset + avail);
  const pos = maxOff > 0 ? C.dim(`  [${ui.detailOffset}/${maxOff}${ui.follow ? " 跟随" : ""}]`) : "";
  return [...head, ...view, `${foot}${pos}`];
}

// ---------------------------------------------------------------- 分屏比例自校正

// Ghostty 的 split 固定对半，且没有"按比例分"的配置项——能程序化调整的只有相对移动分割线的
// `resize_split:<方向>,<像素>`。像素↔列的换算取决于字号，事先算不出来，所以由面板自己收敛：
// 发一次 resize，用实际列数变化反推每列多少像素，第二次就能一步到位（通常两步以内收敛）。
//
// 为什么是面板做而不是 cc-fleet-panel-open 做：只有面板自己读得到分屏的列数。
// 面板的 terminal id 由 open 写在状态文件里，这里等它落盘。
function osaPerform(terminalId, action) {
  const script = `on run argv
  set theId to item 1 of argv
  set theAction to item 2 of argv
  tell application "Ghostty"
    set target to missing value
    repeat with t in terminals
      if (id of t as text) is theId then
        set target to t
        exit repeat
      end if
    end repeat
    if target is missing value then return "not-found"
    return (perform action theAction on target) as text
  end tell
end run`;
  const res = spawnSync(process.env.CC_GHOSTTY_OSASCRIPT || "/usr/bin/osascript",
    ["-", terminalId, action],
    { input: script, encoding: "utf8", stdio: ["pipe", "pipe", "pipe"] });
  return res.status === 0;
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function waitForTerminalId(deadlineMs = 3000) {
  const started = Date.now();
  while (Date.now() - started < deadlineMs) {
    const st = jobsLib.readPanelState();
    // openedAt 用来排除上一次遗留的状态文件：只认本进程启动前后写下的那条
    if (st.terminalId && (!st.openedAt || st.openedAt * 1000 >= started - 30000)) return st.terminalId;
    await sleep(120);
  }
  return "";
}

// 收敛过程发生在 alt-screen 里，出问题时屏幕上什么都看不到（只会表现为"宽度不对"）。
// CC_FLEET_PANEL_DEBUG=<file> 时把每一步落盘，排查时才有东西可看。
function fitLog(msg) {
  const file = process.env.CC_FLEET_PANEL_DEBUG;
  if (!file) return;
  try { fs.appendFileSync(file, `${msg}\n`); } catch {}
}

async function fitSplitRatio(ratio) {
  if (!(ratio > 0.05 && ratio < 0.95)) return;
  if (!process.stdout.isTTY) { fitLog("skip: 不是 TTY"); return; }
  const terminalId = await waitForTerminalId();
  if (!terminalId) { fitLog("skip: 拿不到 terminal id"); return; }
  fitLog(`start ratio=${ratio} cols=${process.stdout.columns} terminal=${terminalId}`);

  let pxPerCol = jobsLib.DEFAULT_PX_PER_COL;
  let totalCols = 0;
  for (let step = 0; step < 4; step++) {
    const before = process.stdout.columns || 0;
    if (!before) return;
    const plan = jobsLib.planSplitResize({ currentCols: before, ratio, pxPerCol, totalCols });
    totalCols = plan.totalCols; // 总宽只在第一步按"对半"推定，之后固定，免得越算越偏
    if (plan.done) { fitLog(`done step=${step} cols=${before} target=${plan.targetCols}`); return; }
    fitLog(`step=${step} cols=${before} target=${plan.targetCols} ${plan.direction},${plan.pixels}px pxPerCol=${pxPerCol.toFixed(2)}`);
    if (!osaPerform(terminalId, `resize_split:${plan.direction},${plan.pixels}`)) { fitLog("osascript 失败"); return; }
    // 等 SIGWINCH 生效
    for (let w = 0; w < 12; w++) {
      await sleep(50);
      if ((process.stdout.columns || 0) !== before) break;
    }
    const after = process.stdout.columns || before;
    const movedCols = Math.abs(after - before);
    if (movedCols === 0) { fitLog(`stall at cols=${after}`); return; } // 已经到边界，再推也没用
    pxPerCol = plan.pixels / movedCols;
    ui.width = after;
    draw();
  }
}

function paint(lines, ui) {
  if (opt.once) {
    process.stdout.write(`${lines.join("\n")}\n`);
    return;
  }
  process.stdout.write(`\x1b[H\x1b[2J${lines.slice(0, ui.height).join("\r\n")}`);
}

// ---------------------------------------------------------------- 主循环状态

const ui = {
  view: "list",
  cursor: 0,
  detailOffset: 0,
  follow: true,
  detailLines: null,
  detailKey: "",
  frame: 0,
  width: process.stdout.columns || 100,
  height: process.stdout.rows || 30,
};

let model = collect();
let sawActive = false;
let allDoneSince = 0;
const startedAt = Date.now();

const anyActive = (m) => m.jobs.some((j) => jobsLib.ACTIVE_STATES.has(j.state));
const anyAttention = (m) => m.jobs.some((j) => j.cls.bucket === "pending" && !jobsLib.ACTIVE_STATES.has(j.state));

// 自动关闭：只有「见过活跃 worker」之后才可能触发，避免面板刚被派发脚本拉起、
// 第一个 thread 还没建好就自己关掉。跨 session 的新派发会重新写进注册表，
// 下一 tick 就会被 collect() 看到并重置计时。
function maybeAutoClose() {
  if (!opt.autoClose) return false;
  if (anyActive(model)) { sawActive = true; allDoneSince = 0; return false; }
  if (!sawActive) {
    if (opt.idleTimeout > 0 && Date.now() - startedAt > opt.idleTimeout * 1000) return true;
    return false;
  }
  if (!opt.closeOnAttention && anyAttention(model)) return false;
  if (!allDoneSince) allDoneSince = Date.now();
  return Date.now() - allDoneSince >= opt.closeGrace * 1000;
}

function clampCursor() {
  if (!model.jobs.length) { ui.cursor = 0; return; }
  ui.cursor = Math.max(0, Math.min(ui.cursor, model.jobs.length - 1));
}

let lastDetailAt = 0;

function refreshDetail(force) {
  const job = model.jobs[ui.cursor];
  if (!job) { ui.detailLines = null; return; }
  const key = `${job.coord}::${job.module}`;
  const stale = Date.now() - lastDetailAt >= opt.detailInterval;
  // 换了 worker 必须立刻重读；同一个 worker 则按 detail-interval 节流。
  if (!force && ui.detailKey === key && ui.detailLines && !stale) return;
  ui.detailKey = key;
  ui.detailLines = detailLines(job, ui.width);
  lastDetailAt = Date.now();
}

function draw() {
  ui.width = process.stdout.columns || ui.width;
  ui.height = process.stdout.rows || ui.height;
  clampCursor();
  paint(ui.view === "detail" ? renderDetail(model, ui) : renderList(model, ui), ui);
}

// ---------------------------------------------------------------- 按键

function applyKey(key) {
  if (key === "q") return "quit";
  if (key === "r") {
    model = collect();
    if (ui.view === "detail") refreshDetail(true);
    return "";
  }
  if (ui.view === "list") {
    if (key === "up") ui.cursor = Math.max(0, ui.cursor - 1);
    else if (key === "down") ui.cursor = Math.min(Math.max(0, model.jobs.length - 1), ui.cursor + 1);
    else if (key === "home") ui.cursor = 0;
    else if (key === "end") ui.cursor = Math.max(0, model.jobs.length - 1);
    else if (key === "right" || key === "enter") {
      if (model.jobs.length) {
        ui.view = "detail";
        ui.detailOffset = 0;
        ui.follow = true;
        refreshDetail(true);
      }
    }
    return "";
  }
  // detail
  if (key === "left" || key === "esc") { ui.view = "list"; return ""; }
  if (key === "up") { ui.follow = false; ui.detailOffset = Math.max(0, ui.detailOffset - 1); return ""; }
  if (key === "down") { ui.detailOffset += 1; return ""; }
  if (key === "pgup") { ui.follow = false; ui.detailOffset = Math.max(0, ui.detailOffset - (ui.height - 6)); return ""; }
  if (key === "pgdn") { ui.detailOffset += ui.height - 6; return ""; }
  if (key === "end") { ui.follow = true; return ""; }
  if (key === "home") { ui.follow = false; ui.detailOffset = 0; return ""; }
  return "";
}

function decodeKey(buf) {
  const s = buf.toString("utf8");
  if (s === "\x03") return "q";            // ctrl-c
  if (s === "\x1b[A" || s === "k" || s === "\x10") return "up";
  if (s === "\x1b[B" || s === "j" || s === "\x0e") return "down";
  if (s === "\x1b[C" || s === "l") return "right";
  if (s === "\x1b[D" || s === "h") return "left";
  if (s === "\x1b[5~") return "pgup";
  if (s === "\x1b[6~") return "pgdn";
  if (s === "\x1b[H" || s === "g") return "home";
  if (s === "\x1b[F" || s === "G") return "end";
  if (s === "\r" || s === "\n") return "enter";
  if (s === "\x1b") return "esc";
  if (s === "q") return "q";
  if (s === "r") return "r";
  return "";
}

// ---------------------------------------------------------------- 入口

for (const k of opt.keys) {
  if (applyKey(k) === "quit") break;
}

if (opt.json) {
  const sel = model.jobs[ui.cursor];
  console.log(JSON.stringify({
    scope: opt.rq || "global",
    pending: model.pending,
    done: model.done,
    appUnavailable: model.appUnavailable,
    view: ui.view,
    cursor: ui.cursor,
    selected: sel ? { module: sel.module, rq: sel.rq, bucket: sel.cls.bucket } : null,
    groups: model.groups.map((g) => ({
      rq: g.rq,
      title: g.title,
      repo: g.repo,
      ownerPid: g.owner?.pid || 0,
      ownerSource: g.ownerSource,
      pending: g.pending,
      done: g.done,
      modules: g.jobs.map((j) => j.module),
    })),
    jobs: model.jobs.map((j) => ({
      module: j.module,
      rq: j.rq,
      name: j.displayName,
      state: j.state,
      bucket: j.cls.bucket,
      label: j.cls.label,
      receipt: j.receipt ? 1 : 0,
      thread_id: j.thread_id || j.id || "",
      detail: j.detail || "",
      // 已收工的是实际执行耗时，还在跑的是"到现在为止"；ended_at=0 表示尚未结束
      started_at: Number(j.started_at) || 0,
      ended_at: j.endedAt || 0,
      elapsed_sec: jobElapsed(j, model.now),
    })),
  }, null, 2));
  process.exit(0);
}

if (opt.once) {
  if (ui.view === "detail") refreshDetail(true);
  draw();
  process.exit(0);
}

// —— 常驻模式 ——
// pidfile 是 cc-fleet-panel-open 判断"面板已经开着"的唯一依据，必须在常驻循环起来之前写。
jobsLib.writePanelPid(process.pid);

let closing = false;
function shutdown(code) {
  if (closing) return;
  closing = true;
  jobsLib.clearPanelPid(process.pid);
  if (!opt.plain) process.stdout.write("\x1b[?25h\x1b[?1049l");
  try { process.stdin.setRawMode(false); } catch {}
  process.exit(code || 0);
}

if (!opt.plain) process.stdout.write("\x1b[?1049h\x1b[?25l");
process.on("SIGINT", () => shutdown(0));
process.on("SIGTERM", () => shutdown(0));
process.stdout.on("error", () => shutdown(0));

if (process.stdin.isTTY) {
  process.stdin.setRawMode(true);
  process.stdin.resume();
  process.stdin.on("data", (buf) => {
    const key = decodeKey(buf);
    if (!key) return;
    if (applyKey(key) === "quit") return shutdown(0);
    draw();
  });
}

draw();

// 分屏收窄到目标比例（Ghostty 只会对半切，见 fitSplitRatio 的说明）。异步进行，不挡主循环。
if (opt.targetRatio) fitSplitRatio(opt.targetRatio).catch(() => {});

// 动画只重绘、不采集：帧率跟数据刷新彻底解耦，否则要么标记不动，要么每 120ms 打一次 app-server。
const spinTimer = opt.spin ? setInterval(() => {
  if (ui.view !== "list") return;
  if (!model.jobs.some((j) => j.state === "running")) return;
  ui.frame += 1;
  draw();
}, 130) : null;
if (spinTimer && spinTimer.unref) spinTimer.unref();

const listTimer = setInterval(() => {
  const before = model.jobs[ui.cursor];
  model = collect();
  if (before) {
    const idx = model.jobs.findIndex((j) => j.coord === before.coord && j.module === before.module);
    if (idx >= 0) ui.cursor = idx;
  }
  if (ui.view === "detail") refreshDetail(false);
  draw();
  if (maybeAutoClose()) {
    clearInterval(listTimer);
    if (spinTimer) clearInterval(spinTimer);
    if (!opt.plain) process.stdout.write("\x1b[?25h\x1b[?1049l");
    console.log("✅ Codex worker 全部收工，面板自动关闭。");
    shutdown(0);
  }
}, opt.interval);

process.on("exit", () => {
  jobsLib.clearPanelPid(process.pid);
  if (!opt.plain && !closing) process.stdout.write("\x1b[?25h\x1b[?1049l");
});
