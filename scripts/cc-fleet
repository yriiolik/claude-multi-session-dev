#!/usr/bin/env python3
"""Cross-client fleet controller. Python stdlib; public CLIs, persistent receipts.
Native Codex App operations are performed by the host, then registered here.
"""
import argparse, concurrent.futures, contextlib, datetime, fcntl, json, os
from pathlib import Path
import re, shlex, subprocess, sys, tempfile, time, uuid

ROOT = Path(__file__).resolve().parent
HOSTS = ('codex-app', 'codex-cli', 'claude-code')
TERMINAL = {'done', 'failed', 'blocked', 'stopped', 'needs-review', 'unknown', 'launch-uncertain'}
STALE_AFTER = int(os.environ.get('CC_FLEET_STALE_AFTER', '600'))  # running with no observable activity

def run(argv, cwd=None, timeout=45, check=True, input=None, env=None):
    p = subprocess.run([str(x) for x in argv], cwd=cwd, input=input, text=True, env=env,
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    if check and p.returncode:
        # CLI errors may contain authentication configuration; don't dump raw logs.
        raise RuntimeError(f'{Path(str(argv[0])).name} {argv[1] if len(argv)>1 else ""} failed (exit {p.returncode})')
    return p

def git(cwd, *args):
    return run(['git', '-C', str(cwd), *args]).stdout.strip()

def emit(obj):
    print(json.dumps(obj, ensure_ascii=False, indent=2), flush=True)

def atomic(path, obj):
    path = Path(path); path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            json.dump(obj, f, ensure_ascii=False, indent=2); f.write('\n')
            f.flush(); os.fsync(f.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)

def name(value):
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,95}', value):
        raise ValueError('RQ/module must use letters, digits, dot, underscore or hyphen (max 96)')
    return value

def coord(value):
    p = Path(value).expanduser().resolve()
    if not (p/'fleet.json').is_file(): raise ValueError('not a v2 coordination directory')
    return p

def inbox(c,d):
    f=meta(c)
    root=Path(f.get('inboxRoot',str(Path(tempfile.gettempdir())/'fleet-v2-inbox'/f['rq'])))
    return root/(d['module']+'-'+d['attempt']+'.receipt.json')

def meta(c): return json.loads((c/'fleet.json').read_text())
def record(c, m): return c/'v2'/f'{name(m)}.json'
def load(c, m): return json.loads(record(c,m).read_text())

@contextlib.contextmanager
def lock(c, m):
    p = c/'v2'; p.mkdir(exist_ok=True)
    with (p/f'.{name(m)}.lock').open('a') as f:
        fcntl.flock(f, fcntl.LOCK_EX); yield

def update(c, m, **fields):
    with lock(c,m):
        d=load(c,m); d.update(fields); atomic(record(c,m),d); return d

def call(method, params, start=False, timeout=35):
    argv=[os.environ.get('CODEX_APP_CALL_BIN', str(ROOT/'cc-codex-app-call'))]
    if start: argv+=['--start-app-server']
    argv+=['--timeout-ms', str(max(1000, (timeout-2)*1000)), method, '-']
    return json.loads(run(argv, input=json.dumps(params), timeout=timeout).stdout)

def permission_params(d, turn=False):
    # Explicit user preference for fleet workers; legacy records adopt the new default.
    if d.get('permissions', 'full') == 'inherit': return {}
    return dict(approvalPolicy='never', **({'sandboxPolicy': {'type': 'dangerFullAccess'}}
                                         if turn else {'sandbox': 'danger-full-access'}))

def default_backend(host):
    # 未指定 --backend 时跟随主端（用户 2026-09-11 纠正）：Claude 主端派 Claude，Codex 主端派 Codex。
    return 'claude' if host=='claude-code' else 'codex'

def clean_subdir(s):
    s=(s or '').strip().strip('/')
    if s in ('','.'): return ''
    if Path(s).is_absolute() or '..' in Path(s).parts: raise ValueError('subdir must be relative inside the repository')
    return Path(s).as_posix()

def toplevel(p):
    return str(Path(git(Path(p).resolve(),'rev-parse','--show-toplevel')).resolve())

def worktree_path(fleet, m):
    # 不放 .git 内：Vite 等默认拒绝服务 **/.git/** 的文件；放仓库 .claude/worktrees 下沿用 Claude 目录信任。
    return Path(fleet['repo'])/'.claude'/'worktrees'/f"fleet-{fleet['rq']}-{m}"

def exclude_worktrees(fleet):
    if run(['git','-C',fleet['repo'],'check-ignore','-q','.claude/worktrees/probe'],check=False).returncode==0: return
    ex=Path(fleet['commonDir'])/'info'/'exclude'; ex.parent.mkdir(parents=True,exist_ok=True)
    with ex.open('a') as f: f.write('\n.claude/worktrees/\n')

def route(fleet):
    # Claude 主端显式派 Codex 时的固定路由；never send an OpenAI model to a third-party provider.
    if fleet['owner']['host']=='claude-code':
        return dict(active='claude-main-gpt6-low',mode='fixed',model='gpt-6-astra',
                    modelProvider='openai',reasoningEffort='low',providerType='openai')
    return json.loads(run([ROOT/'cc-codex-session-config','resolve','--json']).stdout)

def init(a):
    repo=Path(git(a.cwd,'rev-parse','--show-toplevel')).resolve()
    common=Path(git(repo,'rev-parse','--path-format=absolute','--git-common-dir')).resolve()
    base=a.base or git(repo,'symbolic-ref','--short','HEAD')
    sha=git(repo,'rev-parse','--verify',base+'^{commit}')
    # 主 session 所在子目录（多项目仓库的子项目）；worker 默认在自己 worktree 的同一子目录启动，才能加载该目录规则。
    try: subdir=clean_subdir(Path(a.cwd).resolve().relative_to(repo).as_posix())
    except ValueError: subdir=''
    rq=name(a.rq or ('RQ-'+datetime.datetime.now().strftime('%Y%m%d-%H%M%S')+'-'+uuid.uuid4().hex[:8]))
    c=common/'fleet'/rq
    c.mkdir(parents=True,exist_ok=False)
    try: git(repo,'branch','fleet/'+rq,sha)
    except Exception:
        c.rmdir(); raise
    # Claude Code 注入的是 CLAUDE_CODE_SESSION_ID；只认 CLAUDE_SESSION_ID 会让主 session 身份一直取不到、面板判不了主 session 是否已退出
    owner_id=a.owner_id or (os.environ.get('CODEX_THREAD_ID') if a.host.startswith('codex') else (os.environ.get('CLAUDE_CODE_SESSION_ID') or os.environ.get('CLAUDE_SESSION_ID')))
    identity_source='session' if owner_id else 'generated-controller'
    owner_id=owner_id or ('controller-'+uuid.uuid4().hex)
    d=dict(version=2,rq=rq,repo=str(repo),commonDir=str(common),subdir=subdir,base=base,baseCommit=sha,
           integrationBranch='fleet/'+rq,inboxRoot=str((Path(tempfile.gettempdir())/'fleet-v2-inbox'/rq).resolve()),owner={'host':a.host,'id':owner_id,'identitySource':identity_source},createdAt=time.time())
    atomic(c/'fleet.json',d); (c/'base.ref').write_text(base+'\n')
    # 建组即登记面板：任何后端/传输（含 native）、无论本 session 开不开分屏，全局面板都看得到这个任务组。
    panel_register(c,rq)
    emit(dict(d,coord=str(c),uncommittedChangesExcluded=bool(git(repo,'status','--porcelain'))))

def preamble(c,d):
    # 只放本任务独有的数据与不可推导的边界；项目规则交给客户端按启动目录自动加载的 CLAUDE.md / AGENTS.md。
    fleet=meta(c); role=d['role']; rq=fleet['rq']
    if d['transport']=='native':
        where=(f"在 App 新建的隔离 worktree 内工作；若它尚未基于集成分支，确认工作树干净后 git switch --detach {fleet['integrationBranch']}"
               +(f"，再 cd {d['subdir']}" if d.get('subdir') else '')+'。')
    else:
        where=f"工作目录 {d['cwd']}（worktree 根 {d['worktree']}），不在主 checkout 改文件。"
    if d.get('permissions')=='inherit': where+='Git 元数据写入需审批时用宿主审批工具申请，无通道则报 blocked。'
    if role=='developer':
        duty=f"developer：只在范围内开发，按用例自测并留证据，提交后运行 {shlex.quote(str(ROOT/'cc-fleet-land'))} {rq}。"
    else:
        duty=f'{role}：不改业务代码、不提交合回。'
        if role in ('verify','integ'):
            duty+=('在含全部改动的集成版本上用真实页面先连续跑核心主流程，再逐项验证适用分支/异常、幂等和事务；'
                   'API/单测或 mock 自家业务 API 不能替代页面验收，纯接口/CLI 需求记录不适用理由；'
                   '逐例记录操作、结果、截图或 trace 路径、基线 SHA/环境。')
        if role=='regression':
            duty+=('本 RQ 的成批 e2e 只由你这一张卡跑一次（开发 worker 各自只跑了改动相关的几条）：'
                   '在集成基线上持独占 e2e 锁，按任务卡给定的回归集合一次跑完，结果落盘文件；'
                   '任务卡没写「全量」就不要自行跑项目全量入口，失败逐条回报现象指向哪个模块。')
    # 测试范围纪律：worker 各跑一遍全量是多 session 最大的隐性成本（几十分钟 + 吃满 CPU + e2e 锁下互相排队）。
    cq=shlex.quote(str(c)); mq=d['module']
    scope_bin=shlex.quote(str(ROOT/'cc-fleet-e2e-scope')); lock_bin=shlex.quote(str(ROOT/'cc-fleet-e2e-lock'))
    if role=='scout': testing=''
    elif role=='regression':
        testing=(f'跑前 {lock_bin} acquire {cq} {mq} --mode exclusive、跑完 release；按任务卡给定的回归集合一次跑完并落盘结果，'
                 f'任务卡没写「全量」就不跑项目全量入口。\n')
    else:
        testing=(f'测试只跑本卡改动相关的最小集合（范围见任务卡「E2E 范围」，缺则 {scope_bin} suggest 推导后裁剪；'
                 f'≤6 spec 且 ≤15 分钟，超预算的写进 risks 交回归卡）；⛔ 不跑项目全量 e2e 入口，'
                 f'跨模块回归由主 session 统一派 regression 卡跑一次。跑 e2e 前后 {lock_bin} acquire/release {cq} {mq}，'
                 f'跑完 {scope_bin} record {cq} {mq} <spec…> 登记范围。\n')
    return f'''⟦FLEET-WORKER⟧ rq={rq} module={d['module']} role={role} backend={d['backend']}
你是独立 worker：不加载 multi-session-dev 编排技能、不再派发 worker，只做任务卡授权的范围。主 session：{fleet['owner']['id']}。
协调目录 {c}；任务身份 {d['attempt']}（回执 attempt 须一致）；集成分支 {fleet['integrationBranch']}。
{where}
开工先运行 {shlex.quote(str(ROOT/'cc-fleet'))} bind --coord {shlex.quote(str(c))} --module {d['module']} --worktree "$PWD"；协调目录只读致失败时不阻断，回执里写真实 worktree。
规则以启动目录适用的 CLAUDE.md / AGENTS.md 为准（客户端已按目录自动加载）；AGENTS.md 只是指针时按指针读取对应文件；任务涉及其他子项目时先读该子目录的规则文件。
{duty}
{testing}禁止 reset --hard、推远端、合回共享分支、删除或清理 worktree；范围/权限问题写 blocked 回执并说明所需输入。
开工及压缩恢复后先读任务卡引用的原始需求、用户用例、契约（及本次参考资料）；实现/验收卡缺用例或必需输入时报告缺项，不自行缩减需求。
失败如实写 tests.result=failed 且 result=failed/blocked，不藏进 risks、不改 not-run、不删断言；只做了计划不能报 done。
完成时把下列 JSON 原子写到 {c/(d['module']+'.receipt.json')}（临时文件+rename）；该目录不可写就 mkdir -p 后改写 {inbox(c,d)}，任一成功即可；最后回复同一 JSON。
{{"version":2,"rq":"{rq}","module":"{d['module']}","attempt":"{d['attempt']}","worktree":"worktree 根绝对路径","result":"done|failed|blocked","summary":"真实完成内容/问题","commit":"开发提交或实际验收的完整 SHA，scout 可空","tests":[{{"command":"实际执行的检查","result":"passed|failed|blocked|not-run","evidence":"结果文件路径或简短输出"}}],"risks":[],"needsInput":[]}}
\n任务卡：\n'''

def prepare(a):
    c=coord(a.coord); fleet=meta(c); m=name(a.module)
    a.backend=a.backend or default_backend(fleet['owner']['host'])
    transport=a.transport
    if transport=='auto': transport='native' if fleet['owner']['host']=='codex-app' and a.backend=='codex' and a.permissions=='inherit' else ('app-server' if a.backend=='codex' else 'claude-bg')
    if (a.backend=='claude' and transport!='claude-bg') or (a.backend=='codex' and transport not in ('native','app-server')):
        raise ValueError('backend/transport mismatch')
    if transport=='native' and fleet['owner']['host']!='codex-app': raise ValueError('native requires a Codex App main session')
    if transport=='native' and a.permissions=='full': raise ValueError('native cannot set full permissions; use app-server or --permissions inherit')
    subdir=clean_subdir(fleet.get('subdir','') if a.subdir is None else a.subdir)
    if subdir and run(['git','-C',fleet['repo'],'cat-file','-e',f"{fleet['integrationBranch']}:{subdir}"],check=False).returncode:
        raise ValueError(f'subdir not found on integration branch: {subdir}')
    task=Path(a.task).resolve().read_text()
    if not task.strip(): raise ValueError('empty task card')
    with lock(c,m):
        if record(c,m).exists(): raise ValueError('module already registered; use reply, or a new fix module')
        d=dict(version=2,module=m,backend=a.backend,transport=transport,role=a.role,permissions=a.permissions,
               attempt=uuid.uuid4().hex,state='prepared',name=f'↳{m}@{fleet["rq"]}',createdAt=time.time(),
               sessionId=None,shortId=None,worktree=None,branch=None,subdir=subdir,cwd=None,
               baselineCommit=git(fleet['repo'],'rev-parse',fleet['integrationBranch']))
        if transport!='native':
            wt=worktree_path(fleet,m); exclude_worktrees(fleet)
            branch=f'fleet-worker/{fleet["rq"]}/{m}'
            git(fleet['repo'],'worktree','add','-b',branch,str(wt),fleet['integrationBranch'])
            d.update(worktree=str(wt),branch=branch,cwd=str(wt/subdir) if subdir else str(wt))
        atomic(record(c,m),d)
        prompt=preamble(c,d)+task
        (c/f'{m}.prompt.md').write_text(prompt)
    emit(dict(d,coord=str(c),promptFile=str(c/f'{m}.prompt.md'),integrationBranch=fleet['integrationBranch']))

def bind(a):
    # worker 在子项目目录启动，$PWD 可能是子目录；一律规整到 worktree 根。
    c=coord(a.coord); f=meta(c); wt=Path(toplevel(a.worktree))
    if wt==Path(f['repo']).resolve(): raise ValueError('worker must not use primary checkout')
    if Path(git(wt,'rev-parse','--path-format=absolute','--git-common-dir')).resolve()!=Path(f['commonDir']): raise ValueError('wrong repository')
    # Require the full current integration baseline, not simply a branch with a familiar name.
    d=load(c,a.module)
    if run(['git','-C',wt,'merge-base','--is-ancestor',d['baselineCommit'],'HEAD'],check=False).returncode:
        raise ValueError('worker does not contain integration baseline')
    if d.get('worktree') and Path(d['worktree']).resolve()!=wt: raise ValueError('worktree already bound elsewhere')
    branch=git(wt,'rev-parse','--abbrev-ref','HEAD')
    if d.get('worktree')==str(wt) and d.get('branch')==branch:
        emit(d); return
    emit(update(c,a.module,worktree=str(wt),branch=branch))

def register(a):
    c=coord(a.coord); d=load(c,a.module)
    if d['transport']!='native': raise ValueError('register is for native App tasks')
    # clientThreadId represents pending setup, never a callable threadId.
    if a.client_thread_id:
        emit(update(c,a.module,clientThreadId=a.client_thread_id,state='setting-up')); return
    if d.get('sessionId') and d['sessionId']!=a.session_id: raise ValueError('task already has a different threadId')
    emit(sidebar_attach(c,update(c,a.module,sessionId=a.session_id,hostId=a.host_id,state='running',clientThreadId=None)))

def workdir(d): return d.get('cwd') or d['worktree']
def claude_bin(): return os.environ.get('CLAUDE_CLI_PATH','claude')
def claude_jobs():
    obj=json.loads(run([claude_bin(),'agents','--json','--all']).stdout)
    if not isinstance(obj,list): raise ValueError('unsupported Claude agents JSON schema')
    return obj

def sidebar_attach(c, d):
    """Use server-owned sections, never private desktop UI state or worker prompts."""
    if d.get('backend') != 'codex' or not d.get('sessionId'): return d
    if d.get('hostId', 'local') != 'local':
        result = dict(state='pending', reason='remote host requires its own app-server connection')
    else:
        try:
            sections=[]; cursor=None; seen=set()
            while True:
                page=call('threadSection/list', dict(limit=100, **({'cursor':cursor} if cursor else {})))
                sections.extend(page['data']); cursor=page.get('nextCursor')
                if not cursor: break
                if cursor in seen: raise ValueError('repeated section cursor')
                seen.add(cursor)
            matches=[x for x in sections if x.get('name')=='子 session']
            if len(matches)!=1: raise ValueError('expected one existing 子 session section')
            section_id=matches[0]['id']
            previous=d.get('sidebar', {})
            if previous.get('state')=='placed' and previous.get('sectionId')==section_id:
                return d
            call('thread/section/move', dict(threadId=d['sessionId'],sectionId=section_id))
            result=dict(state='placed',sectionId=section_id)
        except Exception as e:
            result=dict(state='pending',reason=str(e))
    return update(c,d['module'],sidebar=result)

def panel_register(c, rq):
    """登记面板全局注册表。与分屏开关无关、总是做：面板是全机一块，别的主 session 已开着的面板要看得到本任务组；
    CC_FLEET_PANEL=0 只表示「本 session 不开分屏」。幂等（刷新 lastSeen 与 owner.meta），尽力而为，失败不影响编排。"""
    bin_=os.environ.get('CC_FLEET_PANEL_REGISTER_BIN',str(ROOT/'cc-fleet-panel-register'))
    try: return run([bin_,str(c),rq],timeout=30,check=False).returncode==0
    except Exception: return False

def panel_attach(c, d):
    """CLI 路径（Codex app-server / Claude --bg）worker 派发成功后：登记面板注册表 + 在当前 Ghostty 窗口分屏拉起只读面板。
    两种后端同屏：按任务组列出子 session、状态与最近动作，→ 进详情看完整时间线（Codex 读 rollout，Claude 读 transcript）。
    尽力而为：面板脚本自己处理 Ghostty 没开/没授权/不是 macOS 的情况，绝不因面板让派发失败。
    CC_FLEET_PANEL=0 只是不开分屏（panelOpened=None），登记照做；native（Codex App 主端，App 自带侧栏）不走这里。"""
    if d.get('transport') not in ('app-server','claude-bg'): return None
    fleet=meta(c); out=dict(registered=panel_register(c,fleet['rq']),panelOpened=None)
    if os.environ.get('CC_FLEET_PANEL')=='0': return out
    bin_=os.environ.get('CC_FLEET_PANEL_OPEN_BIN',str(ROOT/'cc-fleet-panel-open'))
    try: out['panelOpened']=run([bin_,'--quiet'],timeout=30,check=False,env=dict(os.environ,CC_FLEET_PANEL_CWD=fleet['repo'])).returncode==0
    except Exception: out['panelOpened']=False
    return out

def dispatch(a):
    c=coord(a.coord); m=a.module
    with lock(c,m):
        d=load(c,m)
        if d['state']!='prepared': raise ValueError('already attempted; inspect/reconcile before retrying')
        if d['transport']=='native':
            emit(dict(d,nextAction='Use list_projects + create_thread, then register the returned threadId (or clientThreadId while pending).',promptFile=str(c/f'{m}.prompt.md'))); return
        d['state']='launching'; atomic(record(c,m),d)
    prompt=(c/f'{m}.prompt.md').read_text()
    try:
        if d['transport']=='claude-bg':
            args=[claude_bin(),'--bg','--name',d['name']]
            if d.get('permissions','full')=='full': args+=['--dangerously-skip-permissions']
            # Existing backend config remains authoritative; no model-name substitution.
            conf=Path(os.environ.get('CLAUDE_FLEET_CONFIG',str(Path.home()/'.claude/multi-session-dev.json')))
            profile={}
            if conf.exists():
                profile=json.loads(conf.read_text()).get(a.profile,{})
                for field in ('model','effort'):
                    if profile.get(field): args+=['--'+field,str(profile[field])]
            # 只作展示（面板详情页的模型行）；不参与 reply/路由。
            d['claudeProfile']={k:str(profile[k]) for k in ('model','effort') if profile.get(k)}
            args += [prompt]
            # 在子项目目录启动：Claude 按启动目录向上加载 CLAUDE.md，根目录启动会漏掉子项目规则。
            p=run(args,cwd=workdir(d),timeout=55,check=False)
            # Reconcile through public JSON, not localized launch output or session-name prefixes.
            hits=[j for j in claude_jobs() if j.get('name')==d['name'] and Path(j.get('cwd','/')).resolve()==Path(workdir(d)).resolve()]
            if len(hits)!=1 or not hits[0].get('id'):
                raise RuntimeError('launch outcome uncertain; inspect claude agents --json --all; do not redispatch')
            j=hits[0]; d.update(shortId=j['id'],sessionId=j.get('sessionId'),state='running',activeSince=time.time())
        else:
            routing=route(meta(c)); d['routing']=routing
            # Apply fleet permission preference explicitly at thread and turn boundaries.
            # Codex 只加载 git 根到 cwd 路径上的 AGENTS.md，cwd 必须是子项目目录。
            params=dict(cwd=workdir(d),ephemeral=False,serviceName='multi-session-dev-v2',threadSource='user')
            if routing.get('model'): params['model']=routing['model']
            if routing.get('modelProvider'): params['modelProvider']=routing['modelProvider']
            if routing.get('providerType')=='deepseek': params['serviceTier']=None
            params.update(permission_params(d))
            res=call('thread/start',params,start=True)
            d['sessionId']=res['thread']['id']
            # Persist ID before any subsequent RPC; a failed reply must never duplicate this thread.
            update(c,m,sessionId=d['sessionId'],routing=routing)
            call('thread/name/set',dict(threadId=d['sessionId'],name=d['name']))
            turn=dict(threadId=d['sessionId'],cwd=workdir(d),input=[dict(type='text',text=prompt)])
            if routing.get('reasoningEffort'): turn['effort']=routing['reasoningEffort']
            if routing.get('providerType')=='deepseek': turn.update(serviceTier=None,summary='none')
            turn.update(permission_params(d, turn=True))
            res=call('turn/start',turn); d.update(state='running',turnId=res['turn']['id'],startedAt=time.time(),activeSince=time.time())
        # Preserve a concurrently written bind/worktree update.
        d=update(c,m,**{k:v for k,v in d.items() if k not in ('module','worktree','branch')})
        # 记录先落盘再开面板：面板第一次扫描就能看到这个 worker。
        d=sidebar_attach(c,d)
        emit(dict(d,panel=panel_attach(c,d),nextWake=wake_hint(c)))
    except Exception:
        update(c,m,state='launch-uncertain')
        raise

def receipt(c,d):
    p=c/(d['module']+'.receipt.json')
    if not p.exists(): p=inbox(c,d)
    if not p.exists(): return None
    r=json.loads(p.read_text())
    if any(r.get(k)!=v for k,v in [('version',2),('rq',meta(c)['rq']),('module',d['module']),('attempt',d['attempt'])]):
        return dict(result='needs-review',summary='stale or mismatched receipt')
    if r.get('result') not in ('done','failed','blocked') or not r.get('summary'):
        return dict(result='needs-review',summary='invalid receipt')
    if r['result']=='done':
        wt=r.get('worktree') or d.get('worktree')
        if wt and Path(wt).is_dir():
            with contextlib.suppress(RuntimeError): wt=toplevel(wt)
        f=meta(c)
        if not wt or Path(wt).resolve()==Path(f['repo']).resolve():
            return dict(result='needs-review',summary='missing independent worktree')
        if d.get('worktree') and Path(wt).resolve()!=Path(d['worktree']).resolve():
            return dict(result='needs-review',summary='receipt worktree does not match registry')
        if Path(git(wt,'rev-parse','--path-format=absolute','--git-common-dir')).resolve()!=Path(f['commonDir']):
            return dict(result='needs-review',summary='receipt belongs to another repository')
        if run(['git','-C',wt,'merge-base','--is-ancestor',d['baselineCommit'],'HEAD'],check=False).returncode:
            return dict(result='needs-review',summary='worktree lacks prepared integration baseline')
        if not isinstance(r.get('tests'),list) or not r['tests']:
            return dict(result='needs-review',summary='missing verification evidence')
        if any(not isinstance(t,dict) or t.get('result') not in ('passed','not-run') or not t.get('evidence') for t in r['tests']):
            return dict(result='needs-review',summary='invalid or failed verification evidence')
        if d['role'] in ('verify','integ','regression') and any(t.get('result')!='passed' for t in r['tests']):
            return dict(result='needs-review',summary='acceptance has unexecuted verification')
        if d['role'] in ('verify','integ','regression'):
            sha=r.get('commit','')
            if not re.fullmatch('[a-f0-9]{40,64}',sha):
                return dict(result='needs-review',summary='missing tested commit')
            if sha!=git(wt,'rev-parse','HEAD') or sha!=git(f['repo'],'rev-parse',f['integrationBranch']):
                return dict(result='needs-review',summary='acceptance baseline changed; reverify current integration')
        if d['role']=='developer':
            if not any(t.get('result')=='passed' for t in r['tests']):
                return dict(result='needs-review',summary='developer has no passing verification')
            sha=r.get('commit','')
            if not re.fullmatch('[a-f0-9]{40,64}',sha): return dict(result='needs-review',summary='missing commit')
            f=meta(c)
            if run(['git','-C',f['repo'],'merge-base','--is-ancestor',sha,f['integrationBranch']],check=False).returncode:
                return dict(result='needs-review',summary='commit not landed on integration branch')
    return r

def mtime(p):
    try: return Path(p).stat().st_mtime
    except (OSError, TypeError): return 0.0

def last_activity(c,d):
    """Filesystem proof of life. Backend status words keep saying 'working' after a session
    already exited (a worker whose final message lacked `result:` never flips to done), so a
    running claim is only trusted while something it would have touched is still moving.
    The roster record itself is excluded: reply() writes it, which would fake activity."""
    m=d['module']; ts=[mtime(c/(m+x)) for x in ('.alive','.summary.md','.receipt.json','.prompt.md')]
    if d.get('worktree'):
        ts.append(mtime(Path(d['worktree'])/'.git'))
        with contextlib.suppress(Exception):
            ts.append(float(git(d['worktree'],'log','-1','--format=%ct')))
    if d.get('backend')=='claude' and d.get('shortId'):
        j=Path.home()/'.claude'/'jobs'/d['shortId']; ts.append(mtime(j/'state.json'))
        with contextlib.suppress(Exception):
            ts.append(mtime(json.loads((j/'state.json').read_text()).get('linkScanPath')))
    with contextlib.suppress(Exception):
        ts.append(mtime(inbox(c,d)))
    return max(ts)

def stale_check(c,d,out,stale_after):
    """Annotate a running module that has shown no observable activity for too long."""
    launched=out.pop('_launchedAt',0.0)
    if out['state']!='running' or stale_after<=0: return out
    seen=max(last_activity(c,d), float(d.get('activeSince') or d.get('startedAt') or 0), launched)
    out['lastActivityAt']=seen or None
    out['idleFor']=int(time.time()-seen) if seen else None
    if seen and out['idleFor']>stale_after:
        out['attention']='stalled'
        out['attentionHint']=('backend still claims running but nothing moved for '
                              f"{out['idleFor']}s; verify with read/worktree HEAD before replying "
                              '(an exited session accepts no reply)')
    return out

def status_one(c,d,jobs=None,stale_after=0):
    out={k:d.get(k) for k in ('module','backend','transport','sessionId','shortId','state','worktree')}
    try:
        r=receipt(c,d)
        if r: out.update(state=r['result'],receipt=r); return out
        if d['state'] in ('prepared','setting-up','launching','launch-uncertain','stopped'): return out
        if d['backend']=='claude':
            j=next((x for x in (claude_jobs() if jobs is None else jobs) if x.get('id')==d['shortId']),None)
            if j is None: out['state']='unknown'; return out
            st=j.get('state'); out['backendState']=st; out['waitingFor']=j.get('waitingFor')
            out['_launchedAt']=float(j.get('startedAt') or 0)/1000  # ms; floor for staleness
            out['state']={'done':'needs-review','failed':'failed','blocked':'blocked','stopped':'stopped','working':'running'}.get(st,'unknown')
        else:
            t=call('thread/read',dict(threadId=d['sessionId'],includeTurns=True))['thread']
            st=t.get('status',{}); st=st if isinstance(st,dict) else {'type':st}
            flags=str(st.get('activeFlags',[])).lower()
            out['state']='blocked' if any(x in flags for x in ('waiting','approval','input')) else {'active':'running','idle':'needs-review','notLoaded':'needs-review','systemError':'failed'}.get(st.get('type'),'unknown')
            turns=t.get('turns',[])
            if turns and turns[-1].get('status') in ('failed','interrupted'):
                out['state']='failed' if turns[-1]['status']=='failed' else 'stopped'
    except Exception as e:
        out.update(state='unknown',error=type(e).__name__)
    return stale_check(c,d,out,stale_after)

def statuses(c,stale_after=STALE_AFTER):
    ds=[json.loads(p.read_text()) for p in sorted((c/'v2').glob('*.json'))]
    jobs=[]
    if any(d['backend']=='claude' for d in ds):
        try: jobs=claude_jobs()
        except Exception: jobs=[]
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        return list(pool.map(lambda d:status_one(c,d,jobs,stale_after),ds))

def status(a):
    rows=statuses(coord(a.coord),a.stale_after)
    emit({'jobs':rows,'stalled':[r['module'] for r in rows if r.get('attention')=='stalled']})

def read(a):
    c=coord(a.coord); d=load(c,a.module); r=receipt(c,d)
    if r: emit(r); return
    if d['backend']=='claude': print(run([claude_bin(),'logs',d['shortId']]).stdout)
    else: emit(call('thread/read',dict(threadId=d['sessionId'],includeTurns=True)))

def reply(a):
    c=coord(a.coord); d=load(c,a.module); text=Path(a.text_file).read_text()
    if not text.strip(): raise ValueError('empty reply')
    if not d.get('sessionId') and not d.get('shortId'): raise ValueError('session not registered')
    cur=status_one(c,dict(d),stale_after=STALE_AFTER)
    if cur.get('attention')=='stalled' and not a.force:
        raise ValueError(f"module idle for {cur['idleFor']}s while claiming running; the session may "
                         'have ended and would swallow this reply. Check read/worktree HEAD first, '
                         'then use --force or dispatch a fix module instead')
    # Archive old receipts before a new attempt so stale done cannot win over resumed work.
    with lock(c,a.module):
        d=load(c,a.module); old=c/(a.module+'.receipt.json')
        if old.exists(): old.rename(c/'v2'/(a.module+'.receipt-'+d['attempt']+'.json.bak'))
        d['attempt']=uuid.uuid4().hex; d['state']='replying'; atomic(record(c,a.module),d)
    text=f"本轮 attempt={d['attempt']}；回执 attempt 更新为此值。协调目录不可写时，改写临时回执 {inbox(c,d)}，不要复用上一轮临时回执路径。\n"+text
    text+='\n继续前重读任务卡及最新需求、用户用例与契约，以及本次参考资料（如有）；失败如实回执，修复后复测失败项和受影响的完整主流程。\n'
    if d['transport']=='native':
        emit(dict(d,nextAction='send_message_to_thread, then register the same threadId after acceptance',prompt=text)); return
    try:
        if d['backend']=='claude':
            # Public CLI has no live steer command. Narrow, existing compatibility path only.
            with tempfile.NamedTemporaryFile(mode='w',dir=c,suffix='.reply.txt') as f:
                f.write(text); f.flush()
                run([ROOT/'cc-fleet-reply','--short',d['shortId'],'--text-file',f.name])
        else:
            t=call('thread/read',dict(threadId=d['sessionId'],includeTurns=True))['thread']
            turns=t.get('turns',[]); latest=turns[-1] if turns else {}
            params=dict(threadId=d['sessionId'],input=[dict(type='text',text=text)])
            if latest.get('status')=='inProgress':
                params['expectedTurnId']=latest['id']; call('turn/steer',params)
            else:
                call('thread/resume',dict(threadId=d['sessionId'], **permission_params(d)))
                if d.get('worktree'): params['cwd']=workdir(d)
                routing=d.get('routing',{})
                if routing.get('reasoningEffort'): params['effort']=routing['reasoningEffort']
                if routing.get('providerType')=='deepseek': params.update(serviceTier=None,summary='none')
                params.update(permission_params(d, turn=True))
                call('turn/start',params)
        # activeSince anchors staleness: an exited session accepts the reply silently, so if
        # nothing moves after this stamp, status/await surface it instead of claiming running.
        emit(dict(update(c,a.module,state='running',activeSince=time.time()),nextWake=wake_hint(c)))
    except Exception:
        update(c,a.module,state='launch-uncertain'); raise

def stop(a):
    c=coord(a.coord); d=load(c,a.module)
    if d['backend']=='claude': run([claude_bin(),'stop',d['shortId']])
    else:
        t=call('thread/read',dict(threadId=d['sessionId'],includeTurns=True))['thread']
        for turn in reversed(t.get('turns',[])):
            if turn.get('status')=='inProgress':
                call('turn/interrupt',dict(threadId=d['sessionId'],turnId=turn['id'])); break
    emit(update(c,a.module,state='stopped'))

def wait(a):
    c=coord(a.coord); end=time.monotonic()+a.timeout
    while True:
        rows=statuses(c)
        if not rows or all(r['state'] in TERMINAL for r in rows) or any(r['state'] in TERMINAL-{'done'} for r in rows):
            emit({'reason':'attention-or-complete','jobs':rows}); return
        remaining=end-time.monotonic()
        if remaining<=0: emit({'reason':'timeout','jobs':rows}); return
        time.sleep(min(a.interval,remaining))

def wake_hint(c):
    """Emitted on every dispatch/reply: the controller must not end its turn empty-handed."""
    return (f'{ROOT/"cc-fleet"} await --coord {shlex.quote(str(c))}'
            '  # 结束响应前用 run_in_background 挂上，否则没有任何东西会叫醒你')

def pending(rows):
    """Modules actually dispatched and not settled yet; 'prepared' is not dispatched."""
    return [r for r in rows if r['state'] not in TERMINAL and r['state']!='prepared']

def await_(a):
    """Long-lived wake-up for the controlling session: block until a watched module changes
    state, then exit so the host delivers the exit notification back to the main session."""
    if not 60<=a.timeout<=86400: raise ValueError('--timeout must be 60..86400 seconds')
    if not 5<=a.interval<=300: raise ValueError('--interval must be 5..300 seconds')
    c=coord(a.coord)
    targets={x for x in re.split(r'[,\s]+',a.modules or '') if x}
    rows=[r for r in statuses(c,a.stale_after) if not targets or r['module'] in targets]
    base={r['module']:r['state'] for r in pending(rows)}
    if not base:
        emit({'reason':'nothing-to-await','label':a.label,'jobs':rows}); return
    end=time.monotonic()+a.timeout
    while True:
        time.sleep(max(1,min(a.interval,end-time.monotonic())))
        rows=[r for r in statuses(c,a.stale_after) if r['module'] in base]
        seen={r['module'] for r in rows}
        changed=[{'module':r['module'],'from':base[r['module']],'to':r['state'],
                  'summary':(r.get('receipt') or {}).get('summary')}
                 for r in rows if r['state']!=base[r['module']]]
        changed+=[{'module':m,'from':base[m],'to':'gone','summary':None} for m in sorted(base.keys()-seen)]
        stalled=[r['module'] for r in rows if r.get('attention')=='stalled']
        if changed or stalled:
            emit({'reason':'state-changed' if changed else 'stalled','label':a.label,
                  'changed':changed,'stalled':stalled,
                  'stillPending':[r['module'] for r in pending(rows)],'jobs':rows}); return
        if time.monotonic()>=end:
            emit({'reason':'timeout','label':a.label,'waitedSeconds':a.timeout,'jobs':rows}); sys.exit(3)

def collect(a):
    c=coord(a.coord); d=load(c,a.module); r=receipt(c,d)
    if not r or r['result']=='needs-review': raise ValueError('no verified receipt to collect')
    if r.get('worktree') and not d.get('worktree'):
        # receipt() has verified repository identity and prepared baseline for done.
        if r['result']=='done':
            wt=toplevel(r['worktree'])
            update(c,a.module,worktree=wt,cwd=str(Path(wt)/d['subdir']) if d.get('subdir') else wt,branch=git(wt,'rev-parse','--abbrev-ref','HEAD'))
    atomic(c/(d['module']+'.receipt.json'),r)
    emit(dict(result=r['result'],receiptFile=str(c/(d['module']+'.receipt.json'))))


def reconcile(a):
    c=coord(a.coord); d=load(c,a.module)
    if d['backend']=='claude':
        hits=[j for j in claude_jobs() if j.get('name')==d['name'] and Path(j.get('cwd','/')).resolve()==Path(workdir(d)).resolve()]
        if len(hits)!=1: raise ValueError('cannot uniquely reconcile worker; inspect public session list')
        # Finding the record only proves the worker exists. Its real state decides: a session
        # that already ended must not be reported running (replies to it are silently lost).
        j=hits[0]; d=update(c,a.module,shortId=j['id'],sessionId=j.get('sessionId'),state='running')
        emit(update(c,a.module,state=status_one(c,d,[j])['state']))
    else:
        sid=a.session_id or d.get('sessionId')
        if not sid: raise ValueError('supply --session-id from the verified Codex task list')
        t=call('thread/read',dict(threadId=sid,includeTurns=False))['thread']
        if d['transport']!='native' and Path(t.get('cwd','/')).resolve()!=Path(workdir(d)).resolve():
            raise ValueError('thread cwd does not match prepared worktree')
        d=update(c,a.module,sessionId=sid,state='running')
        emit(sidebar_attach(c,update(c,a.module,state=status_one(c,d)['state'])))

def events(a):
    c=coord(a.coord); d=load(c,a.module)
    if d['backend']!='codex' or not d.get('sessionId'): raise ValueError('events requires a registered Codex worker')
    # This is an active controller subscription, never used by a read-only UI panel.
    argv=[os.environ.get('CODEX_APP_CALL_BIN',str(ROOT/'cc-codex-app-call')),
          '--watch-ms',str(a.timeout*1000),'thread/resume','-']
    p=subprocess.run(argv,input=json.dumps(dict(threadId=d['sessionId'])),text=True,timeout=a.timeout+40)
    if p.returncode: raise RuntimeError('event connection interrupted; reconcile through status')


def parser():
    p=argparse.ArgumentParser(description=__doc__); s=p.add_subparsers(dest='cmd',required=True)
    q=s.add_parser('init'); q.add_argument('--cwd',required=True); q.add_argument('--host',choices=HOSTS,required=True)
    q.add_argument('--owner-id'); q.add_argument('--base'); q.add_argument('--rq'); q.set_defaults(fn=init)
    for cmd,fn in [('prepare',prepare),('dispatch',dispatch),('register',register),('bind',bind),('status',status),('read',read),('reply',reply),('stop',stop),('wait',wait),('await',await_),('reconcile',reconcile),('events',events),('collect',collect)]:
        q=s.add_parser(cmd); q.add_argument('--coord',required=True); q.set_defaults(fn=fn)
        if cmd not in ('status','wait','await'): q.add_argument('--module',required=True,type=name)
        if cmd in ('status','await'):
            q.add_argument('--stale-after',type=int,default=STALE_AFTER,metavar='SECONDS',
                           help='flag a running module with no observable activity for this long (0 disables)')
        if cmd=='await':
            q.add_argument('--modules',help='comma/space separated subset; default: everything still running')
            q.add_argument('--label',help='note echoed back on wake-up so the controller regains context')
            q.add_argument('--timeout',type=int,default=1800,metavar='60..86400')
            q.add_argument('--interval',type=int,default=20,metavar='5..300')
        if cmd=='prepare':
            q.add_argument('--permissions',choices=('full','inherit'),default='full',help='worker permissions (default: full); inherit preserves backend configuration')
            q.add_argument('--backend',choices=('codex','claude'),help='default follows host: claude-code -> claude, codex-* -> codex')
            q.add_argument('--transport',default='auto',choices=('auto','native','app-server','claude-bg'))
            q.add_argument('--subdir',help='worker start dir relative to repo root (default: subdir of init --cwd; "" for repo root)')
            q.add_argument('--task',required=True); q.add_argument('--role',default='developer',choices=('developer','scout','verify','integ','regression'))
        if cmd=='dispatch': q.add_argument('--profile',default='worker')
        if cmd=='register':
            g=q.add_mutually_exclusive_group(required=True); g.add_argument('--session-id'); g.add_argument('--client-thread-id'); q.add_argument('--host-id',default='local')
        if cmd=='reconcile': q.add_argument('--session-id')
        if cmd=='events': q.add_argument('--timeout',type=int,choices=range(1,56),default=50,metavar='1..55')
        if cmd=='bind': q.add_argument('--worktree',required=True)
        if cmd=='reply':
            q.add_argument('--text-file',required=True)
            q.add_argument('--force',action='store_true',help='reply even when the module looks stalled')
        if cmd=='wait':
            q.add_argument('--timeout',type=int,choices=range(0,56),default=50,metavar='0..55'); q.add_argument('--interval',type=int,choices=range(2,31),default=5,metavar='2..30')
    return p

if __name__=='__main__':
    try:
        args=parser().parse_args(); args.fn(args)
    except (RuntimeError, ValueError, OSError, KeyError, subprocess.TimeoutExpired) as e:
        print(json.dumps({'error':str(e)},ensure_ascii=False),file=sys.stderr); sys.exit(2)
