#!/usr/bin/env node
// cc-codex-app-call — one-shot JSON-RPC caller for a Codex app-server daemon.

const crypto = require("crypto");
const fs = require("fs");
const path = require("path");
const { spawn, spawnSync } = require("child_process");

let codexBin = process.env.CODEX_CLI_PATH || "";
let shouldStart = false;
let timeoutMs = 30000;
let method = "";
let paramsPath = "";
let lastStartError = "";

function usage() {
  console.error(`cc-codex-app-call [--codex-bin PATH] [--start-app-server|--no-start-app-server] [--timeout-ms N] <method> [params.json|-]

Reads one JSON params object and prints the JSON-RPC result object.
Uses the official \`codex app-server proxy\` for socket discovery/connection,
then performs the control socket's WebSocket and JSON-RPC handshakes.`);
}

for (let i = 2; i < process.argv.length; i++) {
  const a = process.argv[i];
  if (a === "--codex-bin") codexBin = process.argv[++i] || "";
  else if (a === "--start-app-server") shouldStart = true;
  // 上层脚本（面板 / status / read / watch / kill）在"只连已有 app-server"时传的就是这个。
  // 以前这里不认它，于是它被当成 method、真正的 method 又被当成 params 文件，最后报
  // `unknown argument: <params 路径>` 退出 5 —— 表现为一整屏 worker 全变「状态未知」。
  else if (a === "--no-start-app-server") shouldStart = false;
  else if (a === "--timeout-ms") timeoutMs = Number(process.argv[++i] || "30000");
  else if (a === "-h" || a === "--help") { usage(); process.exit(0); }
  else if (!method) method = a;
  else if (!paramsPath) paramsPath = a;
  else { console.error(`unknown argument: ${a}`); usage(); process.exit(5); }
}
if (!method || !Number.isFinite(timeoutMs) || timeoutMs < 1000) { usage(); process.exit(5); }

function isExecutable(file) {
  if (!file) return false;
  try { fs.accessSync(file, fs.constants.X_OK); return true; } catch { return false; }
}

function discoverCodexBin() {
  if (codexBin) return isExecutable(codexBin) ? codexBin : "";
  const home = process.env.HOME || "";
  const bundled = [
    path.join(home, ".local", "bin", "codex"),
    "/Applications/ChatGPT.app/Contents/Resources/codex",
    "/Applications/Codex.app/Contents/Resources/codex",
    path.join(home, ".codex", "plugins", ".plugin-appserver", "codex"),
  ].find(isExecutable);
  if (bundled) return bundled;
  const which = spawnSync("sh", ["-c", "command -v codex"], { encoding: "utf8" });
  if (which.status === 0 && isExecutable(which.stdout.trim())) return which.stdout.trim();
  return "";
}

function readParams() {
  if (!paramsPath) return {};
  const raw = paramsPath === "-" ? fs.readFileSync(0, "utf8") : fs.readFileSync(paramsPath, "utf8");
  return raw.trim() ? JSON.parse(raw) : {};
}

// 启动前先收掉陈旧现场：pid 文件指向已死进程时，`daemon start` 会以为"已经在跑"而空等
// socket 直到超时（2026-08-06 实测）。这里把自愈做在启动路径里，调用方无需关心。
function startServer(bin) {
  let daemon = null;
  try { daemon = require("./lib/codex-daemon.js"); } catch { /* lib 缺失则退回原始行为 */ }
  const home = process.env.CODEX_HOME || path.join(process.env.HOME || "", ".codex");
  const paths = daemon ? daemon.daemonPaths(home) : null;
  if (daemon && paths) {
    try { daemon.reapStaleDaemon(paths); } catch { /* 自愈失败不阻断下面的正常启动尝试 */ }
  }
  const attempts = [["app-server", "daemon", "start"], ["remote-control", "start", "--json"]];
  const errors = [];
  for (const args of attempts) {
    const rc = spawnSync(bin, args, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], timeout: timeoutMs });
    if (rc.status === 0) { lastStartError = ""; return true; }
    errors.push(`${rc.stderr || rc.stdout || rc.error || ""}`.trim());
  }
  // 只保留首行摘要，避免把 daemon 贴出来的整段历史日志（可能是前几天的）当成本次错误。
  lastStartError = errors.filter(Boolean).map((e) => e.split("\n")[0]).join(" | ");
  return false;
}

function clientFrame(payloadValue, opcode = 0x1) {
  const payload = Buffer.isBuffer(payloadValue) ? payloadValue : Buffer.from(JSON.stringify(payloadValue));
  const mask = crypto.randomBytes(4);
  let header;
  if (payload.length < 126) {
    header = Buffer.from([0x80 | opcode, 0x80 | payload.length]);
  } else if (payload.length <= 0xffff) {
    header = Buffer.alloc(4);
    header[0] = 0x80 | opcode; header[1] = 0x80 | 126; header.writeUInt16BE(payload.length, 2);
  } else {
    header = Buffer.alloc(10);
    header[0] = 0x80 | opcode; header[1] = 0x80 | 127; header.writeBigUInt64BE(BigInt(payload.length), 2);
  }
  const masked = Buffer.allocUnsafe(payload.length);
  for (let i = 0; i < payload.length; i++) masked[i] = payload[i] ^ mask[i % 4];
  return Buffer.concat([header, mask, masked]);
}

function callProxy(bin, params) {
  return new Promise((resolve, reject) => {
    const args = ["app-server", "proxy"];
    if (process.env.CODEX_APP_SERVER_SOCK) args.push("--sock", process.env.CODEX_APP_SERVER_SOCK);
    const child = spawn(bin, args, { stdio: ["pipe", "pipe", "pipe"] });
    const wsKey = crypto.randomBytes(16).toString("base64");
    const expectedAccept = crypto.createHash("sha1").update(`${wsKey}258EAFA5-E914-47DA-95CA-C5AB0DC85B11`).digest("base64");
    let buffer = Buffer.alloc(0);
    let stderr = "";
    let handshakeDone = false;
    let settled = false;
    let fragmentOpcode = 0;
    let fragments = [];

    const timer = setTimeout(() => fail(new Error(`timed out after ${timeoutMs}ms waiting for Codex app-server response`)), timeoutMs);
    function cleanup() {
      clearTimeout(timer);
      if (!child.stdin.destroyed) child.stdin.end();
      if (!child.killed) child.kill("SIGTERM");
    }
    function finish(value) { if (!settled) { settled = true; cleanup(); resolve(value); } }
    function fail(error) {
      if (settled) return;
      settled = true; cleanup();
      if (stderr.trim()) error.stderr = stderr.trim();
      reject(error);
    }
    function sendJson(value) { child.stdin.write(clientFrame(value)); }

    function onMessage(payload) {
      let msg;
      try { msg = JSON.parse(payload.toString("utf8")); } catch { return; }
      if (msg.id === 1) {
        if (msg.error) return fail(new Error(`initialize failed: ${JSON.stringify(msg.error)}`));
        sendJson({ method: "initialized", params: {} });
        sendJson({ id: 2, method, params });
      } else if (msg.id === 2) {
        if (msg.error) {
          // 这是服务端**正常应答**里的业务错误（如 thread not found）——连接是好的。
          // 打上标记，避免上层把它误当成"连不上"而去重启/自愈 app-server。
          const rpcError = new Error(JSON.stringify(msg.error));
          rpcError.rpcError = true;
          return fail(rpcError);
        }
        finish(msg.result ?? null);
      }
    }

    function parseFrames() {
      while (buffer.length >= 2) {
        const first = buffer[0], second = buffer[1];
        const fin = !!(first & 0x80), opcode = first & 0x0f, masked = !!(second & 0x80);
        let length = second & 0x7f, offset = 2;
        if (length === 126) {
          if (buffer.length < 4) return;
          length = buffer.readUInt16BE(2); offset = 4;
        } else if (length === 127) {
          if (buffer.length < 10) return;
          const big = buffer.readBigUInt64BE(2);
          if (big > BigInt(Number.MAX_SAFE_INTEGER) || big > BigInt(128 * 1024 * 1024)) return fail(new Error("Codex app-server response frame is too large"));
          length = Number(big); offset = 10;
        }
        let mask;
        if (masked) {
          if (buffer.length < offset + 4) return;
          mask = buffer.subarray(offset, offset + 4); offset += 4;
        }
        if (buffer.length < offset + length) return;
        let payload = buffer.subarray(offset, offset + length);
        buffer = buffer.subarray(offset + length);
        if (masked) {
          const clear = Buffer.allocUnsafe(payload.length);
          for (let i = 0; i < payload.length; i++) clear[i] = payload[i] ^ mask[i % 4];
          payload = clear;
        }
        if (opcode === 0x8) return fail(new Error("Codex app-server closed WebSocket before response"));
        if (opcode === 0x9) { child.stdin.write(clientFrame(payload, 0xA)); continue; }
        if (opcode === 0xA) continue;
        if (opcode === 0x1 || opcode === 0x2) {
          if (fin) onMessage(payload);
          else { fragmentOpcode = opcode; fragments = [payload]; }
        } else if (opcode === 0x0 && fragmentOpcode) {
          fragments.push(payload);
          if (fin) {
            const complete = Buffer.concat(fragments);
            fragmentOpcode = 0; fragments = [];
            onMessage(complete);
          }
        }
      }
    }

    child.stderr.on("data", (chunk) => { if (stderr.length < 1024 * 1024) stderr += chunk.toString("utf8"); });
    child.on("error", fail);
    child.on("exit", (code, signal) => {
      if (!settled) fail(new Error(`codex app-server proxy exited before response (code=${code ?? "-"}, signal=${signal || "-"})`));
    });
    child.stdout.on("data", (chunk) => {
      buffer = Buffer.concat([buffer, chunk]);
      if (!handshakeDone) {
        const end = buffer.indexOf("\r\n\r\n");
        if (end < 0) return;
        const header = buffer.subarray(0, end).toString("utf8");
        buffer = buffer.subarray(end + 4);
        if (!/^HTTP\/1\.1 101\b/i.test(header)) return fail(new Error(`WebSocket upgrade failed: ${header.split(/\r?\n/)[0] || header}`));
        const accept = header.match(/^Sec-WebSocket-Accept:\s*(.+)$/im)?.[1]?.trim() || "";
        if (accept && accept !== expectedAccept) return fail(new Error("WebSocket upgrade returned an invalid accept key"));
        handshakeDone = true;
        sendJson({
          id: 1,
          method: "initialize",
          params: {
            clientInfo: { name: "multi-session-dev", title: "multi-session-dev", version: "2" },
            capabilities: {
              experimentalApi: true,
              optOutNotificationMethods: ["agent/message/delta", "thread/status/changed", "thread/tokenUsage/updated", "turn/diff/updated"],
            },
          },
        });
      }
      parseFrames();
    });
    child.stdin.write(
      `GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n` +
      `Sec-WebSocket-Key: ${wsKey}\r\nSec-WebSocket-Version: 13\r\n\r\n`
    );
  });
}

function wait(ms) { return new Promise((resolve) => setTimeout(resolve, ms)); }

(async () => {
  const bin = discoverCodexBin();
  if (!bin) { console.error("cannot find an executable Codex CLI; set CODEX_CLI_PATH or pass --codex-bin"); process.exit(8); }
  let params;
  try { params = readParams(); } catch (e) { console.error(`cannot read JSON params: ${e.message || e}`); process.exit(5); }
  try {
    const result = await callProxy(bin, params);
    process.stdout.write(`${JSON.stringify(result)}\n`);
  } catch (firstError) {
    // 服务端已经正常应答、只是业务上失败 → 直接把错误交出去，不要走启动/自愈路径。
    if (firstError.rpcError) {
      console.error(firstError.message);
      process.exit(9);
    }
    if (shouldStart || process.env.CODEX_APP_START === "1") {
      startServer(bin);
      let lastError = firstError;
      for (const delayMs of [0, 250, 750, 1500]) {
        if (delayMs) await wait(delayMs);
        try {
          const result = await callProxy(bin, params);
          process.stdout.write(`${JSON.stringify(result)}\n`);
          return;
        } catch (error) { lastError = error; }
      }
      console.error(lastError.message);
      if (lastError.stderr) console.error(lastError.stderr);
      if (lastStartError) console.error(lastStartError);
      process.exit(9);
    }
    console.error(firstError.message);
    if (firstError.stderr) console.error(firstError.stderr);
    console.error("Codex app-server is not reachable. Re-run with --start-app-server or start `codex remote-control start --json`.");
    process.exit(9);
  }
})();
