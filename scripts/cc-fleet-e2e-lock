#!/usr/bin/env bash
# cc-fleet-e2e-lock — 同一 RQ 下「跑 e2e 的 worker 一次只放一个」的串行锁（worker 在跑 e2e 前后调用）。
#
# 为什么需要它：多个 worker 并行跑 e2e 会撞共享 dev DB + shared/dist，实测假失败从 6 条炸到 44 条，
#   然后各自回修一轮纯烧 token。主 session 派发时已尽量一次只放一个跑 e2e 的 worker，本脚本是机械兜底：
#   worker 跑 e2e 之前先抢锁，抢不到就等；跑完（不论过没过）立刻放锁。
#
# 实现：`mkdir <COORD>/e2e.lock` 原子抢占（目录存在即失败），锁内写 owner 文件记模块名 + 时间。
#   过期抢占：持有超过 --stale 秒（默认 5400 = 90 分钟，覆盖 70 分钟全量 e2e）视为持有者已死，强制回收。
#
# 用法（在 worker 内）：
#   cc-fleet-e2e-lock acquire <COORD_DIR> <module> [--wait SEC] [--stale SEC]   # 抢锁；默认最多等 7200s
#   cc-fleet-e2e-lock release <COORD_DIR> <module>                              # 放锁（只放自己持有的）
#   cc-fleet-e2e-lock status  <COORD_DIR>                                       # 看谁持有
#
# 退出码：0 成功 / 1 等锁超时 / 2 用法错 / 3 release 时锁不是自己的（不放，避免误放别人的锁）
#
# 与心跳的关系：跑长 e2e 时另按 preamble 定期 `touch <COORD_DIR>/<module>.alive`，本脚本不替你做。

set -uo pipefail

usage() {
  cat >&2 <<'EOF'
用法: cc-fleet-e2e-lock acquire <COORD_DIR> <module> [--wait SEC] [--stale SEC]
      cc-fleet-e2e-lock release <COORD_DIR> <module>
      cc-fleet-e2e-lock status  <COORD_DIR>
EOF
}

CMD="${1:-}"; shift || true
COORD="${1:-}"; shift || true
MODULE=""
WAIT="${FLEET_E2E_LOCK_WAIT:-7200}"
STALE="${FLEET_E2E_LOCK_STALE:-5400}"
POLL="${FLEET_E2E_LOCK_POLL:-20}"

case "${CMD}" in
  acquire|release) MODULE="${1:-}"; shift || true ;;
  status) ;;
  *) usage; exit 2 ;;
esac
while [[ $# -gt 0 ]]; do
  case "$1" in
    --wait)  WAIT="${2:-}"; shift 2 || { usage; exit 2; } ;;
    --stale) STALE="${2:-}"; shift 2 || { usage; exit 2; } ;;
    --poll)  POLL="${2:-}"; shift 2 || { usage; exit 2; } ;;
    *) echo "未知参数: $1" >&2; usage; exit 2 ;;
  esac
done
[[ -n "${COORD}" && -d "${COORD}" ]] || { echo "❌ COORD_DIR 不存在: '${COORD}'" >&2; usage; exit 2; }
if [[ "${CMD}" != "status" ]]; then
  [[ -n "${MODULE}" ]] || { usage; exit 2; }
fi

LOCK="${COORD}/e2e.lock"
OWNER_FILE="${LOCK}/owner"

now() { date +%s; }
lock_owner() { [[ -f "${OWNER_FILE}" ]] && head -1 "${OWNER_FILE}" | cut -d' ' -f1 || echo "?"; }
lock_since() { [[ -f "${OWNER_FILE}" ]] && head -1 "${OWNER_FILE}" | cut -d' ' -f2 || echo 0; }
lock_age() { local s; s="$(lock_since)"; [[ "$s" =~ ^[0-9]+$ ]] || s=0; echo $(( $(now) - s )); }

try_take() {
  if mkdir "${LOCK}" 2>/dev/null; then
    printf '%s %s\n' "${MODULE}" "$(now)" > "${OWNER_FILE}"
    return 0
  fi
  return 1
}

case "${CMD}" in
  status)
    if [[ -d "${LOCK}" ]]; then
      echo "🔒 e2e 锁被 $(lock_owner) 持有 $(lock_age)s（${LOCK}）"
    else
      echo "🔓 e2e 锁空闲（${LOCK}）"
    fi
    exit 0 ;;

  acquire)
    deadline=$(( $(now) + WAIT ))
    while :; do
      try_take && { echo "✓ ${MODULE} 已持有 e2e 锁（${LOCK}）"; exit 0; }
      # 已是自己持有（重入）→ 视为成功
      if [[ "$(lock_owner)" == "${MODULE}" ]]; then echo "✓ ${MODULE} 已持有 e2e 锁（重入）"; exit 0; fi
      # 过期抢占：持有者早该跑完，多半已死
      if [[ "$(lock_age)" -ge "${STALE}" ]]; then
        echo "⚠ e2e 锁被 $(lock_owner) 持有 $(lock_age)s ≥ stale=${STALE}，判持有者已死，强制回收" >&2
        rm -rf "${LOCK}"
        continue
      fi
      if [[ "$(now)" -ge "$deadline" ]]; then
        echo "❌ 等 e2e 锁超时（${WAIT}s），仍被 $(lock_owner) 持有 $(lock_age)s。别硬跑：写进回执「需主 session 裁决」。" >&2
        exit 1
      fi
      sleep "${POLL}"
    done ;;

  release)
    [[ -d "${LOCK}" ]] || { echo "✓ e2e 锁本就空闲"; exit 0; }
    if [[ "$(lock_owner)" != "${MODULE}" ]]; then
      echo "❌ e2e 锁由 $(lock_owner) 持有，不是 ${MODULE}，不放（避免误放别人的锁）" >&2
      exit 3
    fi
    rm -rf "${LOCK}"
    echo "✓ ${MODULE} 已释放 e2e 锁"
    exit 0 ;;
esac
