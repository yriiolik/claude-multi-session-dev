#!/usr/bin/env python3
"""Cross-client fleet controller. Python stdlib; public CLIs, persistent receipts.
Native Codex App operations are performed by the host, then registered here.
"""
import argparse, concurrent.futures, contextlib, datetime, fcntl, glob, json, os, socket
from pathlib import Path
import re, shlex, subprocess, sys, tempfile, time, uuid

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT/'lib'))
import session_ctx  # 上下文「热且小」才复用原会话，否则换新会话靠交接文件续上
HOSTS =('codex-app', 'codex-cli', 'claude-code')
TERMINAL = {'done', 'failed', 'blocked', 'stopped', 'needs-review', 'unknown', 'launch-uncertain'}
STALE_AFTER = int(os.environ.get('CC_FLEET_STALE_AFTER', '600'))  # running with no observable activity
# Claude worker 这一轮已停、无后台任务、state.json 超过该秒数未更新 → 判定会话已结束（末条漏打 result: 也算）。
IDLE_GRACE = int(os.environ.get('CC_FLEET_IDLE_GRACE', '60'))
# reply/复活后 state.json 刷新前的宽限：期间以本轮 activeSince 为准，仍视为 running。
REPLY_GRACE = int(os.environ.get('CC_FLEET_REPLY_GRACE', '180'))
JOBS_DIR = Path(os.environ.get('CLAUDE_JOBS_DIR', str(Path.home()/'.claude'/'jobs')))
CLAUDE_STATES = {'done':'needs-review','failed':'failed','blocked':'blocked','stopped':'stopped','working':'running'}
# 未派发/不派发的名册状态：prepared=待主端派发；queued=依赖满足后由编排器自动派发；self=主 session 自己开发的 worktree。
NOT_LAUNCHED = ('prepared','queued','self','setting-up','launching','launch-uncertain','stopped')
# 同一模块的人工 reply（纠偏/回修）超过该轮数须 --force：反复返工说明需求/契约/环境有问题，要先停下核对。
MAX_REPLIES = int(os.environ.get('CC_FLEET_MAX_REPLIES', '3'))
ACCEPT_ROLES = ('verify','integ','regression')
SETTLED = ('done','failed','blocked','needs-review')  # 这一轮已结束、可以接收下一条消息
# Codex goal：app-server worker 的交付标准挂成线程目标，本轮提前停下时 Codex 自动续跑，直到模型自判完成/受阻或预算耗尽。
# 关闭：CC_FLEET_CODEX_GOAL=0 或 fleet.json codexGoal=false；预算：CC_FLEET_CODEX_GOAL_BUDGET 或 fleet.json codexGoalBudget（token，0=不限）。
GOAL_GRACE = int(os.environ.get('CC_FLEET_GOAL_GRACE', '90'))  # 上一轮收尾后等自动续跑开轮的宽限
GOAL_STATES = {'blocked':'blocked','usageLimited':'blocked','budgetLimited':'needs-review','paused':'needs-review','complete':'needs-review'}
GOAL_HINTS = {'blocked':'worker 判定同一阻塞反复出现并把目标标为 blocked，先 read 看阻塞原因',
              'usageLimited':'账号用量上限，目标暂停；额度恢复后 reply 续上',
              'budgetLimited':'目标 token 预算耗尽，自动续跑已停；read 核对进度后 reply（会重新激活目标）',
              'paused':'目标被暂停（多半是用户在 Codex App 里接手了这个会话），先 read 再决定',
              'complete':'worker 自判目标完成但没有本轮回执，先 read 核实'}

def run(argv, cwd=None, timeout=45, check=True, input=None, env=None):
    p = subprocess.run([str(x) for x in argv], cwd=cwd, input=input, text=True, env=env,
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    if check and p.returncode:
        # CLI errors may contain authentication configuration; don't dump raw logs.
        raise RuntimeError(f'{Path(str(argv[0])).name} {argv[1] if len(argv)>1 else ""} failed (exit {p.returncode})')
    return p

def git(cwd, *args):
    return run(['git', '-C', str(cwd), *args]).stdout.strip()

def emit(obj):
    print(json.dumps(obj, ensure_ascii=False, indent=2), flush=True)

def atomic(path, obj):
    path = Path(path); path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            json.dump(obj, f, ensure_ascii=False, indent=2); f.write('\n')
            f.flush(); os.fsync(f.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)

def name(value):
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,95}', value):
        raise ValueError('RQ/module must use letters, digits, dot, underscore or hyphen (max 96)')
    return value

def coord(value):
    p = Path(value).expanduser().resolve()
    if not (p/'fleet.json').is_file(): raise ValueError('not a v2 coordination directory')
    return p

def inbox(c,d):
    f=meta(c)
    root=Path(f.get('inboxRoot',str(Path(tempfile.gettempdir())/'fleet-v2-inbox'/f['rq'])))
    return root/(d['module']+'-'+d['attempt']+'.receipt.json')

def meta(c): return json.loads((c/'fleet.json').read_text())
def record(c, m): return c/'v2'/f'{name(m)}.json'
def load(c, m): return json.loads(record(c,m).read_text())

@contextlib.contextmanager
def lock(c, m):
    p = c/'v2'; p.mkdir(exist_ok=True)
    with (p/f'.{name(m)}.lock').open('a') as f:
        fcntl.flock(f, fcntl.LOCK_EX); yield

def update(c, m, **fields):
    with lock(c,m):
        d=load(c,m); d.update(fields); atomic(record(c,m),d); return d

def call(method, params, start=False, timeout=35):
    argv=[os.environ.get('CODEX_APP_CALL_BIN', str(ROOT/'cc-codex-app-call'))]
    if start: argv+=['--start-app-server']
    argv+=['--timeout-ms', str(max(1000, (timeout-2)*1000)), method, '-']
    return json.loads(run(argv, input=json.dumps(params), timeout=timeout).stdout)

def permission_params(d, turn=False):
    # Explicit user preference for fleet workers; legacy records adopt the new default.
    if d.get('permissions', 'full') == 'inherit': return {}
    return dict(approvalPolicy='never', **({'sandboxPolicy': {'type': 'dangerFullAccess'}}
                                         if turn else {'sandbox': 'danger-full-access'}))

def default_backend(host):
    # 未指定 --backend 时跟随主端（用户 2026-09-11 纠正）：Claude 主端派 Claude，Codex 主端派 Codex。
    return 'claude' if host=='claude-code' else 'codex'

def clean_subdir(s):
    s=(s or '').strip().strip('/')
    if s in ('','.'): return ''
    if Path(s).is_absolute() or '..' in Path(s).parts: raise ValueError('subdir must be relative inside the repository')
    return Path(s).as_posix()

def toplevel(p):
    return str(Path(git(Path(p).resolve(),'rev-parse','--show-toplevel')).resolve())

def worktree_path(fleet, m):
    # 不放 .git 内：Vite 等默认拒绝服务 **/.git/** 的文件；放仓库 .claude/worktrees 下沿用 Claude 目录信任。
    return Path(fleet['repo'])/'.claude'/'worktrees'/f"fleet-{fleet['rq']}-{m}"

def exclude_worktrees(fleet):
    if run(['git','-C',fleet['repo'],'check-ignore','-q','.claude/worktrees/probe'],check=False).returncode==0: return
    ex=Path(fleet['commonDir'])/'info'/'exclude'; ex.parent.mkdir(parents=True,exist_ok=True)
    with ex.open('a') as f: f.write('\n.claude/worktrees/\n')

def route(fleet):
    # Claude 主端显式派 Codex 时的固定路由；never send an OpenAI model to a third-party provider.
    if fleet['owner']['host']=='claude-code':
        return dict(active='claude-main-gpt6-low',mode='fixed',model='gpt-6-astra',
                    modelProvider='openai',reasoningEffort='low',providerType='openai')
    return json.loads(run([ROOT/'cc-codex-session-config','resolve','--json']).stdout)

def init(a):
    repo=Path(git(a.cwd,'rev-parse','--show-toplevel')).resolve()
    common=Path(git(repo,'rev-parse','--path-format=absolute','--git-common-dir')).resolve()
    base=a.base or git(repo,'symbolic-ref','--short','HEAD')
    sha=git(repo,'rev-parse','--verify',base+'^{commit}')
    # 主 session 所在子目录（多项目仓库的子项目）；worker 默认在自己 worktree 的同一子目录启动，才能加载该目录规则。
    try: subdir=clean_subdir(Path(a.cwd).resolve().relative_to(repo).as_posix())
    except ValueError: subdir=''
    rq=name(a.rq or ('RQ-'+datetime.datetime.now().strftime('%Y%m%d-%H%M%S')+'-'+uuid.uuid4().hex[:8]))
    c=common/'fleet'/rq
    c.mkdir(parents=True,exist_ok=False)
    try: git(repo,'branch','fleet/'+rq,sha)
    except Exception:
        c.rmdir(); raise
    # Claude Code 注入的是 CLAUDE_CODE_SESSION_ID；只认 CLAUDE_SESSION_ID 会让主 session 身份一直取不到、面板判不了主 session 是否已退出
    owner_id=a.owner_id or (os.environ.get('CODEX_THREAD_ID') if a.host.startswith('codex') else (os.environ.get('CLAUDE_CODE_SESSION_ID') or os.environ.get('CLAUDE_SESSION_ID')))
    identity_source='session' if owner_id else 'generated-controller'
    owner_id=owner_id or ('controller-'+uuid.uuid4().hex)
    d=dict(version=2,rq=rq,repo=str(repo),commonDir=str(common),subdir=subdir,base=base,baseCommit=sha,
           integrationBranch='fleet/'+rq,inboxRoot=str((Path(tempfile.gettempdir())/'fleet-v2-inbox'/rq).resolve()),owner={'host':a.host,'id':owner_id,'identitySource':identity_source},createdAt=time.time())
    atomic(c/'fleet.json',d); (c/'base.ref').write_text(base+'\n')
    # 建组即登记面板：任何后端/传输（含 native）、无论本 session 开不开分屏，全局面板都看得到这个任务组。
    panel_register(c,rq)
    emit(dict(d,coord=str(c),uncommittedChangesExcluded=bool(git(repo,'status','--porcelain'))))

def handoff_path(c,d,fallback=False):
    if fallback: return inbox(c,d).parent/(d['module']+'.handoff.md')
    return c/(d['module']+'.handoff.md')

def preamble(c,d):
    # 只放本任务独有的数据与不可推导的边界；项目规则交给客户端按启动目录自动加载的 CLAUDE.md / AGENTS.md。
    fleet=meta(c); role=d['role']; rq=fleet['rq']
    if d['transport']=='native':
        where=(f"在 App 新建的隔离 worktree 内工作；若它尚未基于集成分支，确认工作树干净后 git switch --detach {fleet['integrationBranch']}"
               +(f"，再 cd {d['subdir']}" if d.get('subdir') else '')+'。')
    else:
        where=f"工作目录 {d['cwd']}（worktree 根 {d['worktree']}），不在主 checkout 改文件。"
    if d.get('permissions')=='inherit': where+='Git 元数据写入需审批时用宿主审批工具申请，无通道则报 blocked。'
    if role=='developer':
        duty=f"developer：只在范围内开发，按用例自测并留证据，提交后运行 {shlex.quote(str(ROOT/'cc-fleet-land'))} {rq}。"
    else:
        duty=f'{role}：不改业务代码、不提交合回。'
        if d.get('phase')=='author':
            duty+=('当前是【编写阶段】：开发与你并行进行，实现尚未合入。只依据原始需求、用户用例与契约编写页面验收脚本、'
                   '造数夹具和逐例检查清单（选择器/接口按契约与现有页面约定，未定的记为待执行时确认），在本 worktree 提交，不 land；'
                   '不要等待实现、不跑依赖新功能的验收。完成即回执 done（tests 可 not-run，evidence 写 spec 路径与用例映射）。'
                   '依赖合入后编排器会自动发来「执行阶段」消息，届时再在最新集成基线上执行。')
        elif role in ('verify','integ'):
            duty+=('在含全部改动的集成版本上用真实页面先连续跑核心主流程，再逐项验证适用分支/异常、幂等和事务；'
                   'API/单测或 mock 自家业务 API 不能替代页面验收，纯接口/CLI 需求记录不适用理由；'
                   '逐例记录操作、结果、截图或 trace 路径、基线 SHA/环境。')
        if role=='regression':
            duty+=('本 RQ 的成批 e2e 只由你这一张卡跑一次（开发 worker 各自只跑了改动相关的几条）：'
                   '在集成基线上持独占 e2e 锁，按任务卡给定的回归集合一次跑完，结果落盘文件；'
                   '任务卡没写「全量」就不要自行跑项目全量入口，失败逐条回报现象指向哪个模块。')
    # 测试范围纪律：worker 各跑一遍全量是多 session 最大的隐性成本（几十分钟 + 吃满 CPU + e2e 锁下互相排队）。
    cq=shlex.quote(str(c)); mq=d['module']
    scope_bin=shlex.quote(str(ROOT/'cc-fleet-e2e-scope')); lock_bin=shlex.quote(str(ROOT/'cc-fleet-e2e-lock'))
    if role=='scout': testing=''
    elif role=='regression':
        testing=(f'跑前 {lock_bin} acquire {cq} {mq} --mode exclusive、跑完 release；按任务卡给定的回归集合一次跑完并落盘结果，'
                 f'任务卡没写「全量」就不跑项目全量入口。\n')
    else:
        testing=(f'测试只跑本卡改动相关的最小集合（范围见任务卡「E2E 范围」，缺则 {scope_bin} suggest 推导后裁剪；'
                 f'≤6 spec 且 ≤15 分钟，超预算的写进 risks 交回归卡）；⛔ 不跑项目全量 e2e 入口，'
                 f'跨模块回归由主 session 统一派 regression 卡跑一次。跑 e2e 前后 {lock_bin} acquire/release {cq} {mq}，'
                 f'跑完 {scope_bin} record {cq} {mq} <spec…> 登记范围。\n')
    return f'''⟦FLEET-WORKER⟧ rq={rq} module={d['module']} role={role} backend={d['backend']}
你是独立 worker：不加载 multi-session-dev 编排技能、不再派发 worker，只做任务卡授权的范围。主 session：{fleet['owner']['id']}。
协调目录 {c}；任务身份 {d['attempt']}（回执 attempt 须一致）；集成分支 {fleet['integrationBranch']}。
{where}
开工先运行 {shlex.quote(str(ROOT/'cc-fleet'))} bind --coord {shlex.quote(str(c))} --module {d['module']} --worktree "$PWD"；协调目录只读致失败时不阻断，回执里写真实 worktree。
规则以启动目录适用的 CLAUDE.md / AGENTS.md 为准（客户端已按目录自动加载）；AGENTS.md 只是指针时按指针读取对应文件；任务涉及其他子项目时先读该子目录的规则文件。
{duty}
{testing}禁止 reset --hard、推远端、合回共享分支、删除或清理 worktree；范围/权限问题写 blocked 回执并说明所需输入。
开工及压缩恢复后先读任务卡引用的原始需求、用户用例、契约（及本次参考资料）；实现/验收卡缺用例或必需输入时报告缺项，不自行缩减需求。
失败如实写 tests.result=failed 且 result=failed/blocked，不藏进 risks、不改 not-run、不删断言；只做了计划不能报 done。
每轮完成先覆写交接文件 {handoff_path(c,d)}（≤80 行：环境与坑、结论及 SHA、未关闭项），再把下列 JSON 原子写到 {c/(d['module']+'.receipt.json')}（tmp+rename）；该目录不可写就 mkdir -p 后改写 {inbox(c,d)} 及同目录交接文件；最后回复同一 JSON。
{{"version":2,"rq":"{rq}","module":"{d['module']}","attempt":"{d['attempt']}","worktree":"worktree 根绝对路径","result":"done|failed|blocked","summary":"真实完成内容/问题","commit":"开发提交或实际验收的完整 SHA，scout 可空","tests":[{{"command":"实际执行的检查","result":"passed|failed|blocked|not-run","evidence":"结果文件路径或简短输出"}}],"risks":[],"needsInput":[]}}
\n任务卡：\n'''

def prepare(a):
    c=coord(a.coord); fleet=meta(c); m=name(a.module)
    a.backend=a.backend or default_backend(fleet['owner']['host'])
    transport=a.transport
    if transport=='auto': transport='native' if fleet['owner']['host']=='codex-app' and a.backend=='codex' and a.permissions=='inherit' else ('app-server' if a.backend=='codex' else 'claude-bg')
    if (a.backend=='claude' and transport!='claude-bg') or (a.backend=='codex' and transport not in ('native','app-server')):
        raise ValueError('backend/transport mismatch')
    if transport=='native' and fleet['owner']['host']!='codex-app': raise ValueError('native requires a Codex App main session')
    if transport=='native' and a.permissions=='full': raise ValueError('native cannot set full permissions; use app-server or --permissions inherit')
    subdir=clean_subdir(fleet.get('subdir','') if a.subdir is None else a.subdir)
    if subdir and run(['git','-C',fleet['repo'],'cat-file','-e',f"{fleet['integrationBranch']}:{subdir}"],check=False).returncode:
        raise ValueError(f'subdir not found on integration branch: {subdir}')
    after=[name(x) for x in re.split(r'[,\s]+',a.after or '') if x]
    if a.self_dev:
        if a.role!='developer' or after: raise ValueError('--self is a developer worktree for the main session; no --after')
        transport='self'
    if a.phase and a.role not in ('verify','integ'): raise ValueError('--phase only applies to verify/integ')
    if transport=='native' and after: raise ValueError('native tasks are created by the host; --after needs a CLI transport')
    for x in after:
        if x==m or not record(c,x).exists(): raise ValueError(f'--after module not registered: {x}')
    task=Path(a.task).resolve().read_text() if a.task else ''
    if not task.strip() and not a.self_dev: raise ValueError('empty task card')
    with lock(c,m):
        if record(c,m).exists(): raise ValueError('module already registered; use reply, or a new fix module')
        d=dict(version=2,module=m,backend=a.backend,transport=transport,role=a.role,permissions=a.permissions,
               attempt=uuid.uuid4().hex,state='self' if a.self_dev else ('queued' if after else 'prepared'),
               name=f'↳{m}@{fleet["rq"]}',createdAt=time.time(),after=after,phase=a.phase,profile=a.profile,replies=0,
               sessionId=None,shortId=None,worktree=None,branch=None,subdir=subdir,cwd=None,
               baselineCommit=git(fleet['repo'],'rev-parse',fleet['integrationBranch']))
        if transport!='native':
            wt=worktree_path(fleet,m); exclude_worktrees(fleet)
            branch=f'fleet-worker/{fleet["rq"]}/{m}'
            git(fleet['repo'],'worktree','add','-b',branch,str(wt),fleet['integrationBranch'])
            d.update(worktree=str(wt),branch=branch,cwd=str(wt/subdir) if subdir else str(wt))
        atomic(record(c,m),d)
        if a.self_dev:
            emit(dict(d,coord=str(c),integrationBranch=fleet['integrationBranch'],
                      next=f"主 session 在 {d['cwd']} 开发、提交后运行 {ROOT/'cc-fleet-land'} {fleet['rq']}；独立验收照常派 verify 卡")); return
        prompt=preamble(c,d)+task
        (c/f'{m}.prompt.md').write_text(prompt)
    emit(dict(d,coord=str(c),promptFile=str(c/f'{m}.prompt.md'),integrationBranch=fleet['integrationBranch']))

def bind(a):
    # worker 在子项目目录启动，$PWD 可能是子目录；一律规整到 worktree 根。
    c=coord(a.coord); f=meta(c); wt=Path(toplevel(a.worktree))
    if wt==Path(f['repo']).resolve(): raise ValueError('worker must not use primary checkout')
    if Path(git(wt,'rev-parse','--path-format=absolute','--git-common-dir')).resolve()!=Path(f['commonDir']): raise ValueError('wrong repository')
    # Require the full current integration baseline, not simply a branch with a familiar name.
    d=load(c,a.module)
    if run(['git','-C',wt,'merge-base','--is-ancestor',d['baselineCommit'],'HEAD'],check=False).returncode:
        raise ValueError('worker does not contain integration baseline')
    if d.get('worktree') and Path(d['worktree']).resolve()!=wt: raise ValueError('worktree already bound elsewhere')
    branch=git(wt,'rev-parse','--abbrev-ref','HEAD')
    if d.get('worktree')==str(wt) and d.get('branch')==branch:
        emit(d); return
    emit(update(c,a.module,worktree=str(wt),branch=branch))

def register(a):
    c=coord(a.coord); d=load(c,a.module)
    if d['transport']!='native': raise ValueError('register is for native App tasks')
    # clientThreadId represents pending setup, never a callable threadId.
    if a.client_thread_id:
        emit(update(c,a.module,clientThreadId=a.client_thread_id,state='setting-up')); return
    if d.get('sessionId') and d['sessionId']!=a.session_id: raise ValueError('task already has a different threadId')
    emit(sidebar_attach(c,update(c,a.module,sessionId=a.session_id,hostId=a.host_id,state='running',clientThreadId=None)))

def workdir(d): return d.get('cwd') or d['worktree']
def claude_bin(): return os.environ.get('CLAUDE_CLI_PATH','claude')
def claude_jobs():
    obj=json.loads(run([claude_bin(),'agents','--json','--all']).stdout)
    if not isinstance(obj,list): raise ValueError('unsupported Claude agents JSON schema')
    return obj

def goal_enabled(c, d):
    if d.get('backend')!='codex' or d.get('transport')!='app-server' or not d.get('sessionId'): return False
    return os.environ.get('CC_FLEET_CODEX_GOAL','1')!='0' and meta(c).get('codexGoal',True) is not False

def goal_attach(c, m, d):
    """turn/start/steer 之后挂目标：先挂会让空闲线程自己按短目标开跑一轮，与任务卡那轮抢跑。挂不上不影响派发。"""
    if not goal_enabled(c,d): return d
    budget=int(os.environ.get('CC_FLEET_CODEX_GOAL_BUDGET') or meta(c).get('codexGoalBudget') or 0)
    obj=(f"完成 fleet 任务卡 {c/(m+'.prompt.md')}（模块 {m}，attempt {d['attempt']}）及本线程后续消息：按卡开发/执行、自测，"
         f"需要合入的 commit 用 cc-fleet-land 合入集成分支，再写好 attempt 为 {d['attempt']} 的回执 {c/(m+'.receipt.json')}"
         f"（协调目录不可写时写临时回执 {inbox(c,d)}）。回执写好才算完成，随即把目标标为完成；"
         '按规则判定为 blocked 时先写 result=blocked 的回执再标 blocked。')
    try:
        g=call('thread/goal/set',dict(threadId=d['sessionId'],objective=obj,status='active',origin='user',
                                      **({'tokenBudget':budget} if budget>0 else {})))['goal']
        res=dict(state='attached',attempt=d['attempt'],tokenBudget=g.get('tokenBudget'))
    except Exception as e:
        res=dict(state='unavailable',reason=f'{type(e).__name__}: {e}'[:200])
    return update(c,m,goal=res)

def goal_pause(c, d):
    """停/换会话时暂停目标：active 目标会在 resume、daemon 重启后恢复续跑，被停的 worker 不能自己复活。"""
    if goal_enabled(c,d) and (d.get('goal') or {}).get('state')=='attached':
        with contextlib.suppress(Exception): call('thread/goal/set',dict(threadId=d['sessionId'],status='paused',origin='user'))

def goal_close(c, d, r):
    """收到本轮有效回执即关目标：worker 写完回执常不标完成，放着会再续跑一轮、整段上下文重读一遍。每个 attempt 只关一次。"""
    g=d.get('goal') or {}
    if not goal_enabled(c,d) or g.get('state')!='attached' or g.get('closed')==d['attempt']: return
    with contextlib.suppress(Exception):
        call('thread/goal/set',dict(threadId=d['sessionId'],status='complete' if r.get('result')=='done' else 'paused',origin='user'))
        update(c,d['module'],goal=dict(g,closed=d['attempt']))

def goal_status(c, d, out, turns):
    """用目标状态细化 Codex 运行态；回执仍是唯一交付凭据，目标 complete 也只到 needs-review。"""
    if not goal_enabled(c,d) or (d.get('goal') or {}).get('state')!='attached': return
    with contextlib.suppress(Exception):
        g=call('thread/goal/get',dict(threadId=d['sessionId'])).get('goal')
        if not g: return
        out['goal']={k:g.get(k) for k in ('status','tokensUsed','tokenBudget','timeUsedSeconds')}
        gs=g.get('status'); last=turns[-1] if turns else {}
        if out['state']!='needs-review': return  # 还在跑或已失败/中断，目标状态只作展示
        if gs=='active' and last.get('status')=='completed' and time.time()-float(last.get('completedAt') or 0)<GOAL_GRACE:
            out['state']='running'  # 上一轮刚收尾，目标会自动续跑下一轮
        elif gs in GOAL_STATES:
            out['state']=GOAL_STATES[gs]; out['goalHint']=GOAL_HINTS[gs]

def sidebar_attach(c, d):
    """Use server-owned sections, never private desktop UI state or worker prompts."""
    if d.get('backend') != 'codex' or not d.get('sessionId'): return d
    if d.get('hostId', 'local') != 'local':
        result = dict(state='pending', reason='remote host requires its own app-server connection')
    else:
        try:
            sections=[]; cursor=None; seen=set()
            while True:
                page=call('threadSection/list', dict(limit=100, **({'cursor':cursor} if cursor else {})))
                sections.extend(page['data']); cursor=page.get('nextCursor')
                if not cursor: break
                if cursor in seen: raise ValueError('repeated section cursor')
                seen.add(cursor)
            matches=[x for x in sections if x.get('name')=='子 session']
            if len(matches)!=1: raise ValueError('expected one existing 子 session section')
            section_id=matches[0]['id']
            previous=d.get('sidebar', {})
            if previous.get('state')=='placed' and previous.get('sectionId')==section_id:
                return d
            call('thread/section/move', dict(threadId=d['sessionId'],sectionId=section_id))
            result=dict(state='placed',sectionId=section_id)
        except Exception as e:
            result=dict(state='pending',reason=str(e))
    return update(c,d['module'],sidebar=result)

def panel_register(c, rq, no_owner=False):
    """登记面板全局注册表。与分屏开关无关、总是做：面板是全机一块，别的主 session 已开着的面板要看得到本任务组；
    CC_FLEET_PANEL=0 只表示「本 session 不开分屏」。幂等（刷新 lastSeen 与 owner.meta），尽力而为，失败不影响编排。"""
    bin_=os.environ.get('CC_FLEET_PANEL_REGISTER_BIN',str(ROOT/'cc-fleet-panel-register'))
    try: return run([bin_,str(c),rq,*(['--no-owner'] if no_owner else [])],timeout=30,check=False).returncode==0
    except Exception: return False

def panel_attach(c, d, auto=False):
    """CLI 路径（Codex app-server / Claude --bg）worker 派发成功后：登记面板注册表 + 在当前 Ghostty 窗口分屏拉起只读面板。
    两种后端同屏：按任务组列出子 session、状态与最近动作，→ 进详情看完整时间线（Codex 读 rollout，Claude 读 transcript）。
    尽力而为：面板脚本自己处理 Ghostty 没开/没授权/不是 macOS 的情况，绝不因面板让派发失败。
    CC_FLEET_PANEL=0 只是不开分屏（panelOpened=None），登记照做；native（Codex App 主端，App 自带侧栏）不走这里。"""
    if d.get('transport') not in ('app-server','claude-bg'): return None
    fleet=meta(c)
    # 编排器自动派发可能跑在 watchdog（rescue-owners）进程里：不能以它的身份改写主端归属，也不在别处拉分屏。
    out=dict(registered=panel_register(c,fleet['rq'],no_owner=auto),panelOpened=None)
    if auto or os.environ.get('CC_FLEET_PANEL')=='0': return out
    bin_=os.environ.get('CC_FLEET_PANEL_OPEN_BIN',str(ROOT/'cc-fleet-panel-open'))
    try: out['panelOpened']=run([bin_,'--quiet'],timeout=30,check=False,env=dict(os.environ,CC_FLEET_PANEL_CWD=fleet['repo'])).returncode==0
    except Exception: out['panelOpened']=False
    return out

def profile_of(d,conf,explicit=None):
    """显式 --profile > prepare 登记的 profile > 回归卡优先用 runner（只跑测试读结果，用便宜模型）> worker。"""
    if explicit: return explicit
    if d.get('profile'): return d['profile']
    return 'runner' if d.get('role')=='regression' and 'runner' in conf else 'worker'

def refresh_baseline(c,d):
    """worktree 在 prepare 时按当时的集成分支建立；排队卡要等依赖合入后才派发。worker 还没动过 worktree 时
    快进到集成分支最新提交，否则回归/验收会跑在不含依赖改动的旧基线上。"""
    wt=d.get('worktree')
    if not wt or not Path(wt).is_dir(): return
    fleet=meta(c); tip=git(fleet['repo'],'rev-parse',fleet['integrationBranch'])
    if tip==d['baselineCommit'] or git(wt,'rev-parse','HEAD')!=d['baselineCommit'] or git(wt,'status','--porcelain'): return
    git(wt,'merge','--ff-only','-q',tip); d['baselineCommit']=tip

def dispatch(a):
    emit(launch(coord(a.coord),a.module,a.profile))

def launch(c,m,profile=None,auto=False):
    with lock(c,m):
        d=load(c,m)
        if d['state']=='self': raise ValueError('self module is developed by the main session; nothing to dispatch')
        if d['state'] not in ('prepared','queued'): raise ValueError('already attempted; inspect/reconcile before retrying')
        if d['transport']=='native':
            return dict(d,nextAction='Use list_projects + create_thread, then register the returned threadId (or clientThreadId while pending).',promptFile=str(c/f'{m}.prompt.md'))
        d['state']='launching'
        if auto: d['autoDispatchedAt']=time.time()
        refresh_baseline(c,d)
        atomic(record(c,m),d)
    d=start_session(c,m,d,(c/f'{m}.prompt.md').read_text(),profile)
    return dict(d,panel=panel_attach(c,d,auto),nextWake=wake_hint(c))

def start_session(c,m,d,prompt,profile=None,exclude=()):
    """在 d 的 worktree 起一个新会话并落盘身份。exclude：换会话时排除旧会话（同名同目录的旧 job 仍在列表里）。"""
    try:
        if d['transport']=='claude-bg':
            args=[claude_bin(),'--bg','--name',d['name']]
            if d.get('permissions','full')=='full': args+=['--dangerously-skip-permissions']
            # Existing backend config remains authoritative; no model-name substitution.
            conf=Path(os.environ.get('CLAUDE_FLEET_CONFIG',str(Path.home()/'.claude/multi-session-dev.json')))
            allp=json.loads(conf.read_text()) if conf.exists() else {}
            profile=allp.get(profile_of(d,allp,profile),{})
            if profile:
                for field in ('model','effort'):
                    if profile.get(field): args+=['--'+field,str(profile[field])]
            # 只作展示（面板详情页的模型行）；不参与 reply/路由。
            d['claudeProfile']={k:str(profile[k]) for k in ('model','effort') if profile.get(k)}
            args += [prompt]
            # 在子项目目录启动：Claude 按启动目录向上加载 CLAUDE.md，根目录启动会漏掉子项目规则。
            p=run(args,cwd=workdir(d),timeout=55,check=False)
            # Reconcile through public JSON, not localized launch output or session-name prefixes.
            hits=[j for j in claude_jobs() if j.get('name')==d['name'] and j.get('id') not in exclude
                  and Path(j.get('cwd','/')).resolve()==Path(workdir(d)).resolve()]
            if len(hits)!=1 or not hits[0].get('id'):
                raise RuntimeError('launch outcome uncertain; inspect claude agents --json --all; do not redispatch')
            j=hits[0]; d.update(shortId=j['id'],sessionId=j.get('sessionId'),state='running',activeSince=time.time())
        else:
            routing=route(meta(c)); d['routing']=routing
            # Apply fleet permission preference explicitly at thread and turn boundaries.
            # Codex 只加载 git 根到 cwd 路径上的 AGENTS.md，cwd 必须是子项目目录。
            params=dict(cwd=workdir(d),ephemeral=False,serviceName='multi-session-dev-v2',threadSource='user')
            if routing.get('model'): params['model']=routing['model']
            if routing.get('modelProvider'): params['modelProvider']=routing['modelProvider']
            if routing.get('providerType')=='deepseek': params['serviceTier']=None
            params.update(permission_params(d))
            res=call('thread/start',params,start=True)
            d['sessionId']=res['thread']['id']
            # Persist ID before any subsequent RPC; a failed reply must never duplicate this thread.
            update(c,m,sessionId=d['sessionId'],routing=routing)
            call('thread/name/set',dict(threadId=d['sessionId'],name=d['name']))
            turn=dict(threadId=d['sessionId'],cwd=workdir(d),input=[dict(type='text',text=prompt)])
            if routing.get('reasoningEffort'): turn['effort']=routing['reasoningEffort']
            if routing.get('providerType')=='deepseek': turn.update(serviceTier=None,summary='none')
            turn.update(permission_params(d, turn=True))
            res=call('turn/start',turn); d.update(state='running',turnId=res['turn']['id'],startedAt=time.time(),activeSince=time.time())
        # Preserve a concurrently written bind/worktree update.
        d=update(c,m,**{k:v for k,v in d.items() if k not in ('module','worktree','branch')})
        d=goal_attach(c,m,d)
        # 记录先落盘再开面板：面板第一次扫描就能看到这个 worker。
        return sidebar_attach(c,d)
    except Exception:
        update(c,m,state='launch-uncertain')
        raise

def receipt(c,d):
    p=c/(d['module']+'.receipt.json')
    if not p.exists(): p=inbox(c,d)
    if not p.exists(): return None
    r=json.loads(p.read_text())
    if any(r.get(k)!=v for k,v in [('version',2),('rq',meta(c)['rq']),('module',d['module']),('attempt',d['attempt'])]):
        return dict(result='needs-review',summary='stale or mismatched receipt')
    if r.get('result') not in ('done','failed','blocked') or not r.get('summary'):
        return dict(result='needs-review',summary='invalid receipt')
    if r['result']=='done':
        wt=r.get('worktree') or d.get('worktree')
        if wt and Path(wt).is_dir():
            with contextlib.suppress(RuntimeError): wt=toplevel(wt)
        f=meta(c)
        if not wt or Path(wt).resolve()==Path(f['repo']).resolve():
            return dict(result='needs-review',summary='missing independent worktree')
        if d.get('worktree') and Path(wt).resolve()!=Path(d['worktree']).resolve():
            return dict(result='needs-review',summary='receipt worktree does not match registry')
        if Path(git(wt,'rev-parse','--path-format=absolute','--git-common-dir')).resolve()!=Path(f['commonDir']):
            return dict(result='needs-review',summary='receipt belongs to another repository')
        if run(['git','-C',wt,'merge-base','--is-ancestor',d['baselineCommit'],'HEAD'],check=False).returncode:
            return dict(result='needs-review',summary='worktree lacks prepared integration baseline')
        if not isinstance(r.get('tests'),list) or not r['tests']:
            return dict(result='needs-review',summary='missing verification evidence')
        if any(not isinstance(t,dict) or t.get('result') not in ('passed','not-run') or not t.get('evidence') for t in r['tests']):
            return dict(result='needs-review',summary='invalid or failed verification evidence')
        accept=d['role'] in ACCEPT_ROLES and d.get('phase')!='author'  # 编写阶段只交脚本与清单，不算验收
        if accept and any(t.get('result')!='passed' for t in r['tests']):
            return dict(result='needs-review',summary='acceptance has unexecuted verification')
        if accept:
            sha=r.get('commit','')
            if not re.fullmatch('[a-f0-9]{40,64}',sha):
                return dict(result='needs-review',summary='missing tested commit')
            if sha!=git(wt,'rev-parse','HEAD') or sha!=git(f['repo'],'rev-parse',f['integrationBranch']):
                return dict(result='needs-review',summary='acceptance baseline changed; reverify current integration')
        if d['role']=='developer':
            if not any(t.get('result')=='passed' for t in r['tests']):
                return dict(result='needs-review',summary='developer has no passing verification')
            sha=r.get('commit','')
            if not re.fullmatch('[a-f0-9]{40,64}',sha): return dict(result='needs-review',summary='missing commit')
            f=meta(c)
            if run(['git','-C',f['repo'],'merge-base','--is-ancestor',sha,f['integrationBranch']],check=False).returncode:
                return dict(result='needs-review',summary='commit not landed on integration branch')
    return r

def mtime(p):
    try: return Path(p).stat().st_mtime
    except (OSError, TypeError): return 0.0

def last_activity(c,d):
    """Filesystem proof of life. Backend status words keep saying 'working' after a session
    already exited (a worker whose final message lacked `result:` never flips to done), so a
    running claim is only trusted while something it would have touched is still moving.
    The roster record itself is excluded: reply() writes it, which would fake activity."""
    m=d['module']; ts=[mtime(c/(m+x)) for x in ('.alive','.summary.md','.receipt.json','.prompt.md')]
    if d.get('worktree'):
        ts.append(mtime(Path(d['worktree'])/'.git'))
        with contextlib.suppress(Exception):
            ts.append(float(git(d['worktree'],'log','-1','--format=%ct')))
    if d.get('backend')=='claude' and d.get('shortId'):
        j=JOBS_DIR/d['shortId']; ts.append(mtime(j/'state.json'))
        with contextlib.suppress(Exception):
            ts.append(mtime(json.loads((j/'state.json').read_text()).get('linkScanPath')))
    with contextlib.suppress(Exception):
        ts.append(mtime(inbox(c,d)))
    return max(ts)

def stale_check(c,d,out,stale_after):
    """Annotate a running module that has shown no observable activity for too long."""
    launched=out.pop('_launchedAt',0.0)
    if out['state']!='running' or stale_after<=0: return out
    seen=max(last_activity(c,d), float(d.get('activeSince') or d.get('startedAt') or 0), launched)
    out['lastActivityAt']=seen or None
    out['idleFor']=int(time.time()-seen) if seen else None
    if seen and out['idleFor']>stale_after:
        out['attention']='stalled'
        out['attentionHint']=('backend still claims running but nothing moved for '
                              f"{out['idleFor']}s; verify with read/worktree HEAD before replying "
                              '(an exited session accepts no reply)')
    return out

def job_state(short):
    with contextlib.suppress(Exception):
        return json.loads((JOBS_DIR/short/'state.json').read_text())
    return None

def iso_ts(v):
    with contextlib.suppress(Exception):
        return datetime.datetime.fromisoformat(str(v).replace('Z','+00:00')).timestamp()
    return 0.0

def claude_ended(d,j,out):
    """`claude agents` 的 state 在会话结束后可能一直停在 working（进程被回收后列表不刷新、末条漏打
    `result:`），主端据此会死等到 stalled 兜底。job 自己的 state.json 与进程存活才是事实：
    - state.json 已是终态 → 以它为准；
    - 列表里没有 pid/status → 进程已退出；
    - 本轮已停（tempo≠active）、无后台任务、state.json 超过 IDLE_GRACE 未更新 → 这一轮已结束且没人会再唤醒它。
    后两种按 needs-review 报，交主端 read 核实，不再冒充 running。"""
    js=job_state(d['shortId']) or {}
    since=float(d.get('repliedAt') or 0)  # 只看 reply：dispatch 后 state.json 本就会很快刷新；updatedAt 只精确到秒，留 1 秒容差
    if since and js and iso_ts(js.get('updatedAt'))+1<since and time.time()-since<REPLY_GRACE:
        return  # state.json 还停在上一轮：刚发出的 reply / 复活尚未反映，别把新一轮误判成已结束（reply 后 await 秒退）
    if CLAUDE_STATES.get(js.get('state')) not in (None,'running'):
        out['state']=CLAUDE_STATES[js['state']]; out['backendState']=js['state']
    if out['state']!='running': return
    reason=None
    if 'pid' not in j and 'status' not in j: reason='process-exited'
    elif js and js.get('tempo')!='active' and not (js.get('inFlight') or {}).get('tasks') \
            and time.time()-iso_ts(js.get('updatedAt'))>IDLE_GRACE:
        reason='turn-ended-without-result'
    if reason:
        out.update(state='needs-review',attention=reason,
                   attentionHint='worker 会话已不在工作（backend 仍报 working），先 read 核实结果再决定收回执或开 fix 卡')

def status_one(c,d,jobs=None,stale_after=0):
    out={k:d.get(k) for k in ('module','backend','transport','sessionId','shortId','state','worktree')}
    for k in ('after','phase','queuedReply'):
        if d.get(k): out[k]=d[k]
    if d.get('sessionId') and d.get('transport') in ('claude-bg','app-server'):
        x=context_of(c,d)  # 下一条回复会复用还是换新会话，主端/面板一眼可见
        if x: out['context']={k:x[k] for k in ('tokens','idleFor','compactions','reuse','why')}
    try:
        r=receipt(c,d)
        if r: out.update(state=r['result'],receipt=r); goal_close(c,d,r); return out
        if d['state'] in NOT_LAUNCHED: return out
        if d['backend']=='claude':
            j=next((x for x in (claude_jobs() if jobs is None else jobs) if x.get('id')==d['shortId']),None)
            if j is None: out['state']='unknown'; return out
            st=j.get('state'); out['backendState']=st; out['waitingFor']=j.get('waitingFor')
            out['_launchedAt']=float(j.get('startedAt') or 0)/1000  # ms; floor for staleness
            out['state']=CLAUDE_STATES.get(st,'unknown')
            claude_ended(d,j,out)
        else:
            t=call('thread/read',dict(threadId=d['sessionId'],includeTurns=True))['thread']
            st=t.get('status',{}); st=st if isinstance(st,dict) else {'type':st}
            flags=str(st.get('activeFlags',[])).lower()
            out['state']='blocked' if any(x in flags for x in ('waiting','approval','input')) else {'active':'running','idle':'needs-review','notLoaded':'needs-review','systemError':'failed'}.get(st.get('type'),'unknown')
            turns=t.get('turns',[])
            if turns and turns[-1].get('status') in ('failed','interrupted'):
                out['state']='failed' if turns[-1]['status']=='failed' else 'stopped'
            goal_status(c,d,out,turns)
    except Exception as e:
        out.update(state='unknown',error=type(e).__name__)
    return stale_check(c,d,out,stale_after)

def statuses(c,stale_after=STALE_AFTER):
    ds=[json.loads(p.read_text()) for p in sorted((c/'v2').glob('*.json')) if not p.name.startswith('.')]
    jobs=[]
    if any(d['backend']=='claude' for d in ds):
        try: jobs=claude_jobs()
        except Exception: jobs=[]
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        return list(pool.map(lambda d:status_one(c,d,jobs,stale_after),ds))

def status(a):
    rows=statuses(coord(a.coord),a.stale_after)
    emit({'jobs':rows,'stalled':[r['module'] for r in rows if r.get('attention')=='stalled']})

def read(a):
    c=coord(a.coord); d=load(c,a.module); r=receipt(c,d)
    if r: emit(r); return
    if d['backend']=='claude': print(run([claude_bin(),'logs',d['shortId']]).stdout)
    else: emit(call('thread/read',dict(threadId=d['sessionId'],includeTurns=True)))

def reply(a):
    c=coord(a.coord); text=Path(a.text_file).read_text()
    emit(send_reply(c,a.module,text,force=a.force,phase=a.phase,manual=True,session=a.session))

def claude_send(d,text):
    """经 daemon 给 Claude worker 投递一条消息。done 会话空闲约 10 分钟会被 watchdog 回收（ENOJOB）：
    此时用 job 的 state.json 原地 resume 复活（同一 short/sessionId、上下文还在），再投递——回修交回原会话，
    不必新开 fix 卡重新冷启动。"""
    r=daemon_call(dict(op='reply',short=d['shortId'],text=text))
    if r.get('ok'): return False
    js=job_state(d['shortId'])
    if r.get('code')!='ENOJOB' or not js: raise RuntimeError(f"reply {d['shortId']} rejected: {r.get('code')} {r.get('error')}")
    revive(d['shortId'],js)
    r=daemon_call(dict(op='reply',short=d['shortId'],text=text))
    if not r.get('ok'): raise RuntimeError(f"reply {d['shortId']} after revive rejected: {r.get('code')} {r.get('error')}")
    return True

def context_of(c,d):
    """会话当前上下文体量（见 lib/session_ctx.py）；测不到返回 None。"""
    try:
        if d.get('backend')=='claude':
            js=job_state(d['shortId']) if d.get('shortId') else None
            p=session_ctx.claude_transcript(d.get('sessionId'),workdir(d) if d.get('cwd') or d.get('worktree') else '',
                                            (js or {}).get('linkScanPath',''))
        else: p=session_ctx.codex_rollout(d.get('sessionId'))
        if not p: return None
        x=session_ctx.measure(p,'claude' if d.get('backend')=='claude' else 'codex',c/'v2'/'.ctx-cache.json')
        reuse,why=session_ctx.decide(x)
        return dict(x,idleFor=int(time.time()-x['lastAt']) if x.get('lastAt') else None,reuse=reuse,why=why)
    except Exception:
        return None

def rotate(c,m,d,text,why,ctx):
    """换新会话：停掉旧会话，同一 worktree、同一任务卡起新会话，靠交接文件与 worktree 现状续上。"""
    if d['backend']=='claude' and d.get('shortId'):
        with contextlib.suppress(Exception): run([claude_bin(),'stop',d['shortId']],timeout=30,check=False)
    goal_pause(c,d)
    prev=list(d.get('previousSessions') or [])+[dict(sessionId=d.get('sessionId'),shortId=d.get('shortId'),
              transcript=(ctx or {}).get('path'),reason=why,rotatedAt=time.time())]
    hp=next((p for p in (handoff_path(c,d),handoff_path(c,d,fallback=True)) if p.exists()),None)
    card=(c/f'{m}.prompt.md').read_text().split('\n任务卡：\n',1)[-1]
    brief=(f"\n\n【接续】本卡此前由别的会话执行，因{'、'.join(why)}换成你这个新会话接着做。先读"
           +(f"交接文件 {hp}" if hp else '（没有交接文件）')+f'，再看 worktree 现状（git log、已写脚本、证据目录）与上一轮回执 {c/"v2"}/{m}.receipt-*.json.bak；'
           +(f"细节缺失时可 grep 旧会话记录 {prev[-1]['transcript']}，⛔ 不要整篇读入。" if prev[-1].get('transcript') else '')
           +'旧会话的结论只作线索，一律以本轮在当前基线上的实测为准；本轮结束同样更新交接文件。\n\n下面是本轮消息：\n')
    d=dict(d,previousSessions=prev,sessionId=None,shortId=None,turnId=None)
    return start_session(c,m,d,preamble(c,d)+card+brief+text,exclude={p.get('shortId') for p in prev if p.get('shortId')})

def send_reply(c,m,text,force=False,phase=None,manual=False,session='auto'):
    d=load(c,m)
    if not text.strip(): raise ValueError('empty reply')
    if d['state']=='self': raise ValueError('self module belongs to the main session')
    if not d.get('sessionId') and not d.get('shortId'): raise ValueError('session not registered')
    if manual and d.get('replies',0)>=MAX_REPLIES and not force:
        raise ValueError(f"module {m} already got {d.get('replies',0)} replies; repeated rework means the requirement, "
                         'contract or environment needs re-checking (with the user if semantic). Re-check first, '
                         'then reply --force, or open a fresh fix card with full asset references')
    cur=status_one(c,dict(d),stale_after=STALE_AFTER)
    if cur.get('attention')=='stalled' and not force:
        raise ValueError(f"module idle for {cur['idleFor']}s while claiming running; the session may "
                         'have ended and would swallow this reply. Check read/worktree HEAD first, '
                         'then use --force or dispatch a fix module instead')
    # 复用还是换新会话：正在干活（running 且没卡住）的会话本身就热，不打断；其余按「热且小才复用」判定。
    fresh,why,ctx=False,[],None
    if d['transport'] in ('claude-bg','app-server') and session!='reuse':
        ctx=context_of(c,d)
        if session=='fresh': fresh,why=True,['主端指定 --session fresh']
        elif cur.get('state')!='running' or cur.get('attention')=='stalled':
            fresh,why=not (ctx or {}).get('reuse',True),(ctx or {}).get('why',[])
    # Archive old receipts before a new attempt so stale done cannot win over resumed work.
    with lock(c,m):
        d=load(c,m); old=c/(m+'.receipt.json')
        if old.exists(): old.rename(c/'v2'/(m+'.receipt-'+d['attempt']+'.json.bak'))
        d['attempt']=uuid.uuid4().hex; d['state']='replying'
        if manual: d['replies']=d.get('replies',0)+1
        if phase: d['phase']=phase
        atomic(record(c,m),d)
    fleet=meta(c)
    head=f"本轮 attempt={d['attempt']}；回执 attempt 更新为此值。协调目录不可写时，改写临时回执 {inbox(c,d)}，不要复用上一轮临时回执路径。\n"
    if phase=='execute':
        head+=(f"【执行阶段】依赖已合入集成分支 {fleet['integrationBranch']}：先把它合并进你的 worktree（保留已写的验收脚本），"
               '在最新集成基线上启动真实服务，先连续跑核心主流程再逐条执行全部用例；验收脚本提交后用 cc-fleet-land 合入，'
               '回执 commit 写合入后的集成分支 HEAD，tests 只有全部 passed 才能 done。\n')
    text=head+text+'\n继续前重读任务卡及最新需求、用户用例与契约，以及本次参考资料（如有）；失败如实回执，修复后复测失败项和受影响的完整主流程。\n'
    if d['transport']=='native':
        return dict(d,nextAction='send_message_to_thread, then register the same threadId after acceptance',prompt=text)
    if fresh:
        try: d=rotate(c,m,d,text,why,ctx)
        except Exception:
            update(c,m,state='launch-uncertain'); raise
        now=time.time(); d=update(c,m,activeSince=now,repliedAt=now)
        return dict(d,revived=False,rotated=dict(reason=why,previous=d['previousSessions'][-1]),nextWake=wake_hint(c))
    revived=False
    try:
        if d['backend']=='claude':
            revived=claude_send(d,text)
        else:
            t=call('thread/read',dict(threadId=d['sessionId'],includeTurns=True))['thread']
            turns=t.get('turns',[]); latest=turns[-1] if turns else {}
            params=dict(threadId=d['sessionId'],input=[dict(type='text',text=text)])
            if latest.get('status')=='inProgress':
                params['expectedTurnId']=latest['id']; call('turn/steer',params)
            else:
                call('thread/resume',dict(threadId=d['sessionId'], **permission_params(d)))
                if d.get('worktree'): params['cwd']=workdir(d)
                routing=d.get('routing',{})
                if routing.get('reasoningEffort'): params['effort']=routing['reasoningEffort']
                if routing.get('providerType')=='deepseek': params.update(serviceTier=None,summary='none')
                params.update(permission_params(d, turn=True))
                call('turn/start',params)
            goal_attach(c,m,d)  # 新 attempt 重新激活目标（之前可能已 complete/预算耗尽/暂停）
        # activeSince anchors staleness: an exited session accepts the reply silently, so if
        # nothing moves after this stamp, status/await surface it instead of claiming running.
        now=time.time()
        return dict(update(c,m,state='running',activeSince=now,repliedAt=now),revived=revived,nextWake=wake_hint(c))
    except Exception:
        update(c,m,state='launch-uncertain'); raise

def queue_reply(a):
    """登记一条「依赖全部 done 后自动发给本模块」的消息（典型：验收卡编写阶段完成后，等开发合入再自动进入执行阶段；
    或开发回修后自动让验收复测）。触发由 await / rescue-owners 里的 advance 完成，主端不必醒来。"""
    c=coord(a.coord); m=a.module; text=Path(a.text_file).read_text()
    if not text.strip(): raise ValueError('empty reply')
    after=[name(x) for x in re.split(r'[,\s]+',a.after) if x]
    if not after: raise ValueError('--after is required')
    for x in after:
        if x==m or not record(c,x).exists(): raise ValueError(f'--after module not registered: {x}')
    d=load(c,m)
    if d['transport'] in ('native','self'): raise ValueError('queue-reply needs a CLI-launched worker')
    f=c/f'{m}.queued-reply.md'; f.write_text(text)
    emit(update(c,m,queuedReply=dict(after=after,textFile=str(f),phase=a.phase,session=a.session,queuedAt=time.time())))

def deps_ready(after,rows):
    st={r['module']:r['state'] for r in rows}
    return all(st.get(x)=='done' for x in after)

def advance(c,rows=None):
    """依赖图自动推进：queued 模块的依赖全部 done（回执已核验）→ 自动派发；queuedReply 的依赖全部 done 且本模块
    当前这一轮已结束（SETTLED）→ 自动发出消息。单例（协调目录级 flock），失败的动作原样报告，交主端处理。"""
    acts=[]
    with open(c/'.advance.lock','w') as lk:
        try: fcntl.flock(lk,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except OSError: return acts
        rows=rows if rows is not None else statuses(c)
        for r in rows:
            m=r['module']
            try:
                d=load(c,m)
                if d['state']=='queued' and deps_ready(d.get('after') or [],rows):
                    out=launch(c,m,auto=True); acts.append(dict(module=m,action='dispatched',state=out.get('state')))
                # 本模块这一轮已结束即可接续：验收发现缺陷时回执是 failed，依赖回修合入后旧回执又会变成基线过期的 needs-review。
                elif d.get('queuedReply') and r['state'] in SETTLED and deps_ready(d['queuedReply']['after'],rows):
                    q=d['queuedReply']; text=Path(q['textFile']).read_text()
                    update(c,m,queuedReply=None,firedReply=dict(q,firedAt=time.time()))  # 先清再发，绝不重复投递
                    out=send_reply(c,m,text,force=True,phase=q.get('phase'),session=q.get('session') or 'auto')
                    acts.append(dict(module=m,action='replied',revived=out.get('revived',False),
                                     **({'rotated':out['rotated']['reason']} if out.get('rotated') else {})))
            except Exception as e:
                acts.append(dict(module=m,action='error',error=f'{type(e).__name__}: {e}'))
    return acts

def auto_deps(c):
    """done 时由编排器接续、不必唤醒主端的模块：被自动步骤消费的依赖，以及自己还排着下一条消息的模块
    （验收卡编写阶段完成、等依赖合入后自动进入执行阶段）。"""
    out=set()
    for p in (c/'v2').glob('*.json'):
        if p.name.startswith('.'): continue
        with contextlib.suppress(Exception):
            d=json.loads(p.read_text())
            if d.get('queuedReply'): out.add(d['module'])
            if d.get('after') and (d['state']=='queued' or d.get('autoDispatchedAt')): out|=set(d['after'])
            for q in (d.get('queuedReply'),d.get('firedReply')):
                if q: out|=set(q.get('after') or [])
    return out

def advance_cmd(a):
    emit({'actions':advance(coord(a.coord))})

def stop(a):
    c=coord(a.coord); d=load(c,a.module)
    if d['backend']=='claude': run([claude_bin(),'stop',d['shortId']])
    else:
        t=call('thread/read',dict(threadId=d['sessionId'],includeTurns=True))['thread']
        for turn in reversed(t.get('turns',[])):
            if turn.get('status')=='inProgress':
                call('turn/interrupt',dict(threadId=d['sessionId'],turnId=turn['id'])); break
        goal_pause(c,d)
    emit(update(c,a.module,state='stopped'))

def wait(a):
    c=coord(a.coord); end=time.monotonic()+a.timeout
    while True:
        rows=statuses(c)
        if advance(c,rows): rows=statuses(c)  # Codex 主端靠有界 wait 循环，依赖图同样在这里推进
        if not rows or all(r['state'] in TERMINAL for r in rows) or any(r['state'] in TERMINAL-{'done'} for r in rows):
            emit({'reason':'attention-or-complete','jobs':rows}); return
        remaining=end-time.monotonic()
        if remaining<=0: emit({'reason':'timeout','jobs':rows}); return
        time.sleep(min(a.interval,remaining))

def wake_hint(c):
    """Emitted on every dispatch/reply: the controller must not end its turn empty-handed."""
    return (f'{ROOT/"cc-fleet"} await --coord {shlex.quote(str(c))}'
            '  # 结束响应前用 run_in_background 挂上，否则没有任何东西会叫醒你')

def pending(rows):
    """Modules dispatched and not settled yet, plus queued ones the orchestrator will launch.
    'prepared' (awaiting a manual dispatch) and 'self' (main session's own worktree) are not pending."""
    return [r for r in rows if r['state'] not in TERMINAL and r['state'] not in ('prepared','self')]

def owner_session():
    return os.environ.get('CLAUDE_CODE_SESSION_ID') or os.environ.get('CLAUDE_SESSION_ID') or os.environ.get('CODEX_THREAD_ID') or ''

def pid_alive(pid):
    try: os.kill(int(pid),0); return True
    except (OSError,ValueError,TypeError): return False

def live_await(c):
    """协调目录上仍在跑的 await（心跳文件 + 进程存活），Stop 守卫与单例判断共用。"""
    with contextlib.suppress(Exception):
        w=json.loads((c/'await.json').read_text())
        if pid_alive(w.get('pid')) and time.time()-float(w.get('beatAt',0))<=2*float(w.get('interval',20))+30:
            return w
    return None

def await_(a):
    """Long-lived wake-up for the controlling session: block until a watched module changes
    state, then exit so the host delivers the exit notification back to the main session.
    不带 --modules 时，挂起期间新派发的模块自动纳入监视（增量派发不必重挂）；同一主 session 只留一个。"""
    if not 60<=a.timeout<=86400: raise ValueError('--timeout must be 60..86400 seconds')
    if not 5<=a.interval<=300: raise ValueError('--interval must be 5..300 seconds')
    c=coord(a.coord); me=owner_session()
    targets={x for x in re.split(r'[,\s]+',a.modules or '') if x}
    advanced=advance(c)
    rows=[r for r in statuses(c,a.stale_after) if not targets or r['module'] in targets]
    base={r['module']:r['state'] for r in pending(rows)}
    if not base:
        emit({'reason':'nothing-to-await','label':a.label,'jobs':rows}); return
    other=live_await(c)
    if other and not targets and not other.get('modules') and other.get('session')==me and other.get('pid')!=os.getpid():
        # 已有同一主 session 的全量 await 在盯（它会自动纳入新模块），不再叠一个。
        emit({'reason':'already-awaiting','label':a.label,'pid':other['pid'],'watching':other.get('watching')}); return
    # 挂上那一刻已 stalled 的模块不再触发唤醒（否则醒来重挂即秒退空转），只等它们状态变化。
    known_stalled={r['module'] for r in rows if r.get('attention')=='stalled'}
    end=time.monotonic()+a.timeout; hb=c/'await.json'
    def beat():
        atomic(hb,dict(pid=os.getpid(),session=me,label=a.label,modules=sorted(targets),watching=sorted(base),
                       interval=a.interval,startedAt=started,beatAt=time.time(),deadline=time.time()+end-time.monotonic()))
    started=time.time(); beat()
    import signal
    signal.signal(signal.SIGTERM,lambda *_: sys.exit(143))  # 被宿主终止时也走 finally 清心跳
    try:
        while True:
            time.sleep(max(1,min(a.interval,end-time.monotonic())))
            rows=statuses(c,a.stale_after)
            acts=advance(c,rows)
            if acts: advanced+=acts; rows=statuses(c,a.stale_after)
            errors=[x for x in acts if x['action']=='error']
            if not targets:
                for r in pending(rows):
                    if r['module'] not in base: base[r['module']]=r['state']  # 新派发的，纳入监视
            rows=[r for r in rows if r['module'] in base]
            seen={r['module'] for r in rows}
            changed=[dict({'module':r['module'],'from':base[r['module']],'to':r['state'],
                           'summary':(r.get('receipt') or {}).get('summary')},
                          **({'attention':r['attention']} if r.get('attention') else {}))
                     for r in rows if r['state']!=base[r['module']]]
            changed+=[{'module':m,'from':base[m],'to':'gone','summary':None} for m in sorted(base.keys()-seen)]
            # 由依赖图自动接续的变化不唤醒主端：依赖模块 done（下游会被自动派发/发消息）、queued→已派发、
            # 自动消息发出后进入新一轮。只有失败/阻塞/待核实、无下游的完成、全部收尾、推进出错才叫醒。
            quiet=auto_deps(c); moved={x['module'] for x in acts}
            def routine(x):
                # 已被下游验收消费的依赖：下游合入验收脚本使集成基线前移，它的旧证据随之 needs-review，以下游最终基线为准。
                rebased=x['from']=='done' and x['to']=='needs-review' and (x.get('summary') or '').startswith('acceptance baseline changed')
                return (x['to']=='done' and x['module'] in quiet) or (rebased and x['module'] in quiet) or \
                       (x['module'] in moved and x['to'] in ('running','launching','replying'))
            for x in [x for x in changed if routine(x)]: base[x['module']]=x['to']
            changed=[x for x in changed if not routine(x)]
            stalled=[r['module'] for r in rows if r.get('attention')=='stalled' and r['module'] not in known_stalled]
            left=[r['module'] for r in pending(rows)]
            if not changed and not stalled and not errors and base and not left:
                changed=[{'module':m,'from':'auto','to':base[m],'summary':None} for m in sorted(base)]  # 流水线已全部收尾
            if changed or stalled or errors:
                head='; '.join(f"{x['module']} {x['from']}→{x['to']}" for x in changed)+(f"; stalled {','.join(stalled)}" if stalled else '')
                head+=''.join(f"; advance-error {x['module']}" for x in errors)
                stuck=[r['module'] for r in rows if r['state']=='queued' and
                       any(next((y['state'] for y in rows if y['module']==z),None) in TERMINAL-{'done'} for z in r.get('after') or [])]
                emit({'wake':head.strip('; '),'reason':'state-changed' if changed else ('stalled' if stalled else 'advance-error'),'label':a.label,
                      'changed':changed,'stalled':stalled,'stillPending':left,'advanced':advanced,'errors':errors,
                      **({'queueBlocked':stuck} if stuck else {}),
                      'next':'先 status 再决策'+('；queueBlocked 的依赖未成功，回修依赖（reply 原模块）后它会自动派发' if stuck else '')
                             +('；stillPending 非空，结束响应前重新挂 await' if left else '')}); return
            if time.monotonic()>=end:
                # 超时只是本次等待结束：退出码 0（别被当失败），输出一行即可，原命令原样重挂。
                emit({'wake':'timeout','reason':'timeout','label':a.label,'waitedSeconds':a.timeout,'advanced':advanced,
                      'stillPending':[r['module'] for r in pending(rows)],
                      'next':'无变化；用同一命令重新挂 await（run_in_background），⛔ 不要改用自写轮询'}); return
            beat()
    finally:
        with contextlib.suppress(Exception):
            if json.loads(hb.read_text()).get('pid')==os.getpid(): hb.unlink()

def fleet_home():
    return Path(os.environ.get('CC_FLEET_HOME') or Path.home()/'.claude'/'fleet')

def registry_coords():
    reg=Path(os.environ.get('CC_FLEET_PANEL_REGISTRY') or fleet_home()/'codex-coords.json')
    with contextlib.suppress(Exception):
        return {Path(x['coord']) for x in json.loads(reg.read_text()).get('coords',[])}
    return set()

def owned_coords(session, cwd, max_age=7*86400):
    """本 session 作为主端 init 的协调目录：面板注册表 ∪ cwd 所在仓库的 .git/fleet。"""
    cands=registry_coords()
    with contextlib.suppress(Exception):
        common=Path(run(['git','-C',cwd,'rev-parse','--path-format=absolute','--git-common-dir'],timeout=5).stdout.strip())
        cands|=set((common/'fleet').glob('*'))
    out=[]
    for c in sorted(cands):
        with contextlib.suppress(Exception):
            if time.time()-(c/'v2').stat().st_mtime>max_age and not (c/'await.json').exists(): continue
            ids={json.loads((c/'fleet.json').read_text())['owner']['id']}
            with contextlib.suppress(OSError):  # 面板登记时记下的真实主 session（owner.id 可能是 controller-*）
                ids|={l.split('=',1)[1].strip() for l in (c/'owner.meta').read_text().splitlines() if l.startswith('owner_session_id=')}
            if session in ids: out.append(c)
    return out

def stop_guard(a):
    """Claude Code Stop hook：主端还有未终态 worker、却没挂 await 就想结束响应时拦下（SKILL.md §6 的强制版）。
    任何异常一律放行，绝不因守卫自身故障卡住 session。"""
    try:
        h=json.loads(sys.stdin.read() or '{}')
        session=h.get('session_id') or ''
        if not session or os.environ.get('FLEET_ROLE')=='worker' or h.get('stop_hook_active'): return
        miss=[]
        for c in owned_coords(session, h.get('cwd') or os.getcwd()):
            if live_await(c): continue
            p=[r['module'] for r in pending(statuses(c))]
            if p: miss.append((c,p))
        if not miss: return
        cmds='\n'.join(f'{ROOT/"cc-fleet"} await --coord {shlex.quote(str(c))} --label {shlex.quote("等 "+",".join(p))}' for c,p in miss)
        print(json.dumps({'decision':'block','reason':
            '多 session 编排：以下 worker 还在跑，但没有挂上能叫醒你的 await，结束响应后不会有任何东西通知你。'
            '请用 Bash(run_in_background=true) 运行（每个协调目录一条，已挂的会自动复用），然后再结束响应：\n'+cmds},ensure_ascii=False))
    except Exception as e:
        print(f'cc-fleet stop-guard skipped: {type(e).__name__}: {e}',file=sys.stderr)

# ---- 主端兜底唤醒（rescue-owners）----
# await 跑在主 session 自己的进程树里：主 session 被回收/重启/OOM，await 随之消失，之后 worker 交回执
# 没有任何东西会通知主端（2026-10-08 RQ-20261008-193532 主端停摆 12 小时）。本命令由常驻 watchdog 周期调用，
# 独立于主 session：发现「有 worker 新进入终态 + 主端没有活着的 await + 主端最后活动早于这次完成」，
# 就把主 session 拉起（已被回收则经 daemon 以 resume 原地复活，保持同一 short/sessionId）并注入唤醒消息。
RESCUE_COOLDOWN = int(os.environ.get('CC_FLEET_RESCUE_COOLDOWN', '300'))
RESCUE_MAX_AGE = int(os.environ.get('CC_FLEET_RESCUE_MAX_AGE', str(3*86400)))
UUID_RE = re.compile(r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')

def daemon_call(req, timeout=20):
    """daemon control socket（协议见 reference/PROTOCOL.md）；公开 CLI 的 --bg --resume 会 fork 出新 sessionId，
    主端身份就对不上了，所以复活与注入只能走这里。"""
    socks=[os.environ['CC_FLEET_DAEMON_SOCK']] if os.environ.get('CC_FLEET_DAEMON_SOCK') else \
        sorted(glob.glob(f'/tmp/cc-daemon-{os.getuid()}/*/control.sock'))
    key=os.environ.get('CLAUDE_DAEMON_CONTROL_KEY') or os.environ.get('CLAUDE_BG_CONTROL_AUTH')
    if not key:
        with contextlib.suppress(OSError): key=(Path.home()/'.claude'/'daemon'/'control.key').read_text().strip()
    last=None
    for path in socks:
        try:
            with socket.socket(socket.AF_UNIX) as sk:
                sk.settimeout(timeout); sk.connect(path)
                sk.sendall((json.dumps(dict(proto=1,**({'auth':key} if key else {}),**req))+'\n').encode())
                buf=b''
                while b'\n' not in buf:
                    chunk=sk.recv(65536)
                    if not chunk: break
                    buf+=chunk
                return json.loads(buf.split(b'\n',1)[0])
        except (OSError,ValueError) as e: last=e
    raise RuntimeError(f'daemon unreachable: {last}')

def owner_job(c):
    """主端（仅 claude-code 主端）的 job：返回 (short, state.json)；找不到返回 (None, None)。"""
    with contextlib.suppress(Exception):
        if meta(c).get('owner',{}).get('host')!='claude-code': return None,None
    ids=[meta(c).get('owner',{}).get('id') or '']
    with contextlib.suppress(OSError):
        ids+=[l.split('=',1)[1].strip() for l in (c/'owner.meta').read_text().splitlines() if l.startswith('owner_session_id=')]
    # daemon 刚 kill/复活时会改写 state.json，可能读到半截文件：每个 id 多扫几轮再换下一个，免得认错主端。
    for sid in [x for x in ids if UUID_RE.fullmatch(x or '')]:
        for _ in range(3):
            for f in [JOBS_DIR/sid[:8]/'state.json',*JOBS_DIR.glob('*/state.json')]:
                with contextlib.suppress(OSError,ValueError):
                    js=json.loads(f.read_text())
                    if sid in (js.get('sessionId'),js.get('resumeSessionId')): return f.parent.name,js
            time.sleep(0.3)
    return None,None

def transcript_last_event(path):
    """transcript 尾部最后一条带 timestamp 的事件时刻；mtime 会被元数据整体重写刷新，不可用。"""
    best=0.0
    with contextlib.suppress(OSError), open(path,'rb') as f:
        f.seek(0,2); f.seek(max(0,f.tell()-262144))
        for m in re.finditer(rb'"timestamp"\s*:\s*"([^"]+)"',f.read()): best=max(best,iso_ts(m.group(1).decode()))
    return best

def settled_at(c,r):
    """模块进入终态的大致时刻：回执文件 > worker job state.json updatedAt > 现在。"""
    t=mtime(c/(r['module']+'.receipt.json'))
    if not t and r.get('shortId'): t=iso_ts((job_state(r['shortId']) or {}).get('updatedAt'))
    return t or time.time()

def wake_text(c,fresh,left):
    lines='；'.join(f"{r['module']} → {r['state']}"+(f"（{(r.get('receipt') or {}).get('summary','')[:80]}）" if r.get('receipt') else '') for r in fresh)
    return (f"⟦fleet 自动唤醒⟧ {meta(c).get('rq','')}：{lines}。你（主 session）当时没有挂着 await——多半是被回收/重启过，"
            f"所以没收到通知。请先 {ROOT/'cc-fleet'} status --coord {shlex.quote(str(c))} 核对回执，按既定流程继续编排"
            +(f"；仍在跑：{','.join(left)}，结束响应前用 Bash(run_in_background=true) 重新挂 await。" if left else '。'))

def revive(short,js):
    """已被回收的主 session：经 daemon 以 resume 原地复活（同一 short、同一 sessionId、同一对话），等它就绪。"""
    sid=js.get('resumeSessionId') or js.get('sessionId'); flags=list(js.get('respawnFlags') or [])
    d=dict(proto=1,short=short,sessionId=sid,createdAt=int(time.time()*1000),source='respawn',cwd=js.get('cwd') or str(Path.home()),
           launch=dict(mode='resume',sessionId=sid,fork=False,flagArgs=flags),agent=js.get('template') or 'claude',
           isolation='none',respawnFlags=flags)
    if js.get('name'): d['seed']=dict(intent=js.get('intent') or js['name'],name=js['name'])
    r=daemon_call(dict(op='dispatch',d=d,timeoutMs=15000),timeout=30)
    if not r.get('ok'): raise RuntimeError(f"revive {short} rejected: {r.get('code')} {r.get('error')}")
    end=time.time()+float(os.environ.get('CC_FLEET_RESCUE_READY_WAIT','60'))
    while time.time()<end:
        h=daemon_call(dict(op='has',short=short))
        if h.get('ready') or (h.get('alive') and h.get('ready') is None): return
        time.sleep(2)
    raise RuntimeError(f'revive {short}: not ready in time')

def rescue_one(c,dry):
    snapf=c/'owner-wake.json'; snap={}
    with contextlib.suppress(Exception): snap=json.loads(snapf.read_text())
    prev=snap.get('states')
    if prev is not None and all(v in TERMINAL for v in prev.values()) and max(mtime(c),mtime(c/'v2'))<=snap.get('at',0):
        return None                                   # 早已全部收尾、此后没动过：不必再查
    rows=statuses(c)
    alive=live_await(c)
    acts=[] if dry or alive else advance(c,rows)   # 主端不在：依赖图照样自动推进，流水线不因主端被回收而停
    if acts: rows=statuses(c)
    cur={r['module']:r['state'] for r in rows}
    def save(**kw):
        if not dry: atomic(snapf,dict(snap,states=cur,at=time.time(),**kw))
    if prev is None or alive: save(); return None   # 首次见到只记基线；有 await 在盯就交给它
    quiet=auto_deps(c)
    newly=[r for r in rows if r['state'] in TERMINAL and prev.get(r['module'])!=r['state'] and not (r['module'] in quiet and
           (r['state']=='done' or (prev.get(r['module'])=='done' and ((r.get('receipt') or {}).get('summary') or '').startswith('acceptance baseline changed'))))]
    if any(x['action']=='error' for x in acts):
        newly+=[r for r in rows if r['module'] in {x['module'] for x in acts if x['action']=='error'} and r not in newly]
    if not newly and pending(rows)==[] and any(prev.get(m) not in TERMINAL for m in cur if m in prev):
        newly=[r for r in rows if prev.get(r['module'])!=r['state']]   # 流水线刚全部收尾
    if not newly: save(); return None
    short,js=owner_job(c)
    if not short: save(); return dict(coord=str(c),action='skip',reason='owner-not-claude-or-unknown')
    last=transcript_last_event(js.get('linkScanPath') or '')
    fresh=[r for r in newly if settled_at(c,r)>last]  # 不留容差：主端刚停几秒 worker 就完成也得叫
    if not fresh: save(); return None                 # 主端在完成之后还活动过 = 已经看到了
    live=next((j for j in (daemon_call(dict(op='list')).get('jobs') or []) if j.get('short')==short),None)
    if live and live.get('tempo')=='active': return dict(coord=str(c),action='defer',reason='owner-busy',owner=short)
    if time.time()-snap.get('wokeAt',0)<RESCUE_COOLDOWN: return dict(coord=str(c),action='defer',reason='cooldown',owner=short)
    out=dict(coord=str(c),owner=short,modules=[r['module'] for r in fresh],revive=not live)
    if dry: return dict(out,action='dry-run')
    if not live: revive(short,js)
    r=daemon_call(dict(op='reply',short=short,text=wake_text(c,fresh,[x['module'] for x in pending(rows)])))
    if not r.get('ok'):
        snap['wokeAt']=time.time(); atomic(snapf,dict(snap,at=snap.get('at',0)))   # 记冷却、不推进基线，下轮再试
        raise RuntimeError(f"reply {short} rejected: {r.get('code')} {r.get('error')}")
    save(wokeAt=time.time(),woke=out['modules']); return dict(out,action='woke')

def rescue_owners(a):
    """供 watchdog 周期调用：扫描注册表里近期的协调目录，叫醒没人在等的主 session。单例、任何单个目录出错不影响其余。"""
    fleet_home().mkdir(parents=True,exist_ok=True)
    with open(fleet_home()/'rescue-owners.lock','w') as lk:
        try: fcntl.flock(lk,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except OSError: emit({'skipped':'another rescue-owners is running'}); return
        cands=[coord(x) for x in a.coord] if a.coord else sorted(registry_coords())
        res=[]
        for c in cands:
            try:
                if not (c/'fleet.json').is_file() or time.time()-max(mtime(c),mtime(c/'v2'))>RESCUE_MAX_AGE: continue
                r=rescue_one(c,a.dry_run)
                if r: res.append(r)
            except Exception as e:
                res.append(dict(coord=str(c),action='error',error=f'{type(e).__name__}: {e}'))
        emit({'at':datetime.datetime.now().isoformat(timespec='seconds'),'results':res})

def collect(a):
    c=coord(a.coord); d=load(c,a.module); r=receipt(c,d)
    if not r or r['result']=='needs-review': raise ValueError('no verified receipt to collect')
    if r.get('worktree') and not d.get('worktree'):
        # receipt() has verified repository identity and prepared baseline for done.
        if r['result']=='done':
            wt=toplevel(r['worktree'])
            update(c,a.module,worktree=wt,cwd=str(Path(wt)/d['subdir']) if d.get('subdir') else wt,branch=git(wt,'rev-parse','--abbrev-ref','HEAD'))
    atomic(c/(d['module']+'.receipt.json'),r)
    emit(dict(result=r['result'],receiptFile=str(c/(d['module']+'.receipt.json'))))


def reconcile(a):
    c=coord(a.coord); d=load(c,a.module)
    if d['backend']=='claude':
        hits=[j for j in claude_jobs() if j.get('name')==d['name'] and Path(j.get('cwd','/')).resolve()==Path(workdir(d)).resolve()]
        if len(hits)!=1: raise ValueError('cannot uniquely reconcile worker; inspect public session list')
        # Finding the record only proves the worker exists. Its real state decides: a session
        # that already ended must not be reported running (replies to it are silently lost).
        j=hits[0]; d=update(c,a.module,shortId=j['id'],sessionId=j.get('sessionId'),state='running')
        emit(update(c,a.module,state=status_one(c,d,[j])['state']))
    else:
        sid=a.session_id or d.get('sessionId')
        if not sid: raise ValueError('supply --session-id from the verified Codex task list')
        t=call('thread/read',dict(threadId=sid,includeTurns=False))['thread']
        if d['transport']!='native' and Path(t.get('cwd','/')).resolve()!=Path(workdir(d)).resolve():
            raise ValueError('thread cwd does not match prepared worktree')
        d=update(c,a.module,sessionId=sid,state='running')
        emit(sidebar_attach(c,update(c,a.module,state=status_one(c,d)['state'])))

def events(a):
    c=coord(a.coord); d=load(c,a.module)
    if d['backend']!='codex' or not d.get('sessionId'): raise ValueError('events requires a registered Codex worker')
    # This is an active controller subscription, never used by a read-only UI panel.
    argv=[os.environ.get('CODEX_APP_CALL_BIN',str(ROOT/'cc-codex-app-call')),
          '--watch-ms',str(a.timeout*1000),'thread/resume','-']
    p=subprocess.run(argv,input=json.dumps(dict(threadId=d['sessionId'])),text=True,timeout=a.timeout+40)
    if p.returncode: raise RuntimeError('event connection interrupted; reconcile through status')


def parser():
    p=argparse.ArgumentParser(description=__doc__); s=p.add_subparsers(dest='cmd',required=True)
    q=s.add_parser('init'); q.add_argument('--cwd',required=True); q.add_argument('--host',choices=HOSTS,required=True)
    q.add_argument('--owner-id'); q.add_argument('--base'); q.add_argument('--rq'); q.set_defaults(fn=init)
    s.add_parser('stop-guard',help='Claude Code Stop hook: block ending a turn while workers run unawaited').set_defaults(fn=stop_guard)
    q=s.add_parser('rescue-owners',help='watchdog 周期调用：worker 已结束而主 session 没挂 await（被回收/重启）时复活并唤醒主 session')
    q.add_argument('--coord',action='append',help='只查这些协调目录（可重复）；默认扫描注册表')
    q.add_argument('--dry-run',action='store_true',help='只报告将唤醒谁，不复活、不注入、不推进基线'); q.set_defaults(fn=rescue_owners)
    for cmd,fn in [('prepare',prepare),('dispatch',dispatch),('register',register),('bind',bind),('status',status),('read',read),('reply',reply),('stop',stop),('wait',wait),('await',await_),('reconcile',reconcile),('events',events),('collect',collect),('queue-reply',queue_reply),('advance',advance_cmd)]:
        q=s.add_parser(cmd); q.add_argument('--coord',required=True); q.set_defaults(fn=fn)
        if cmd not in ('status','wait','await','advance'): q.add_argument('--module',required=True,type=name)
        if cmd=='queue-reply':
            q.add_argument('--after',required=True,help='comma separated modules that must all be done first')
            q.add_argument('--text-file',required=True); q.add_argument('--phase',choices=('execute',),help='switch a verify card from author to execute phase')
        if cmd in ('reply','queue-reply'):
            q.add_argument('--session',choices=('auto','reuse','fresh'),default='auto',
                           help='auto: reuse only when the session is hot and small (idle<1h, ctx<150k, never compacted), else a fresh session with handoff')
        if cmd in ('status','await'):
            q.add_argument('--stale-after',type=int,default=STALE_AFTER,metavar='SECONDS',
                           help='flag a running module with no observable activity for this long (0 disables)')
        if cmd=='await':
            q.add_argument('--modules',help='comma/space separated subset; default: everything still running')
            q.add_argument('--label',help='note echoed back on wake-up so the controller regains context')
            q.add_argument('--timeout',type=int,default=7200,metavar='60..86400')
            q.add_argument('--interval',type=int,default=20,metavar='5..300')
        if cmd=='prepare':
            q.add_argument('--permissions',choices=('full','inherit'),default='full',help='worker permissions (default: full); inherit preserves backend configuration')
            q.add_argument('--backend',choices=('codex','claude'),help='default follows host: claude-code -> claude, codex-* -> codex')
            q.add_argument('--transport',default='auto',choices=('auto','native','app-server','claude-bg'))
            q.add_argument('--subdir',help='worker start dir relative to repo root (default: subdir of init --cwd; "" for repo root)')
            q.add_argument('--task'); q.add_argument('--role',default='developer',choices=('developer','scout','verify','integ','regression'))
            q.add_argument('--after',help='comma separated modules; the card is queued and auto-dispatched once all are done')
            q.add_argument('--self',dest='self_dev',action='store_true',help='solo mode: worktree for the main session itself, never dispatched')
            q.add_argument('--phase',choices=('author',),help='verify/integ: write acceptance specs in parallel with development')
            q.add_argument('--profile',help='Claude profile in multi-session-dev.json (default: runner for regression if defined, else worker)')
        if cmd=='dispatch': q.add_argument('--profile')
        if cmd=='register':
            g=q.add_mutually_exclusive_group(required=True); g.add_argument('--session-id'); g.add_argument('--client-thread-id'); q.add_argument('--host-id',default='local')
        if cmd=='reconcile': q.add_argument('--session-id')
        if cmd=='events': q.add_argument('--timeout',type=int,choices=range(1,56),default=50,metavar='1..55')
        if cmd=='bind': q.add_argument('--worktree',required=True)
        if cmd=='reply':
            q.add_argument('--text-file',required=True)
            q.add_argument('--force',action='store_true',help='reply even when the module looks stalled or exceeded the rework cap')
            q.add_argument('--phase',choices=('execute',),help='switch a verify card from author to execute phase')
        if cmd=='wait':
            q.add_argument('--timeout',type=int,choices=range(0,56),default=50,metavar='0..55'); q.add_argument('--interval',type=int,choices=range(2,31),default=5,metavar='2..30')
    return p

if __name__=='__main__':
    try:
        args=parser().parse_args(); args.fn(args)
    except (RuntimeError, ValueError, OSError, KeyError, subprocess.TimeoutExpired) as e:
        print(json.dumps({'error':str(e)},ensure_ascii=False),file=sys.stderr); sys.exit(2)
